#	$Id$
#
# r saves the final value
# w saves the ptr value
# m saves the ptr value, then also save the final value
# a saves the ptr as final value
# b just fetches the the next byte/word
#
# usemfpr	- move from processor register
# usemtpr	- move to processor register
#
# setnz		- set nz flags based on result
# setaddc	- set c based on result of last add
# setaddv	- set v based on result of last add
# clv		- clear v
#
# zero		- hidden arg is zero (argno hidden first)
# one		- hidden arg is one (argno hidden first)
#
# wback		- write result to destination
#
!OPCODES
#
01	NOP
02	REI
#
04	RET
05	RSB
#
0E	INSQUE
0F	REMQUE
10	BSBB
11	BRB
12	BNEQ
13	BEQL
14	BGTR
15	BLEQ
16	JSB
17	JMP
18	BGEQ
19	BLSS
1A	BGTRU
1B	BLEQU
1C	BVC
1D	BVS
1E	BGEQU
1F	BLSSU
#
28	MOVC3
29	CMPC3
#
2C	MOVC5
2D	CMPC5
#
30	BSBW
31	BRW
32	CVTWL
33	CVTWB
#
3A	LOCC
#
3C	MOVZWL
#
3E	MOVAW
3F	PUSHAW
#
78	ASHL
79	ASHQ
7A	EMUL
7B	EDIV
7C	CLRQ
7D	MOVQ
#
7E	MOVAQ
7F	PUSHAQ
80	ADDB2
81	ADDB3
82	SUBB2
83	SUBB3
84	MULB2
85	MULB3
86	DIVB2
87	DIVB3
88	BISB2
89	BISB3
8A	BICB2
8B	BICB3
8C	XORB2
8D	XORB3
8E	MNEGB
8F	CASEB
#
90	MOVB
91	CMPB
92	MCOMB
93	BITB
94	CLRB
95	TSTB
96	INCB
97	DECB
98	CVTBL
99	CVTBW
9A	MOVZBL
9B	MOVZBW
9C	ROTL
#
9E	MOVAB
9F	PUSHAB
A0	ADDW2
A1	ADDW3
A2	SUBW2
A3	SUBW3
A4	MULW2
A5	MULW3
A6	DIVW2
A7	DIVW3
A8	BISW2
A9	BISW3
AA	BICW2
AB	BICW3
AC	XORW2
AD	XORW3
AE	MNEGW
AF	CASEW
#
B0	MOVW
B1	CMPW
B2	MCOMW
B3	BITW
B4	CLRW
B5	TSTW
B6	INCW
B7	DECW
B8	BISPSW
B9	BICPSW
BA	POPR
BB	PUSHR
#
C0	ADDL2
C1	ADDL3
C2	SUBL2
C3	SUBL3
C4	MULL2
C5	MULL3
C6	DIVL2
C7	DIVL3
C8	BISL2
C9	BISL3
CA	BICL2
CB	BICL3
CC	XORL2
CD	XORL3
CE	MNEGL
CF	CASEL
D0	MOVL
D1	CMPL
D2	MCOML
D3	BITL
D4	CLRL
D5	TSTL
D6	INCL
D7	DECL
D8	ADWC
D9	SBWC
DA	MTPR
DB	MFPR
DC	MOVPSL
DD	PUSHL
DE	MOVAL
DF	PUSHAL
E0	BBS
E1	BBC
E2	BBSS
E3	BBCS
E4	BBSC
E5	BBCC
E6	BBSSI
E7	BBCCI
E8	BLBS
E9	BLBC
EA	FFS
EB	FFC
EC	CMPV
ED	CMPZV
EE	EXTV
EF	EXTZV
F0	INSV
#
F1	ACBL
F2	AOBLSS
F3	AOBLEQ
F4	SOBGEQ
F5	SOBGTR
F6	CVTLB
F7	CVTLW
#
FA	CALLG
FB	CALLS
#
FF	RESIN
#
!MICROCODE
#
# [label:] op left right	[args...]
#
# First entries for exceptions, get numbers from 0
	plus 0 0			# entry 0, unused
	plus 0 0	goto mcheck	# entry 1
	plus 0 0	goto resop	# entry 2
	plus 0 0	goto intrq	# entry 3
#
# Interrupt.  Interrupt level tells which vector to use, is in savpsw.
#
intrq:
	shr savpsw 10	argd0		# get IPL which is upper word in PSL
	shl savpsw B	ncond goto intrq_hw # skip is hardware interrupt
	and 15 15	crn		# set ipr SISR
	shl 1 argd0	arg1		# fix bit for masking
	plus civ 0	arg2		# XXX civ in right
	bic arg1 arg2	crw wipr	# clear bit in SISR
	shl argd0 2	arg1		# make longword offset
	plus arg1 80	argd1 goto scb_common # make SCB vector

intrq_hw:
	and argd0 1F	argd0		# 12 make vector.  Set mod as 0.
	minus argd0 18	zcond goto intrq_hw18 # skip if timer
	minus argd0 14	zcond goto intrq_14	# skip if timer
	plus 0 0	resopflt eoi

intrq_hw18: and C0 C0	argd1 goto scb_common	# interval timer

#
# console also interrupts on level14, but with different vectors.
#
intrq_14:
	and savpsw 8000	zcond goto intrq_14_1 # 17 check for tx intr
	bis psl 8000	psl		# set clear interrupt request
	bis psl 0	psl		# reset clear bit
	and FC FC	argd1 goto scb_common # console TX interrupt
intrq_14_1:
	and savpsw 4000	zcond goto intrq_14_2 # 21 check for rx intr
	bis psl 4000	psl		# set clear interrupt request
	bis psl 0	psl		# reset clear bit
	and F8 F8	argd1 goto scb_common # console RX interrupt
intrq_14_2:
	plus 0 0	resopflt eoi

#
# Machine check.  Frame has pc+psl+argcnt, argcnt is 0.
# Ignore stack change for now.
#
mcheck:
	and E E		crn		# 3 fetch stack pointer
	minus crv 4	argp0		# 4 save stack address
	plus psl 0	crw		# 5 psl to write
	minus argp0 4	cpuaddr wmem	# 6 save psl on stack
	and F F		crn		# 7
	plus crv 0	crw		# 8
	minus argp0 8	cpuaddr wmem	# 9 save pc on stack
	plus 0 0	crw		# 10
	minus argp0 C	cpuaddr wmem	# 11 byte count (0)
	and E E		crn		# 12
	minus argp0 C	crw wreg	# 13 restore stack pointer

	and 11 11	crn		# 14  SCBB offset
	plus civ 4	cpuaddr rmem phys # 15  fetch vector
	and F F		crn		# 16
	plus rmemdat 0	crw wreg	# 17 new pc
	plus 0 0	eoi		# 18
	
# Reserved operand
resop:
	shr psl 10	argd0		# 19 no change to PSL
	and 18 18	argd1 goto scb_common # 20
#
# Reserved instruction, handled entirely in microcode.
# No parameters are pushed.
resinflt:
	shr psl 10	argd0		# 21 no change to PSL
	and F F		crn		# 22 set PC
	minus crv 1	crw wreg	# 23 sub one from PC
	and 10 10	argd1 goto scb_common	# 24 vector 10
#
# Vector in argd1
# upper word in IPL in argd0.
# arg4 (and argd1) are scratched.
#
scb_common:
# begin with saving old SP in IPR.
	and E E		crn		# 48 SP
	plus crv 0	crw		# 49 save to write in IPR
	shr psl 18	arg4		# 50 Fetch IS+CURMOD from PSL
	and arg4 7	crn wipr	# 51 write old stack to IPR
# set new stack
# unless vector bit0==0 and psl.is==0 it will be on the interrupt stack.
	and 11 11	crn		# 52
	plus civ argd1	cpuaddr rmem phys # 53 fetch vector
	shr psl 1A	arg4		# 54 get IS bit in pos0
	bis rmemdat arg4 arg4		# 55 merge with stack bit in vector
	plus arg4 0	argd1		# 56 remember new PC address
	and arg4 1	arg4		# 57
	and arg4 1	crn zcond goto scb_1 # 58 KSP
	and 4 4		crn		# 59 nope, ISP
scb_1:
# save old PC+PSL.  new SP in civ
	bis arg4 argd1	argd1		# 60 save IS flag as low bit.
	plus civ 0	arg4		# 61
	minus arg4 4	cpuaddr		# 62 prepare to push
	plus psl 0	crw wmem	# 63 push PSL
	minus arg4 8	cpuaddr		# 64 sub 4 more
	and F F		crn		# 65 fetch PC
	plus crv 0	crw wmem	# 66 push PC
	and E E		crn		# 67
	minus arg4 8	crw wreg	# 68 write back stack
# update new PC.
	and F F		crn		# 69
	bic 3 argd1	crw wreg	# 70 write new PC
# update PSL.
	and argd1 1	arg4		# 71 get stack bit
	shl arg4 A	arg4		# 72
	bis arg4 argd0	arg4		# 73
	shl arg4 10	psl		# 74
#	and argp1 argp1	nzcond goto scb_2 # 
	plus 0 0	eoi		# 75

#
mov:	plus arg1 0		argd0 savnz eoi
tst:	plus arg1 0		argd0 savnz eoi
add:	plus arg1 arg2		argd0 savnz savc savv eoi
clr:	plus 0 0		argd0 savnz eoi
xor:	xor arg1 arg2		argd0 savnz eoi
sub:	minus arg1 arg2		argd0 savc savv savnz eoi
bicpsw:	bic arg1 psl		psl eoi
bispsw:	bis arg1 psl		psl eoi
movpsl:	plus psl 0		argd0 savnz eoi
bic:	bic arg1 arg2		argd0 savnz eoi
bis:	bis arg1 arg2		argd0 savnz eoi
and:	and arg1 arg2		argd0 savnz eoi
zwl:	and arg1 FFFF		argd0 savnz eoi
zbl:	and arg1 FF		argd0 savnz eoi
#
adwc:	plus arg1 arg2	argd0 savc savv	# save C and V
	and psl 1	arg3		# fetch old C
	and savpsw 3	arg4		# store them
	plus arg3 argd0	argd0 savc savv savnz	# save all status bits
	bis savpsw arg4	arg4		# or them into saved bits
	and arg4 3	arg4		# clean all other bits
	bic 3 psl	psl		# clean CV  from psl
	bis psl arg4	psl eoi		# replace with newly calculated

sbwc:	minus arg2 arg1	argd0 savc savv	# save C and V
	and psl 1	arg3		# fetch old C
	and savpsw 3	arg4		# store calc CV
	minus argd0 arg3 argd0 savc savv savnz	# save all status bits
	bis savpsw arg4	arg4		# or them into saved bits
	and arg4 3	arg4		# clean all other bits
	bic 3 psl	psl		# clean CV  from psl
	bis psl arg4	psl eoi		# replace with newly calculated

#
# mtpr arg1=val,arg2=ipr
mtpr:
	and arg2 arg2	nzcond goto mtpr_1	# KSP?
	shr psl 1A	arg3			# IS set?
	and arg3 1	nzcond goto mtpr_ok	# if so, fine
	plus 0 0	resopflt eoi		# write back XXX fixme

mtpr_1:
	minus 3 arg2	nncond goto mtpr_ok	# SSP, ESP, USP
# check if ISP
	minus arg2 4	nzcond goto mtpr_2
	shr psl 1A	arg3
	and arg3 1	zcond goto mtpr_ok	# not on ISP, get out
	and C000 C000	arg3			# create wback encoding
	shl arg3 10	arg3
	plus arg3 E	argp0 wback
	and arg1 arg1	argd0 goto mtpr_ok
mtpr_2:
	minus arg2 11	zcond goto mtpr_ok	# Accept SCBB

	minus arg2 19	zcond goto mtpr_ok	# NICR
	minus arg2 18	zcond goto mtpr_ok	# ICCS
	minus arg2 20	zcond goto mtpr_ok	# RXCS
	minus arg2 22	zcond goto mtpr_ok	# TXCS
	minus arg2 23	zcond goto mtpr_ok	# TXDB
	minus arg2 25	zcond goto mtpr_ok	# 11/750 CADR
	minus arg2 26	zcond goto mtpr_ok	# 11/750 MCESR

	minus arg2 12	nzcond goto mtpr_12	# skip if not IPRIPL
	and 1F 1F	arg4
	and arg4 arg1	arg1
	shl arg4 10	arg4
	bic arg4 psl	psl
	shl arg1 10	arg3
	bis arg3 psl	psl goto mtpr_ok

mtpr_12:
	minus arg2 14	nzcond goto mtpr_14	# SIRR
	and 15 15	crn			# fetch SISR
	and arg1 F	arg1			# only soft bits
	shl 1 arg1	arg1			# make mask
	bis civ arg1	crw wipr		# write back SISR
	plus 0 0	eoi
	

mtpr_14:
	plus 0 0	resopflt eoi


# OK to write to IPR
mtpr_ok:
	plus arg2 0	crn		# set IPR number
	plus arg1 0     crw wipr	# set IPR val and write
	plus 0 0	eoi

# mfpr arg1=ipr,arg2=dest
mfpr:
	plus arg1 0	crn			# for access

	minus arg1 3E	nzcond goto mfpr_1	# SID
	and 0A00 0A00	arg2
	shl arg2 10	arg2
	plus arg2 6	argd0 eoi savnz
mfpr_1:
	minus arg1 15	zcond goto mfpr_ok	# SISR
	minus arg1 18	zcond goto mfpr_ok	# ICCS
	minus arg1 1A	zcond goto mfpr_ok	# ICR
	minus arg1 20	zcond goto mfpr_ok	# RXCS
	minus arg1 21	zcond goto mfpr_ok	# RXDB
	minus arg1 22	zcond goto mfpr_ok	# TXCS
	minus arg1 25	zcond goto mfpr_ok	# CADR

	minus arg1 12	nzcond goto mfpr_12	# IPL

	shr psl 10	argd0
	and argd0 1F	argd0 savnz eoi


mfpr_12:
	plus 0 0	resopflt eoi

mfpr_ok:
	plus civ 0	argd0 eoi savnz

#
# Move quad word. First long is already read, extract addr for the
# second, read val, update flags, write to output regs.
# input addr in argp0 (must later be updated), output in argp1
#
# XXX - need mov, shifted reg bits, split savn/savz
#
movq:
	plus arg1 0	argd0
	plus arg2 0	argd1
# Fix correct status bits
	shr argd0 1	arg1		# shift in 0 as sign bit
	and argd0 1	arg2		# get just lost low bit
	bis arg1 arg2	arg1		# or it to check result
	bis argd1 arg1	savnz eoi	# set NZ bits by adding high and low

#
# Clear quad word.  extract addr and set both output correct.
#
clrq:	plus 0 0	argd0 savnz		# clear both
	plus 0 0 	argd1 eoi

#
# Check if a given bit in psl is set
bset:	plus arg1 0	argd0			# move new pc to dest
	and arg2 psl	nzcond wback eoi	# if result Z writeback
# Check if given bit(s) in psl are clear
bclr:	plus arg1 0	argd0			# move new pc to dest
	and arg2 psl	zcond wback eoi		# if result Z writeback
#
# ROTL: arg1 == shift count, arg2 = val
rot:	
	and arg1 1F	arg1
	shl arg2 arg1	argd0
	minus 20 arg1	arg1
	shr arg2 arg1 	argd1
	bis argd1 argd0	argd0 savnz eoi
#
# ACBL    rl,rl,ml,ab#b^d(pc),wl#pc
acb:	plus arg2 arg3		argd0 savv savnz	# addto
	plus arg4 0		argd1			# dest addr
	plus arg2 0		ncond goto acb_2	# arg2 < 0
	minus arg1 arg3		ncond goto acb_2	# limit >= index
	plus 0 0		wback2 goto acb_done
acb_2:	plus arg2 0		nncond goto acb_done
	minus arg3 arg1		ncond goto acb_done
	plus 0 0		wback2
acb_done:
	plus 0 0		eoi
#
aobleq:	plus 1 arg2		argd0 savc savnz	# inc index
	plus arg3 0		argd1			# save branch addr
	minus arg1 argd0 	nncond wback2 eoi	# br if !(ix > l)
#
aoblss:	plus 1 arg2		argd0 savc savnz	# inc index
	plus arg3 0		argd1			# save branch addr
	minus argd0 arg1 	ncond wback2 eoi	# br if (ix < l)
#
sobgeq:	plus arg2 0	argd1				# save branch addr
	minus arg1 1	argd0 savv savnz nncond wback2 eoi	# dec index
#
sobgtr:	plus arg2 0	argd1				# save branch addr
	minus arg1 1	argd0 savv savnz 		# dec index
	minus argd0 1	nncond wback2 eoi		# if ix > 0
#
# arg1=pos, arg2=base, arg3=displ
bbc:	shr arg2 arg1	argd0
	plus arg3 0	argd1
	and argd0 1	zcond wback2 eoi
bbs:	shr arg2 arg1	argd0
	plus arg3 0	argd1
	and argd0 1	nzcond wback2 eoi
#
# pos, base, displ
# BBSS	rl,ml,ab#b^d(pc),wl#pc
bbss:	shl 1 arg1	argd0		# position bit
	plus 0 arg3	argd1		# save br addr
	and argd0 arg2	nzcond wback2	# br if set
	bis argd0 arg2	argd0 eoi	# set bit
bbsc:	shl 1 arg1	argd0		# position bit
	plus 0 arg3	argd1		# save br addr
	and argd0 arg2	nzcond wback2	# br if set
	bic argd0 arg2	argd0 eoi	# clear bit
bbcs:	shl 1 arg1	argd0		# position bit
	plus 0 arg3	argd1		# save br addr
	and argd0 arg2	zcond wback2	# br if set
	bis argd0 arg2	argd0 eoi	# set bit
bbcc:	shl 1 arg1	argd0		# position bit
	plus 0 arg3	argd1		# save br addr
	and argd0 arg2	zcond wback2	# br if set
	bic argd0 arg2	argd0 eoi	# clear bit
#
# INSV arg1=pos,arg2=size,argd0/1=base(val),arg4=src
#
insv:	shr argp0 1E	argd0		# 132
	minus argd0 3	argd0 		# 133
	plus argd0 argd0 nzcond goto insv_mem	# 134
#
# value is in register
# First check whether a resopflt should be generated
	and arg2 arg2	zcond goto insv_zero # no check if size zero
	minus arg1 20	nncond resopflt	# resopflt if size > 31
insv_zero:
	plus argp0 0	crn		# 59 set cur reg num
	plus crv 0	argd0		# 60 move val to dest
	plus argp0 0	argp0		# Set to longword
	plus argp0 1	argp1		# if two regs
	plus argp0 1	crn		# if two regs
	plus crv 0	argd1 goto insv_common 		# 60 move val to dest
#	and arg1 arg1	goto insv_common # 60 move val to dest
insv_mem:
# Normalize first
	asr arg1 3	arg3		# get byte offset
	plus argp0 arg3	argd0		# argp0 == byte offset
	and argd0 3	arg3		# arg3 == byte offset in longword
	and arg1 7	arg1		# arg1 == bit offset
	shl arg3 3	arg3		# make bit offset
	plus arg3 arg1	arg1		# pos == bit offset in longword
	bic 3 argd0	argp0		# clear byte offset bits in ptr
	plus argp0 0	cpuaddr rmem	# fetch low long
	plus rmemdat 0	argd0		# dat now in argd0
	plus argp0 4	argp1 rmem	# fetch high long
	plus argp1 0	cpuaddr rmem	# fetch high long
	plus rmemdat 0	argd1		# dat now in argd1


insv_common:

# Any writeback?
	plus arg2 arg2	nzcond wback	# write back low word if sz != 0
	plus arg2 arg1	arg3		# size + pos
	minus 20 arg3	ncond wback2	# if > 32 write back high word
#
# Lower longword
#
	minus arg2 20	nzcond goto insv_not20
#	and arg3 arg3	nzcond goto insv_not20
	bic arg3 arg3	arg3
	minus arg3 1	arg3 goto insv_sz
#	and arg3 arg3	goto insv_sz
insv_not20:
	shl 1 arg2	arg3		# 61 shift left size bits
	minus arg3 1	arg3		# 62 create mask (in arg3)
insv_sz:
	and arg3 arg4	arg4		# 63 clear unwanted bits in src
	shl arg3 arg1	arg3		# 64 shift left pos bits in mask
	bic arg3 argd0	argd0		# 65 clear unwanted bits in dest
	shl arg4 arg1	arg3		# 66 put shifted src in arg3
	bis arg3 argd0	argd0		# 67 written in dest
#
# Upper long
#
	shl 1 arg2	arg3		# 61 shift left size bits
	minus arg3 1	arg3		# 62 create mask (in arg3)
	minus 20 arg1	arg1		# pos = 32-pos (leftover in lowword)
	shr arg4 arg1	arg4		# shrink src
	shr arg3 arg1	arg3		# shrink mask
	bic arg3 argd1	argd1		# clear unwanted bits from d1
	bis arg4 argd1	argd1 eoi	# set wanted bits in d1

#
# extract bitfield based on (pos,size,base) in (arg1,arg2,argp0)
# return field in argd0, return addr in argp1. Trashes arg1+arg3.
#
bfield:
# sanity: size > 32?
	and 0 0 	argd0			# 177
	minus arg2 21	arg3			# 178
	and arg3 arg3	nncond resopflt		# 179
	and arg2 arg2	zcond goto bf_done	# 180
# Check whether read from mem or reg?
	shr argp0 1E	argd0			# 181
	minus argd0 3	argd0 nzcond goto bf_mem	# 182
# Ok, get from reg.  
	minus arg1 20	nncond resopflt	# resopflt if pos > 31
	plus argp0 0	crn		# 59 set cur reg num
	plus crv 0	argd0		# 60 move val to dest
	plus argp0 1	crn		# if two regs
	plus crv 0	arg3 goto bf_common	# 60 move val to dest
#	and arg1 arg1	goto bf_common	# just jump
bf_mem:
# Normalize first
	asr arg1 3	arg3		# 189 get byte offset
	plus argp0 arg3 argd0		# 190 argp0 == byte offset
	and argd0 3	arg3		# 191 arg3 == byte offset in longword
	and arg1 7	arg1		# 192 arg1 == bit offset
	shl arg3 3	arg3		# 193 make bit offset
	plus arg3 arg1	arg1		# 194 pos == bit offset in longword
	bic 3 argd0	argp0		# 195 clear byte offset bits in ptr
	plus argp0 0	cpuaddr rmem	# 196 fetch low long
	plus rmemdat 0	argd0		# 197 dat now in argd0
	plus argp0 4	cpuaddr rmem	# 198 next long
	plus rmemdat 0	arg3		# 199 XXX should check if needed
bf_common:
# create long in argd0
	shr argd0 arg1	argd0		# 200 right-adjust low bits
	minus 20 arg1	arg1		# 201
	shl arg3 arg1	arg3		# 202
	bis arg3 argd0	argd0		# 203

bf_done:
	plus argp1 0	arg3		# 204

	and arg3 arg3	zcond goto extzv_1 # 205 value 0
	minus arg3 1	arg3 zcond goto extv_1		# 206
	minus arg3 1	arg3 zcond goto cmpv_1		# 208
	minus arg3 1	arg3		# 208
	and arg3 arg3	zcond goto cmpzv_1	# 209 value 3
	minus arg3 1	arg3 zcond goto ffc_1	# val 4
	plus 0 0	resopflt eoi	# 210

# EXTZV	rl,rb,wb,wl (arg1,arg2,argp0,argp1)
extzv:	plus argp1 0	argd1		# 207 save ptr
	plus 0 0	argp1		# 208 clear ret
	plus 0 0	goto bfield	# 209
extzv_1:	
	minus arg2 20	arg3		# 210
	and arg3 arg3	nncond goto extzv_is20	# 218 full word, no need to mask
	shl 1 arg2	arg3		# 211
	minus arg3 1	arg3		# 220
	and arg3 argd0	argd0		# 221
extzv_is20:
	and argd0 argd0	savnz		# 222
	plus argd1 0	argp0 eoi	# 223 result in wb0
	

# EXTV	rl,rb,wb,wl (arg1,arg2,argp0,argp1)
extv:	plus argp1 0	argd1
	and 1 1 	argp1
	plus 0 0	goto bfield
extv_1:	
	minus arg2 20	arg3		# 224
	and arg3 arg3	nncond goto extv_is20	# 225 full word, no need to mask
	minus 20 arg2	arg2		# 226 shift left bits
	shl argd0 arg2	argd0		# 227 
	asr argd0 arg2	argd0 		# 228 sign extend
extv_is20:
	and argd0 argd0	savnz		# 229 
	plus argd1 0	argp0 eoi	# 230 result in wb0
	
# CMPV rl,rb,wb,rl (arg1,arg2,argp0,arg3)
cmpv:	plus arg3 0	argd1			# 231 save cmpval
	and 2 2		argp1			# 232
	plus 0 0	goto bfield		# 233
cmpv_1:
	minus arg2 20	arg3			# 234
	and arg3 arg3	nncond goto cmpv_is20	# 235 full word, no need to mask
	minus 20 arg2	arg2			# 236 shift left bits
	shl argd0 arg2	argd0			# 237
	asr argd0 arg2	argd0			# 238 sign extend
cmpv_is20:
	minus argd0 argd1 argd0 savnz savc savv eoi	# 239

# CMPZV rl,rb,wb,rl (arg1,arg2,argp0,arg3)
cmpzv:	plus arg3 0	argd1			# 242 save cmpval
	and 3 3		argp1			# 243
	plus 0 0	goto bfield		# 244
cmpzv_1:
	minus arg2 20	arg3			# 245
	and arg3 arg3	nncond goto cmpzv_is20	# 246 full word, no need to mask
	shl 1 arg2	arg3			# 247
	minus arg3 1	arg3			# 248 shift left bits
	and arg3 argd0 	argd0			# 249 sign extend
cmpzv_is20:
	minus argd0 argd1 argd0 savnz savc savv eoi	# 250
#
# CASEB selector,base,limit
# tmp = selector - base
# if (tmp <= limit) PC += SEXT(displ[tmp]) else PC += 2 + 2 * ZEXT(limit)
caseb:
	minus arg1 arg2		argd1 savnz savc	# get numeric val
	minus arg3 argd1	ncond goto caseb_end	# inside boundaries?
case_off:
	shl argd1 1		argd1			# word offset
	plus argd1 arg4		cpuaddr rmem		# read word
	shl rmemdat 16		arg3			# sign extend...
	asr arg3 16		arg3
	plus arg3 arg4		argd0 eoi		# jmp new address
caseb_end:
	and arg3 FF		arg3			# zero extend
case_ex:
	shl arg3 1		arg3			# word offset
	plus arg3 2 		arg3			# one word after
	plus arg3 arg4		argd0 eoi		# set pc
#
casew:
	minus arg1 arg2		argd1 savnz savc	# get numeric val
	minus arg3 argd1	nncond goto case_off	# inside boundaries?
	and arg3 FFFF		arg3 goto case_ex
#
casel:
	minus arg1 arg2		argd1 savnz savc	# get numeric val
	minus arg3 argd1	nncond goto case_off	# inside boundaries?
	plus 0 0		goto case_ex
#
mul:	mul arg1 arg2		argd0 savnz savv eoi
#
# Handle division check here
# HW division is unsigned, so we convert to unsigned here.
#
div:	
	bic 2 psl	psl			# clear V
	plus arg1 0	nzcond goto div_nz	# skip if no division by 0
	bis 2 psl	psl			# div by 0, set V
div_nz:
	# check if -MAXSHORT/-1
	plus arg1 1	nzcond goto div_done	# jump if not -1
	plus arg2 0	zcond goto div_done	# jump if 0
	plus arg2 arg2	nzcond goto div_done	# jump if not -MAXINT
	bis 2 psl	psl
div_done:
	and arg1 arg1	arg3 nncond goto div_1f	# skip if divr positive
	minus 0 arg1	arg3			# otherwise convert
div_1f:	and arg2 arg2	arg4 nncond goto div_2f	# 299 same again for divd
	minus 0 arg2	arg4
div_2f:
	div arg3 arg4	argd0			# 301
	xor arg1 arg2	nncond goto div_3f	# source sign same = no conv
	minus 0 argd0	argd0			# change sign
div_3f:	and argd0 argd0 savnz eoi		# set flags
#
#
ashl:	bic 2 psl	psl			# clear V
	plus arg2 0	argd0
	plus arg1 0	nncond goto ashl_left	# negative shifts right
	minus 0 arg1	arg1			# make positive
	minus arg1 1F	ncond goto ashl_1f	# less than 31?
	and 1F 1F	arg1			# set to 31
ashl_1f:
	asr arg2 arg1	argd0 savnz eoi		# right shift

ashl_left:
	and arg1 arg1	zcond goto ashl_ret	# save and return
	xor arg2 argd0	nncond goto ashl_skip	# check if sign bit changed
	bis psl 2	psl
ashl_skip:
	shl argd0 1	argd0
	minus arg1 1	arg1 goto ashl_left
ashl_ret:
	plus argd0 0	savnz eoi
#
# ASHQ  arg1,argp0,argp1
# Read in value in arg3/arg4 first, shift it, then 
ashq:
	plus arg2 0	argd0
	plus arg3 0	argd1

# do shifts
	bic 2 psl	psl			# 339 clear V
	plus argd1 0	arg4			# 340 remember high word
	plus arg1 0	nncond goto ashq_left	# 341
	minus 0 arg1	arg1			# 342 make right shift positive
	minus arg1 3F	ncond goto ashq_3f	# 343
	and 3F 3F	arg1			# 344 set to 63
ashq_3f:
	and arg1 arg1	zcond goto ashq_ret
	shr argd0 1	argd0
	and argd1 1	zcond goto ashq_5f	# jump if no need to or
	and 8000 8000	arg3
	shl arg3 10	arg3
	bis argd0 arg3	argd0
ashq_5f:
	asr argd1 1	argd1
	minus arg1 1	arg1 goto ashq_3f

# set flags before return
ashq_ret:
	shr argd0 1	arg1
	and argd0 1	arg2
	bis arg1 arg2	arg1
	bis argd1 arg1	savnz eoi
		

ashq_left:
	and arg1 arg1	zcond goto ashq_ret	# save and return
	xor arg4 argd1	nncond goto ashq_skip
	bis psl 2	psl
ashq_skip:
	shl argd1 1	argd1			# shift high word
	plus argd0 0	nncond goto ashq_4f	# low word high bit set?
	bis argd1 1	argd1			# if so, set high word LSB
ashq_4f:
	shl argd0 1	argd0			# shift left low word
	minus arg1 1	arg1 goto ashq_left
#
cvtlw:	bic 2 psl	psl
	plus arg1 0	argd0
	shl arg1 10	arg1
	asr arg1 10	arg1 savnz
	minus argd0 arg1 zcond goto cvtlw_1f
	bis psl 2	psl
cvtlw_1f:
	plus 0 0	eoi
#
# EDIV divr,divd,quo,rem (arg1,arg2/3,argp0,argp1)
# Algorithm here comes from a NOVA programming book.
# rem == divdu == arg3 == argd1
# quo == divdl == arg2 == argd0
#
ediv:
	bic 3 psl	psl		# 326 clear C+V
	plus 0 0	arg4		# 327 clear a4
	and arg2 arg2	argd0		# 328 set d0 (future quotient)
#
# check if we need to flip signs
# arg4 bit 0 is quot, bit 1 is rem sign.
#
	and arg3 arg3	argd1 nncond goto ediv_f1 # 329 set d1 (rem)
	and 3 3		arg4		# save divd sign bit
	minus 0 arg2	argd0
	minus 0 arg3	argd1
	minus argd0 1	ncond goto ediv_f1 # check if carry
	minus argd1 1	argd1
ediv_f1:
# check divr negative
	and arg1 arg1	nncond goto ediv_f2 # 335
	minus 0 arg1	arg1
	xor arg4 1	arg4		# low bit whether to flip quot sign
ediv_f2:
#
# Check for overflow (special handling)
#
	minus argd1 arg1 nncond goto ediv_ovf # 338 divdh > rem then ovf
	shl argd1 1	arg2	# 339 ...must also check the sign bit in divdl..
	and argd0 argd0 nncond goto ediv_f3	# 340 
	plus arg2 1	arg2			# 341
ediv_f3:
	minus arg2 arg1 ncond goto ediv_cmn	# 342

# Overflow handling
ediv_ovf:
	and arg4 2	zcond goto ediv_f4	# 343 swap sign on quot?
	minus 0 argd0	argd0			# 344 yes
ediv_f4:
	plus 0 0	argd1			# 345 clear rem
	bis 2 psl	psl goto ediv_end	# 346 set V and getout

#
# The division itself.
# divr in arg1, divd in argd0/argd1
# arg2 is used for temporary carry
#
ediv_cmn:
	and 20 20	arg3	# 347 loop count
	shr argd0 1F	arg2	# get sign bit (as carry)
	bis psl arg2	psl	# store carry in psl
	shl argd0 1	argd0	# shift quot left

ediv_loop:
	# MOVL argd1,argd1
	plus 0 0	arg2	# clear tcy
	and argd1 argd1 nncond goto ediv_f5 # sign bit set in dvdh?
	and 1 1		arg2	# set tcy
ediv_f5:
	shl argd1 1	argd1
	and psl 1 	zcond goto ediv_f6
	bis 1 argd1	argd1
ediv_f6:
	bic 1 psl	psl
	bis arg2 psl	psl
	# END MOVL

	# SUBH arg1,argd1,SZC
	plus 0 0	arg2
	minus argd1 arg1 ncond goto ediv_f7
	and 1 1		arg2
ediv_f7:
	xor psl arg2	arg2
	and arg2 1	zcond goto ediv_f11
	# END SUBH arg1,argd1,SZC

	# SUB arg1,argd1
	plus 0 0	arg2
	minus argd1 arg1 argd1 ncond goto ediv_f8
	and 1 1		arg2
ediv_f8:
	xor psl arg2	psl
	# END SUB arg1,argd1

ediv_f11:
	# MOVL argd0,argd0
	plus 0 0	arg2
	and argd0 argd0	nncond goto ediv_f15
	and 1 1		arg2
ediv_f15:
	shl argd0 1	argd0
	and psl 1	zcond goto ediv_f16
	bis argd0 1	argd0
ediv_f16:
	bic 1 psl	psl
	bis psl arg2	psl
	# END MOVL

	minus arg3 1	arg3 nzcond goto ediv_loop

	and arg4 1	zcond goto ediv_end
	minus 0 argd0	argd0
ediv_end:
	and arg4 2	zcond goto ediv_f18
	minus 0 argd1	argd1
ediv_f18:
	and argd0 argd0	savnz eoi
#
# EMUL f1,f2,add,wq (arg1, arg2, arg3, argp0/p1)
emul:
	mul arg1 arg2	argd0		# 382 do mult
	plus ures 0	argd1		# 383 fetch upper
	plus argd0 arg3	argd0		# 384 addend
	# sign extension...
	asr arg3 31	arg4		# 385
	plus argd1 arg4	argd1		# 386
	# ...if sum is less than either
	minus argd0 arg3 savc		# 387
	and savpsw 1	zcond goto emul_3f # 388
	plus 1 argd1	argd1		# 389
emul_3f:
	bic F psl	psl		# 390 clear all bits
	and argd1 argd1	nncond goto emul_1f	# negative?
	bis 8 psl	psl		# yes, set N flag
emul_1f:
	bis argd0 argd1	nzcond goto emul_2f	# zero?
	bis 4 psl	psl		# yes, set Z flag
emul_2f:
	plus 0 0 	eoi
#
mcom:
	minus 0 arg2	arg2
	xor arg2 arg1	argd0 savnz eoi
#
# REI pc=arg1, psl=arg2
rei:
	# validity checks
	# if (arg2.is == 1 && arg2.ipl == 0) resopflt();
	# if (arg2.ipl > 0 && arg2.cur_mod != 0) resopflt();
	# if (arg2.prv_mod < arg2.cur_mod) resopflt();
	# if (arg2 & IPL_MBZ) resopflt();
	# if (arg2.cm) resopflt();
	# if (arg2.cur_mod < psl.cur_mod) resopflt();
	# if (arg2.is == 1 && psl.is == 0) resopflt();
	# if (arg2.ipl > psl.ipl) resopflt();

	# save old SP
	and E E		crn		# 480
	plus crv 0	crw		# 481
	shr psl 18	arg4		# 482
	and arg4 7	crn wipr	# 483

	# Write PC+PSL
	plus arg2 0	psl
	plus arg1 0	argd0

	# stack change
	shl psl 5	ncond goto rei_2 # can only change stack if !IS
	shr psl 18	arg4
	and arg4 3	crn
	plus civ 0	crw
	and E E		crn wreg
rei_2:
	plus 0 0	eoi
#
# code from the vax arch manual
# XXX merge with movc5
movc3:
	minus arg3 arg2	savc	# copy from back or forward?
	and savpsw 1	zcond goto movc3_backw
# forward copy
movc3_f_loop:
	and arg1 arg1	zcond goto movc3_done

	and arg2 arg2	cpuaddr rmem byte	#
	plus rmemdat 0	crw
	and arg3 arg3	cpuaddr wmem byte

	minus arg1 1	arg1
	plus arg2 1	arg2
	plus arg3 1	arg3 goto movc3_f_loop

movc3_backw:
	and arg1 FFFF	arg1	# ZEXT arg1
	plus arg1 0	arg4	# save arg1 in arg4
	plus arg2 arg1	arg2	# arg2 to end
	plus arg3 arg1	arg3	# arg3 to end
movc3_b_loop:
	and arg1 arg1	zcond goto movc3_b_done
	minus arg1 1	arg1
	minus arg2 1	arg2
	minus arg3 1	arg3

	and arg2 arg2	cpuaddr rmem byte	#
	plus rmemdat 0	crw
	and arg3 arg3	cpuaddr wmem byte
	plus 0 0	goto movc3_b_loop

movc3_b_done:
	plus arg2 arg4	arg2
	plus arg3 arg4	arg3
#
# Write R0,R2,R4,R5 == 0, R1=tmp2, R3=tmp3
#
movc3_done:
	and 0 0		crn savnz	# Z flag set
	and 0 0		crw wreg
movc3_donex:
	and 2 2		crn
	and 0 0		crw wreg
	and 4 4		crn
	and 0 0		crw wreg
	and 5 5		crn
	and 0 0		crw wreg
	and 1 1		crn
	and arg2 arg2	crw wreg
	and 3 3		crn
	and arg3 arg3	crw wreg
	plus 0 0	eoi
#
movc5:
	minus arg1 arg3	savc savnz	# save flags early
	bic F psl	psl
	bis savpsw psl	psl
	and argd0 FF	argp0		# 452 save fill byte
	minus arg4 arg2	savc		# 453 copy from back or forward?
	and savpsw 1	zcond goto movc5_backw # 454
# forward
movc5_f_loop1:
	and arg1 arg1	zcond goto movc5_f_loop2 # 455
	and arg3 arg3	zcond goto movc5_f_loop2 # 456

	and arg2 arg2	cpuaddr rmem byte	#
	plus rmemdat 0	crw
	and arg4 arg4	cpuaddr wmem byte

	minus arg1 1	arg1			# 457
	plus arg2 1	arg2			# 458
	minus arg3 1	arg3			# 459
	plus arg4 1	arg4 goto movc5_f_loop1	# 460
movc5_f_loop2:
	and arg3 arg3	zcond goto movc5_done	# 461
	plus argp0 0	crw	# fill byte	# 462
	plus arg4 0	cpuaddr wmem byte	# 463

	minus arg3 1	arg3			# 464
	plus arg4 1	arg4 goto movc5_f_loop2	# 465

movc5_backw:
	and 0 0		resopflt eoi


movc5_done:
	and arg4 arg4	arg3	# for movc3
	and 0 0		crn
	and arg1 arg1	crw wreg goto movc3_donex
#
# 
cmpc5:
	and argd0 FF		argp0	# save fill byte

	# while {tmp1 NEQU 0 } and {tmp3 NEQU 0}
cmpc5_loop1:
	and arg1 arg1		zcond goto cmpc5_loop2
	and arg3 arg3		zcond goto cmpc5_loop2

	and arg2 arg2		cpuaddr rmem byte
	and rmemdat FF		argd0			# mask byte
	and arg4 arg4		cpuaddr rmem byte
	and rmemdat FF		argd1
	minus argd0 argd1	nzcond goto cmpc5_exit	# not equal
	minus arg1 1	arg1
	plus arg2 1	arg2
	minus arg3 1	arg3
	plus arg4 1	arg4	goto cmpc5_loop1

	# while {tmp1 NEQU 0 } and {tmp3 EQU 0}
cmpc5_loop2:
	and arg1 arg1	zcond goto cmpc5_loop3
	and arg3 arg3	nzcond goto cmpc5_loop3

	and arg2 arg2		cpuaddr rmem byte
	and rmemdat FF		argd0
	and argp0 FF		argd1
	minus argd0 argd1	nzcond goto cmpc5_exit
	minus arg1 1		arg1
	plus arg2 1		arg2 goto cmpc5_loop2

	# while {tmp3 NEQU 0 } and {tmp1 EQU 0}
cmpc5_loop3:
	and arg1 arg1	nzcond goto cmpc5_exit
	and arg3 arg3	zcond goto cmpc5_exit

	and arg2 arg2		cpuaddr rmem byte
	and rmemdat FF		argd1
	and argp0 FF		argd0
	minus argd0 argd1	nzcond goto cmpc5_exit
	minus arg3 1		arg3
	plus arg4 1		arg4 goto cmpc5_loop3

cmpc5_exit:
	and 0 0			crn
	plus arg1 0		crw wreg
	and 1 1			crn
	plus arg2 0		crw wreg
	and 2 2			crn
	plus arg3 0		crw wreg
	and 3 3			crn
	plus arg4 0		crw wreg
	minus argd0 argd1	savnz savc eoi
#
# CALLS arg1,arg2,arg3 (numarg, dst, sp(fake))
#
calls:
	and 2000 2000		argp0	# CALLS
	plus arg1 0		crw
	minus arg3 4		cpuaddr wmem long # store numarg on stack
	minus arg3 4		arg3		# push on stack
	plus arg3 0		arg1 goto callg_1 # stack pos as AP

#
# CALLG arg1,arg2,arg3 (arglist, dst, sp(fake))
#
callg:
	and 0 0			argp0	# CALLG
callg_1:
	and arg3 3		argp1	# 527 stack align bits
	bic 3 arg3		arg3	# arg3 now aligned stack
	and arg2 arg2		cpuaddr rmem word # reg mask

	and rmemdat FFFF	argd1	# 530 save entry word
	shl rmemdat 14		arg4	# entry mask left shifted
	and B B			argd0	# 11 regs
# save regs
callg_rloop:
	and arg4 arg4		nncond goto callg_rloop1 # 533 skip if no save

	plus argd0 0		crn	# set cur_reg_num
	plus crv 0		crw	# put cur_reg_val in wdata
	minus arg3 4		cpuaddr wmem long # write to stack
	minus arg3 4		arg3 		# write to stack

callg_rloop1:
	shl arg4 1		arg4 zcond goto callg_sreg # getout if empty
	minus argd0 1		argd0 goto callg_rloop	# sub 539 reg num

# save PC/FP/AP
callg_sreg:
	and F F			crn	# 540 PC
	plus crv 0		crw	# put cur_reg_val in wdata
	minus arg3 4		cpuaddr wmem long	 # write to stack
	and D D			crn	# FP
	plus crv 0		crw	# 544 put cur_reg_val in wdata
	minus arg3 8		cpuaddr wmem long	 # write to stack
	and C C			crn	# 546 AP
	plus crv 0		crw	# put cur_reg_val in wdata
	minus arg3 C		cpuaddr wmem long	 # 548 write to stack

# create next words to save
	shl argp1 E		argd0	# 550 stack align in bit 15-14
	and argd1 FFF		arg4	# only reg mask bit 0-11
	bis argd0 arg4		argd0	# merge
	bis argp0 argd0		argd0	# set CALLS/CALLG bit
	shl argd0 10		argd0	# put in bit 31-16
	and psl FFE0		arg4
	bis arg4 argd0		crw	# mask finished
	minus arg3 10		cpuaddr wmem long # 556
	and 0 0			crw	# zero longword
	minus arg3 14		cpuaddr wmem long
#  give regs new values
	and D D			crn	# 559
	minus arg3 14		crw wreg # set FP to SP
	and E E			crn
	minus arg3 14		crw wreg # set SP to SP
	and C C			crn
	and arg1 arg1		crw wreg # set AP to arglist
	bic EF psl		psl	# clear psw except T
	and argd1 8000		zcond goto callg_2 # 566
	bis psl 80		psl	# set DV
callg_2:
	and argd1 4000		zcond goto callg_3
	bis psl 20		psl	# set IV
callg_3:
	and F F			crn
	plus arg2 2		crw wreg # set PC
	plus 0 0		eoi	# DONE
#
# arg1 is fp on entry
ret:
	plus arg1 4	argd1		# 579 SP now in argd1
	plus argd1 0	cpuaddr rmem
	plus rmemdat 0	arg1		# 581 tmp1

	plus argd1 4	cpuaddr rmem	# 582 fetch AP val from stack
	and C C		crn		# set AP as dest reg
	plus rmemdat 0	crw wreg	# write to reg

	plus argd1 8	cpuaddr rmem	# 585 fetch FP val from stack
	and D D		crn		# set FP as dest reg
	plus rmemdat 0	crw wreg	# write to reg

	plus argd1 C	cpuaddr rmem	# 588 fetch PC val from stack
	and F F		crn		# set PC as dest reg
	plus rmemdat 0	crw wreg	# write to reg
	plus argd1 10	argd1		# 591 adjust SP

# restore regs
	shr arg1 10	arg2		# 592 get reg bitmask
	and arg2 FFF	arg2		# mask out mask
	and 0 0		arg3		# 594 reg counter
ret_regs:
	and arg2 arg2	zcond goto ret_regs1	# getout if no more regs
	and arg2 1	zcond goto ret_regs2	# more regs but not this

	plus argd1 0	cpuaddr rmem	# 597 fetch val from stack
	plus arg3 0	crn		# set next reg num
	plus rmemdat 0	crw wreg	# write to reg
	plus argd1 4	argd1		# 600 pop from stack
ret_regs2:
	plus arg3 1	arg3
	shr arg2 1	arg2 goto ret_regs

ret_regs1:
# adjust stack alignment
	shr arg1 1E	arg2		# 603 stack adj
	plus argd1 arg2	argd1		# add!
	shl arg1 2	nncond goto ret_2 # CALLS?
	plus argd1 0	cpuaddr rmem	# 606 get nargs from stack
	and rmemdat FF	arg4		# zero extend
	shl arg4 2	arg4		# get bytes
	plus argd1 arg4	argd1		# adj stack
	plus argd1 4	argd1		# pop word
ret_2:
	and E E		crn		# 611
	plus argd1 0	crw wreg
	bic FFFF psl	psl
	and arg1 FFFF	arg1
	bis arg1 psl	arg1 eoi	# 615
#
# PUSHR arg1=mask, arg2=sp
pushr:
	and E E		arg3		# reg count
	shl arg1 11	arg1
pushr_1f:
	and arg1 arg1	zcond goto pushr_end
	and arg1 arg1	nncond goto pushr_2
	plus arg3 0	crn
	minus arg2 4	arg2
	plus crv 0	crw
	plus arg2 0	cpuaddr wmem
pushr_2:
	minus arg3 1	arg3
	shl arg1 1	arg1 goto pushr_1f
pushr_end:
	and E E		crn
	plus arg2 0	crw wreg
popr_end:
	plus 0 0	eoi
#
# POPR arg1=mask, arg2=sp
popr:
	and 0 0		arg3		# reg 0 first
popr_loop:
	and arg1 7FFF	arg1 zcond goto popr_end # no more regs to pop
	and arg1 1	zcond goto popr_1f	# no pop

	plus arg2 0	cpuaddr rmem
	plus arg3 0	crn
	plus rmemdat 0	crw wreg
	plus arg2 4	arg2

popr_1f:
	shr arg1 1	arg1
	plus arg3 1	arg3 goto popr_loop
#
# FFC/FFS	rl,rb,wb,wl (arg1,arg2,argp0,argp1)
ffs:	bis 1 psl	psl goto ff_in
ffc:	bic 1 psl	psl		# 639 use C bit for searching
ff_in:
	plus argp1 0	argd1			# 640 save findpos
	plus arg1 0	arg4			# 641 save startpos
	and arg2 arg2	zcond goto ff_zero	# exit if size zero
	and 4 4		argp1 goto bfield	# 643 ret 4
ffc_1:	
# bitfield in argd0, size in arg2
	plus argd1 0	argp1	# 644 restore findpos
	plus arg4 0	arg1	# restore startpos
	and 0 0		argd1	# reset pos counter
ff_2:
	minus argd1 arg2	zcond goto ff_notfound savnz # 645 NZ=01
	xor psl argd0	arg4
	and arg4 1	zcond goto ff_found	# 647
	shr argd0 1	argd0
	plus argd1 1 	argd1 goto ff_2		# 649
ff_found:
	plus arg1 argd1	argd1
	and 1 1		savnz eoi	# NZ=00
ff_notfound:
	plus arg1 argd1	argd1 eoi	# 651
#
# field size 0
ff_zero:
	plus arg1 0	argd1 savnz eoi
#
# LOCC arg3,arg1,arg2
locc:
	and arg3 FF	arg3	# ensure zero-extended
locc_2:
	and arg1 arg1	zcond goto locc_1	# zero len
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	arg4			# zero-extend read byte
	minus arg4 arg3	zcond goto locc_1	# equality?
	minus arg1 1	arg1
	plus arg2 1	arg2 goto locc_2

locc_1:
	and 0 0		crn
	plus arg1 0	crw wreg savnz	# save final len
	and 1 1		crn
	plus arg2 0	crw wreg	# save final addr
	plus 0 0	eoi
#
# INSQUE arg1,arg2 (entry,pred)
insque:
	# *entry = *pred
	plus arg2 0	cpuaddr rmem long	# fetch *pred
	plus rmemdat 0	arg4			# save for later
	plus rmemdat 0	crw
	plus arg1 0	cpuaddr wmem long	# write to *entry

	# *(entry+4) = pred
	plus arg2 0	crw
	plus arg1 4	cpuaddr wmem long

	# *(*pred + 4) = entry
	plus arg2 0	cpuaddr rmem long
	plus arg1 0	crw
	plus rmemdat 4	cpuaddr wmem long

	# *pred = entry
	plus arg1 0	crw
	plus arg2 0	cpuaddr wmem long

	# Set flags, arg4 < arg2
	minus arg4 arg2		argd0 savc savnz eoi
#
# REMQUE arg1,arg1p (entry,addr)
remque:
	# **(entry+4) = *entry
	plus arg1 0	cpuaddr rmem long
	plus rmemdat 0	arg4
	plus arg1 4	cpuaddr rmem long
	plus arg4 0	crw
	plus rmemdat 0	cpuaddr wmem long

	# *(*entry+4) = *(entry+4)
	plus arg1 4	cpuaddr rmem long	# *(entry+4)
	plus rmemdat 0	arg4
	plus arg1 0	cpuaddr rmem long	# *entry
	plus arg4 0	crw
	plus rmemdat 4	cpuaddr wmem long

	# addr = entry
	plus arg1 0	argd1

	# calc psl bits
	bic 2 psl	psl
	plus arg1 4	cpuaddr rmem long
	minus rmemdat arg1 nzcond goto remque_1
	bis 2 psl	psl
remque_1:
	plus arg1 0	cpuaddr rmem long
	plus rmemdat 0	arg3
	plus arg1 4	cpuaddr rmem long
	plus rmemdat 0	arg4
	minus arg3 arg4	argd0 savc savv savnz eoi
#
