#	$Id$
#
# r saves the final value
# w saves the ptr value
# m saves the ptr value, then also save the final value
# a saves the ptr as final value
# b just fetches the the next byte/word
#
# useadd	- use add path
# usebr		- use branch path
# usemfpr	- move from processor register
# usemtpr	- move to processor register
# usebic	- use bit clear
#
# setnz		- set nz flags based on result
# setaddc	- set c based on result of last add
# setaddv	- set v based on result of last add
# clv		- clear v
#
# zero		- hidden arg is zero (argno hidden first)
# one		- hidden arg is one (argno hidden first)
#
# wback		- write result to destination
#
!OPCODES
#
02	REI
#
05	RSB
#
10	BSBB
11	BRB
12	BNEQ
13	BEQL
14	BGTR
15	BLEQ
16	JSB
17	JMP
18	BGEQ
19	BLSS
1A	BGTRU
1B	BLEQU
1C	BVC
1D	BVS
1E	BGEQU
1F	BLSSU
#
30	BSBW
31	BRW
#
3C	MOVZWL
#
7C	CLRQ
7D	MOVQ
#
82	SUBB2
83	SUBB3
#
88	BISB2
89	BISB3
8A	BICB2
8B	BICB3
#
90	MOVB
91	CMPB
#
93	BITB
94	CLRB
95	TSTB
#
97	DECB
#
9A	MOVZBL
9B	MOVZBW
9C	ROTL
#
A2	SUBW2
A3	SUBW3
#
A8	BISW2
A9	BISW3
AA	BICW2
AB	BICW3
#
B0	MOVW
B1	CMPW
#
B3	BITW
#
B5	TSTW
#
B7	DECW
B8	BISPSW
B9	BICPSW
BA	POPR
BB	PUSHR
#
C0	ADDL2
C1	ADDL3
C2	SUBL2
C3	SUBL3
#
C8	BISL2
C9	BISL3
CA	BICL2
CB	BICL3
#
CD	XORL3
#
D0	MOVL
D1	CMPL
#
D3	BITL
D4	CLRL
D5	TSTL
D6	INCL
D7	DECL
#
DA	MTPR
DB	MFPR
DC	MOVPSL
#
DE	MOVAL
#
E0	BBS
E1	BBC
E2	BBSS
E3	BBCS
E4	BBSC
E5	BBCC
E6	BBSSI
E7	BBCCI
E8	BLBS
E9	BLBC
#
F0	INSV
#
F3	AOBLEQ
#
!MICROCODE
#
# [label:] op left right	[args...]
#
mov:	plus arg1 0		argd0 wback eoi
tst:	plus arg1 0		argd0 eoi
add:	plus arg1 arg2		argd0 wback eoi
add1:	plus arg1 1		argd0 wback eoi
clr:	plus 0 0		argd0 wback eoi
xor:	xor arg1 arg2		argd0 wback eoi
cmp:	minus arg1 arg2		argd0 savc eoi
bicpsw:	bic arg1 psl		psl eoi
bispsw:	bis arg1 psl		psl eoi
bic:	bic arg1 arg2		argd0 wback eoi
and:	and arg1 arg2		argd0 eoi
#
# Check if a given bit in psl is set
bset:	plus arg1 0	argd0			# move new pc to dest
	and arg2 psl	nzcond wback eoi	# if result Z writeback
#
#
!INSTRUCTIONS
REI	rl#(sp)+,rl#0,rl#(sp)+,wl#pc,wl#pc	useadd wback2	# 02
#
RSB	rl#(sp)+,rl#0,wl#pc	useadd wback 			# 05
#
BSBB	ab#b^d(pc),rl#0,rl#pc,wl#pc,wl#-(sp)	useadd move2 wback wback2
BRB	aw#b^d(pc),wl#pc	lbl=mov				# 11
#BRB	aw#b^d(pc),rl#0,wl#pc	useadd wback			# 11
BNEQ	ab#b^d(pc),rl#0,wl#pc	useadd wback ccz iscpsw		# 12

#BEQL	ab#b^d(pc),rl#0,wl#pc	useadd wback ccz isspsw		# 13
BEQL	ab#b^d(pc),rl#4,wl#pc	lbl=bset			# 13

BGTR	ab#b^d(pc),rl#0,wl#pc	useadd wback ccz ccn iscpsw	# 14
BLEQ	ab#b^d(pc),rl#0,wl#pc	useadd wback ccz ccn isspsw	# 15
JSB	ab,rl#0,rl#pc,wl#pc,wl#-(sp)	useadd move2 wback wback2 # 16
#JMP	ab,rl#0,wl#pc	useadd wback				# 17
JMP	ab,wl#pc	lbl=mov					# 17
BGEQ	ab#b^d(pc),rl#0,wl#pc	useadd wback ccn iscpsw		# 18
BLSS	ab#b^d(pc),rl#0,wl#pc	useadd wback ccn isspsw		# 19
BGTRU	ab#b^d(pc),rl#0,wl#pc	useadd wback ccc ccz iscpsw	# 1a
BLEQU	ab#b^d(pc),rl#0,wl#pc	useadd wback ccc ccz isspsw	# 1b
BVC	ab#b^d(pc),rl#0,wl#pc	useadd wback ccv iscpsw		# 1c
BVS	ab#b^d(pc),rl#0,wl#pc	useadd wback ccv isspsw		# 1d
BGEQU	ab#b^d(pc),rl#0,wl#pc	useadd wback ccc iscpsw		# 1e
BLSSU	ab#b^d(pc),rl#0,wl#pc	useadd wback ccc isspsw		# 1f
#
BSBW	aw#w^d(pc),rl#0,rl#pc,wl#pc,wl#-(sp)	useadd move2 wback wback2 
BRW	aw#w^d(pc),wl#pc	lbl=mov wback 			# 31
#
MOVZWL	rw,wl		usezex setnz clv wback			# 3c
#
CLRQ	rq#0,wq		useadd setnz clv quad wback wback2	# 7c
#MOVQ	rq,rl#0,wq	useadd setnz clv quad wback wback2	# 7d
#
MOVB	rb,wb		lbl=mov setnz clv			# 90
CMPB	rb,rb		lbl=cmp setnz clv setc			# 91
#
#BITB	rb,rb		useand setnz clv			# 93
CLRB	wb		lbl=clr setnz clv 			# 94
TSTB	rb		lbl=tst setnz clv clc			# 95
#
MOVZBL	rb,wl		usezex setnz clv wback			# 9a
MOVZBW	rb,ww		usezex setnz clv wback			# 9b
ROTL	rb,rl,wl	userot setnz clv wback			# 9c
#
MOVW	rw,rw#0,ww	useadd setnz clv wback			# b0
CMPW	rw,rw		lbl=cmp setnz clv setc			# b1
#
TSTW	rw		lbl=tst setnz clv clc			# b5
#
BISPSW	rw		lbl=bispsw				# b8
BICPSW	rw		lbl=bicpsw				# b9
POPR	rw		popr					# ba
PUSHR	rw		iemul					# bb
# 
#ADDL2	rl,ml		lbl=add setnz setaddv setc wback 	# c0
ADDL3	rl,rl,wl	useadd setnz setaddv setc wback 	# c1
SUBL2	1rl,0ml		usesub setnz wback			# c2
#
BISL2	rl,ml		usebis setnz clv wback			# c8
BICL2	rl,ml		lbl=bic setnz clv			# ca
#
XORL3	rl,rl,wl	lbl=xor setnz clv			# cd
#
MOVL	rl,wl		lbl=mov setnz clv			# d0
CMPL	rl,rl		usesub setnz clv setc			# d1
#
BITL	rl,rl		useand setnz clv 			# d3
CLRL	wl		lbl=clr setnz clv 			# d4
TSTL	rl		lbl=tst setnz clv clc 			# d5
INCL	ml		lbl=add1 setnz				# d6
DECL	ml,rl#1		usesub setnz wback 			# d7
#
MTPR	rl,rl		usemtpr 				# da
MFPR	rl,wl		usemfpr wback				# db
MOVPSL	wl		movpsl wback				# dc
#
MOVAL	al,wl		lbl=mov setnz clv			# de
#
BBS	rl,rl,ab#b^d(pc),wl#pc,wl#pc bbs move2 wback2		# e0
BBC	rl,rl,ab#b^d(pc),wl#pc,wl#pc bbc move2 wback2		# e1
BBSS	rl,ml,ab#b^d(pc),wl#pc bbs setbit move2 wback wback2	# e2
BBCS	rl,ml,ab#b^d(pc),wl#pc bbc setbit move2 wback wback2	# e3
BBSC	rl,ml,ab#b^d(pc),wl#pc bbs clrbit move2 wback wback2	# e4
BBCC	rl,ml,ab#b^d(pc),wl#pc bbc clrbit move2 wback wback2	# e5
BBSSI	rl,ml,ab#b^d(pc),wl#pc bbs setbit move2 wback wback2	# e6
BBCCI	rl,ml,ab#b^d(pc),wl#pc bbc clrbit move2 wback wback2	# e7
BLBS	rl#0,rl,ab#b^d(pc),wl#pc,wl#pc bbs move2 wback2		# e8
BLBC	rl#0,rl,ab#b^d(pc),wl#pc,wl#pc bbc move2 wback2		# e9
#
#INSV	rl,rl,rb,ml	insv wback				# f0
#INSV	rl,rl,rb,wb	iemul					# f0
#
AOBLEQ	rl,ml,ab#b^d(pc),wl#pc setnz useacb move2 wback		# f3
