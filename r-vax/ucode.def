#	$Id$
#
# r saves the final value
# w saves the ptr value
# m saves the ptr value, then also save the final value
# a saves the ptr as final value
# b just fetches the the next byte/word
#
# usemfpr	- move from processor register
# usemtpr	- move to processor register
#
# setnz		- set nz flags based on result
# setaddc	- set c based on result of last add
# setaddv	- set v based on result of last add
# clv		- clear v
#
# zero		- hidden arg is zero (argno hidden first)
# one		- hidden arg is one (argno hidden first)
#
# wback		- write result to destination
#
!OPCODES
#
02	REI
#
05	RSB
#
10	BSBB
11	BRB
12	BNEQ
13	BEQL
14	BGTR
15	BLEQ
16	JSB
17	JMP
18	BGEQ
19	BLSS
1A	BGTRU
1B	BLEQU
1C	BVC
1D	BVS
1E	BGEQU
1F	BLSSU
#
30	BSBW
31	BRW
#
3C	MOVZWL
#
7C	CLRQ
7D	MOVQ
#
82	SUBB2
83	SUBB3
#
88	BISB2
89	BISB3
8A	BICB2
8B	BICB3
#
90	MOVB
91	CMPB
#
93	BITB
94	CLRB
95	TSTB
#
97	DECB
#
9A	MOVZBL
9B	MOVZBW
9C	ROTL
#
A2	SUBW2
A3	SUBW3
#
A8	BISW2
A9	BISW3
AA	BICW2
AB	BICW3
#
B0	MOVW
B1	CMPW
#
B3	BITW
#
B5	TSTW
#
B7	DECW
B8	BISPSW
B9	BICPSW
BA	POPR
BB	PUSHR
#
C0	ADDL2
C1	ADDL3
C2	SUBL2
C3	SUBL3
#
C8	BISL2
C9	BISL3
CA	BICL2
CB	BICL3
#
CD	XORL3
#
D0	MOVL
D1	CMPL
#
D3	BITL
D4	CLRL
D5	TSTL
D6	INCL
D7	DECL
#
DA	MTPR
DB	MFPR
DC	MOVPSL
#
DE	MOVAL
#
E0	BBS
E1	BBC
E2	BBSS
E3	BBCS
E4	BBSC
E5	BBCC
E6	BBSSI
E7	BBCCI
E8	BLBS
E9	BLBC
#
F0	INSV
#
F3	AOBLEQ
#
!MICROCODE
#
# [label:] op left right	[args...]
#
mov:	plus arg1 0		argd0 savnz eoi
tst:	plus arg1 0		argd0 savnz eoi
add:	plus arg1 arg2		argd0 savnz eoi
add1:	plus arg1 1		argd0 savc savnz eoi
clr:	plus 0 0		argd0 savnz eoi
xor:	xor arg1 arg2		argd0 savnz eoi
sub:	minus arg1 arg2		argd0 savc savnz eoi
bicpsw:	bic arg1 psl		psl eoi
bispsw:	bis arg1 psl		psl eoi
movpsl:	plus psl 0		argd0 savnz eoi
bic:	bic arg1 arg2		argd0 savnz eoi
bis:	bis arg1 arg2		argd0 savnz eoi
and:	and arg1 arg2		argd0 savnz eoi
zwl:	and arg1 FFFF		argd0 savnz eoi
zbl:	and arg1 FF		argd0 savnz eoi
#
# mtpr arg1=val,arg2=ipr
#mtpr:
#	plus arg2 0	crn		# set current ipr number
#	plus arg1 0	crw wipr	# write to current ipr
## check special cases for IPRs.
#	and 0 0		arg3		# have zeroed reg
#
#	minus arg2 23	nzcond mtpr_1	# skip if not TXDB
#	plus arg3 2000	arg3
#	shl arg3 10	arg3
#	plus arg3 1F76	cpuaddr phys	# address for TXDB
#	plus arg1 0	cpudata wmem	# write!
#mtpr_1:	
#	plus 0 0	eoi

# mfpr arg1=ipr,arg2=dest
mfpr:
	and 3E 3E	arg3		# SID
	minus arg1 arg3	nzcond goto mfpr_1
	and 0A00 0A00	arg2
	shl arg2 10	arg2
	plus arg2 6	argd0 eoi
mfpr_1:
	and 22 22	arg3		# TXCS
	minus arg1 arg3	nzcond goto mfpr_2
	and 2000 2000	arg3
	shl arg3 10	arg3
	plus arg3 1F74	cpuaddr rmem
	plus rmemdat 0	argd0 eoi
mfpr_2:
	and 20 20	arg3
	minus arg1 arg3	nzcond goto mfpr_3
	and 2000 2000	arg3
	shl arg3 10	arg3
	plus arg3 1F70	cpuaddr rmem
	plus rmemdat 0	argd0 eoi
mfpr_3:
	plus 0 0	resopflt eoi

#
# Move quad word. First long is already read, extract addr for the
# second, read val, update flags, write to output regs.
# input addr in argp0 (must later be updated), output in argp1
#
# XXX - need mov, shifted reg bits, split savn/savz
#
movq:
	plus arg1 0	argd0			# 16 store lowword
# get input addr
	shr argp0 1E	arg4			# 17 arg4 = (argp0 >> 30)
	minus arg4 3	arg4			# 18 arg4 = arg1 - 3
	plus arg4 arg4	nzcond goto movq_rmem	# 19 if (arg4+arg4) goto...
	plus argp0 1	crn			# 20 inc read reg by 1
	plus crv 0	argd1			# 21 save in highword
	plus arg1 arg1	goto movq_cmn		# 22
movq_rmem:
	plus argp0 4	cpuaddr rmem 		# 23 inc addr for read
	plus rmemdat 0	argd1			# 24
	
movq_cmn:
# Fix correct status bits
	shr argd0 1	arg1		# shift in 0 as sign bit
	and argd0 1	arg2		# get just lost low bit
	plus arg1 arg2	arg1		# add it to check result
	plus argd1 arg1	savnz		# set NZ bits by adding high and low

# update output address
	plus argp1 0	argp0

	shr argp0 1E	arg1			# arg1 = (argp0 >> 30)
	minus arg1 3	arg1			# arg1 = arg1 - 3
	plus arg1 arg1	nzcond goto movq_mem	# if (arg1+arg1) goto...
	plus argp0 1	argp1 eoi		# inc by 1
movq_mem:
	plus argp0 4	argp1 eoi		# inc by 4

#
# Clear quad word.  extract addr and set both output correct.
#
clrq:	plus 0 0	argd0			# clear both
	plus 0 0 	argd1
	shr argp0 1E	arg1			# arg1 = (argp0 >> 30)
	minus arg1 3	arg1			# arg1 = arg1 - 3
	plus arg1 arg1	nzcond goto clrq_mem	# if (arg1+arg1) goto...
	plus argp0 1	argp1 eoi		# inc by 1
clrq_mem:
	plus argp0 4	argp1 eoi		# inc by 4
	
#
# Check if a given bit in psl is set
bset:	plus arg1 0	argd0			# move new pc to dest
	and arg2 psl	nzcond wback eoi	# if result Z writeback
# Check if given bit(s) in psl are clear
bclr:	plus arg1 0	argd0			# move new pc to dest
	and arg2 psl	zcond wback eoi		# if result Z writeback
#
# ROTL: arg1 == shift count, arg2 = val
rot:	shl arg2 arg1	argd0
	and arg1 1F	argd1
	minus 20 argd1	argd1
	shr arg2 argd1 	argd1
	bis argd1 argd0	argd0 savnz eoi
#
#
aobleq:	plus 1 arg2		argd0 savc savnz	# inc index
	plus arg3 0		argd1			# save branch addr
	minus arg1 argd0 	nncond wback2 eoi	# br if !(ix > l)
#
# arg1=pos, arg2=base, arg3=displ
bbc:	shr arg2 arg1	argd0
	plus arg3 0	argd1
	and argd0 1	zcond wback2 eoi
bbs:	shr arg2 arg1	argd0
	plus arg3 0	argd1
	and argd0 1	nzcond wback2 eoi
#
# pos, base, displ
# BBSS	rl,ml,ab#b^d(pc),wl#pc
bbss:	shl 1 arg1	argd0		# position bit
	plus 0 arg3	argd1		# save br addr
	and argd0 arg2	nzcond wback2	# br if set
	bis argd0 arg2	argd0 eoi	# set bit
bbsc:	shl 1 arg1	argd0		# position bit
	plus 0 arg3	argd1		# save br addr
	and argd0 arg2	nzcond wback2	# br if set
	bic argd0 arg2	argd0 eoi	# clear bit
bbcs:	shl 1 arg1	argd0		# position bit
	plus 0 arg3	argd1		# save br addr
	and argd0 arg2	zcond wback2	# br if set
	bis argd0 arg2	argd0 eoi	# set bit
bbcc:	shl 1 arg1	argd0		# position bit
	plus 0 arg3	argd1		# save br addr
	and argd0 arg2	zcond wback2	# br if set
	bic argd0 arg2	argd0 eoi	# clear bit
#
# INSV arg1=pos,arg2=size,argd0/1=base(val),arg4=src
#
insv:	shr argp0 1E	argd0		# 56
	minus argd0 3	argd0		# 57
	plus argd0 argd0 nzcond goto insv_mem	# 58
#
# value is in register
# First check whether a resopflt should be generated
	and arg2 arg2	zcond goto insv_zero # no check if size zero
	minus arg1 20	nncond resopflt	# resopflt if size > 31
insv_zero:
	plus argp0 0	crn		# 59 set cur reg num
	plus crv 0	argd0		# 60 move val to dest
	plus argp0 1	argp1		# if two regs
	plus argp0 1	crn		# if two regs
	plus crv 0	argd1 		# 60 move val to dest
	and arg1 arg1	goto insv_common # 60 move val to dest
insv_mem:
# Notyet...
insv_common:

# Any writeback?
	plus arg2 arg2	nzcond wback	# write back low word if sz != 0
	plus arg2 arg1	arg3		# size + pos
	minus 20 arg3	ncond wback2	# if > 32 write back high word
#
# Lower longword
#
	minus arg2 20	arg3
	and arg3 arg3	nzcond goto insv_not20
	bic arg3 arg3	arg3
	minus arg3 1	arg3
	and arg3 arg3	goto insv_sz
insv_not20:
	shl 1 arg2	arg3		# 61 shift left size bits
	minus arg3 1	arg3		# 62 create mask (in arg3)
insv_sz:
	and arg3 arg4	arg4		# 63 clear unwanted bits in src
	shl arg3 arg1	arg3		# 64 shift left pos bits in mask
	bic arg3 argd0	argd0		# 65 clear unwanted bits in dest
	shl arg4 arg1	arg3		# 66 put shifted src in arg3
	bis arg3 argd0	argd0		# 67 written in dest
#
# Upper long
#
	shl 1 arg2	arg3		# 61 shift left size bits
	minus arg3 1	arg3		# 62 create mask (in arg3)
	minus 20 arg1	arg1		# pos = 32-pos (leftover in lowword)
	shr arg4 arg1	arg4		# shrink src
	shr arg3 arg1	arg3		# shrink mask
	bic arg3 argd1	argd1		# clear unwanted bits from d1
	bis arg4 argd1	argd1 eoi	# set wanted bits in d1

#
#
!INSTRUCTIONS
#
RSB	rl#(sp)+,wl#pc	lbl=mov wback 				# 05
#
BSBB	0ab#b^d(pc),2rl#pc,wl#pc,wl#-(sp)	lbl=mov move2 wback wback2
BRB	aw#b^d(pc),wl#pc	lbl=mov wback			# 11
BNEQ	ab#b^d(pc),rl#4,wl#pc	lbl=bclr 			# 12
BEQL	ab#b^d(pc),rl#4,wl#pc	lbl=bset			# 13
BGTR	ab#b^d(pc),rl#C,wl#pc	lbl=bclr 			# 14
BLEQ	ab#b^d(pc),rl#C,wl#pc	lbl=bset 			# 15
JSB	0ab,2rl#pc,wl#pc,wl#-(sp)	lbl=mov move2 wback wback2 # 16
JMP	ab,wl#pc	lbl=mov wback				# 17
BGEQ	ab#b^d(pc),rl#8,wl#pc	lbl=bclr 			# 18
BLSS	ab#b^d(pc),rl#8,wl#pc	lbl=bset 			# 19
BGTRU	ab#b^d(pc),rl#5,wl#pc	lbl=bclr 			# 1a
BLEQU	ab#b^d(pc),rl#5,wl#pc	lbl=bset 			# 1b
BVC	ab#b^d(pc),rl#2,wl#pc	lbl=bclr			# 1c
BVS	ab#b^d(pc),rl#2,wl#pc	lbl=bset 			# 1d
BGEQU	ab#b^d(pc),rl#1,wl#pc	lbl=bclr			# 1e
BLSSU	ab#b^d(pc),rl#1,wl#pc	lbl=bset			# 1f
#
BSBW	0aw#w^d(pc),2rl#pc,wl#pc,wl#-(sp)	lbl=mov move2 wback wback2 
BRW	aw#w^d(pc),wl#pc	lbl=mov wback 			# 31
#
MOVZWL	rw,wl		lbl=zwl setnz clv wback			# 3c
#
#CLRQ	rq#0,wq		lbl=movq setnz clv wback wback2		# 7c
CLRQ	wq		lbl=clrq setnz clv wback wback2		# 7c
#MOVQ	rq,wq		lbl=movq setnz clv wback wback2		# 7d
MOVQ	mq,wq		lbl=movq setnz clv wback wback2		# 7d
#
MOVB	rb,wb		lbl=mov setnz clv wback			# 90
CMPB	rb,rb		lbl=sub setnz clv setc			# 91
#
#BITB	rb,rb		lbl=andb setnz clv			# 93
CLRB	wb		lbl=clr setnz clv wback			# 94
TSTB	rb		lbl=tst setnz clv clc			# 95
#
MOVZBL	rb,wl		lbl=zbl setnz clv wback			# 9a
MOVZBW	rb,ww		lbl=zbl setnz clv wback			# 9b
ROTL	rb,rl,wl	lbl=rot setnz clv wback			# 9c
#
MOVW	rw,ww		lbl=mov setnz clv wback			# b0
CMPW	rw,rw		lbl=sub setnz clv setc			# b1
#
TSTW	rw		lbl=tst setnz clv clc			# b5
#
BISPSW	rw		lbl=bispsw				# b8
BICPSW	rw		lbl=bicpsw				# b9
# 
ADDL2	rl,ml		lbl=add setnz setc wback 		# c0
ADDL3	rl,rl,wl	lbl=add setnz setc wback 		# c1
SUBL2	1rl,0ml		lbl=sub setnz wback			# c2
#
BISL2	rl,ml		lbl=bis setnz clv wback			# c8
BICL2	rl,ml		lbl=bic setnz clv wback			# ca
#
XORL3	rl,rl,wl	lbl=xor setnz clv wback			# cd
#
MOVL	rl,wl		lbl=mov setnz clv wback			# d0
CMPL	rl,rl		lbl=sub setnz clv setc			# d1
#
BITL	rl,rl		lbl=and setnz clv 			# d3
CLRL	wl		lbl=clr setnz clv wback 		# d4
TSTL	rl		lbl=tst setnz clv clc 			# d5
INCL	ml		lbl=add1 setnz setc wback		# d6
DECL	ml,rl#1		lbl=sub setnz wback 			# d7
#
MTPR	rl,rl		usemtpr 				# da
#MFPR	rl,wl		usemfpr wback				# db
#MTPR	rl,rl		lbl=mtpr 				# da
MFPR	rl,wl		lbl=mfpr wback				# db
MOVPSL	wl		lbl=movpsl wback			# dc
#
MOVAL	al,wl		lbl=mov setnz clv wback			# de
#
BBS	rl,rl,ab#b^d(pc),wl#pc,wl#pc lbl=bbs 			# e0
BBC	rl,rl,ab#b^d(pc),wl#pc,wl#pc lbl=bbc 			# e1
BBSS	rl,ml,ab#b^d(pc),wl#pc lbl=bbss wback			# e2
BBCS	rl,ml,ab#b^d(pc),wl#pc lbl=bbcs wback			# e3
BBSC	rl,ml,ab#b^d(pc),wl#pc lbl=bbsc wback			# e4
BBCC	rl,ml,ab#b^d(pc),wl#pc lbl=bbcc wback			# e5
BBSSI	rl,ml,ab#b^d(pc),wl#pc lbl=bbss wback			# e6
BBCCI	rl,ml,ab#b^d(pc),wl#pc lbl=bbcc wback			# e7
BLBS	rl#0,rl,ab#b^d(pc),wl#pc,wl#pc lbl=bbs 			# e8
BLBC	rl#0,rl,ab#b^d(pc),wl#pc,wl#pc lbl=bbc 			# e9
#
INSV	3rl,0rl,1rb,2wl	lbl=insv				# f0
#
AOBLEQ	rl,ml,ab#b^d(pc),wl#pc lbl=aobleq setnz wback		# f3
