#	$Id$
#
# r saves the final value
# w saves the ptr value
# m saves the ptr value, then also save the final value
# a saves the ptr as final value
# b just fetches the the next byte/word
#
# useadd	- use add path
# usebr		- use branch path
# usemfpr	- move from processor register
# usemtpr	- move to processor register
# usebic	- use bit clear
#
# setnz		- set nz flags based on result
# setaddc	- set c based on result of last add
# setaddv	- set v based on result of last add
# clv		- clear v
#
# zero		- hidden arg is zero (argno hidden first)
# one		- hidden arg is one (argno hidden first)
#
# wback		- write result to destination
#
#RSB	rl#(sp)+,rl#0,wl#pc	usebic wback			# 05
RSB	rl#(sp)+,rl#0,wl#pc	useadd wback newflow		# 05
#
BSBB	ab#b^d(pc),rl#0,rl#pc,wl#pc,wl#-(sp)	useadd move2 wback wback2 newflow 
BRB	aw#b^d(pc),rl#0,wl#pc	useadd wback newflow		# 11
#
BEQL	ab#b^d(pc),rl#0,wl#pc	useadd wback newflow ccz isspsw # 13
#
JSB	ab,rl#0,rl#pc,wl#pc,wl#-(sp)	useadd move2 wback wback2 newflow # 16
JMP	ab,rl#0,wl#pc	usebic wback			# 17
#
BSBW	aw#w^d(pc),rl#0,rl#pc,wl#pc,wl#-(sp)	useadd move2 wback wback2 newflow 
BRW	aw#w^d(pc),rl#0,wl#pc	useadd wback newflow		# 31
#
CMPB	rb,rb		setnz clv			# 91
#
CLRB	rl#0,rl#0,wb	useadd setnz clv wback newflow	# 94
TSTB	rb,rl#0		useadd setnz clv clc newflow		# 95
#
CMPW	rw,rw		setnz clv			# b1
#
BISPSW	rw		bispsw newflow			# b8
BICPSW	rw		bicpsw newflow			# b9
# 
ADDL2	rl,ml		useadd setnz setaddv setaddc wback # c0 addl3 rl,rl,wl
ADDL3	rl,rl,wl	useadd setnz setaddv setaddc wback # c1 addl3 rl,rl,wl
#
BICL2	rl,ml		usebic setnz clv wback		# ca
#
XORL3	rl,rl,wl	usexor setnz clv wback newflow		# cd
#
MOVL	rl,rl#0,wl	usebis setnz clv wback		# d0
CMPL	rl,rl		setnz clv			# d1
#
CLRL	rl#0,rl#0,wl	useadd setnz clv wback newflow		# d4
TSTL	rl,rl#0		useadd setnz clv clc newflow		# d5
INCL	rl#1,ml		useadd setnz setaddv setaddc wback newflow	# d6
#
MTPR	rl,rl		usemtpr 			# da
MFPR	rl,wl		usemfpr wback			# db
MOVPSL	wl		movpsl wback newflow		# dc
#
MOVAL	al,rl#0,wl	useadd setnz clv wback newflow		# de
#
# MOVL	rl,0,wl	useadd vnz		# addl3 rl,0,wl
#
# INCL	0,ml	useadd vnz		# addl3 rl,1,wl
#
# PUSHL rl,0,2				# addl3 rl,0,-(sp)
#
# CLRL	0,0,wl				# addl3 0,0,wl
#
