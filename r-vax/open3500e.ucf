#	$Id$
#
# Constraints first
#
# Hynix chip setup time (tDS2) 1.5ns plus board delay ca .5ns.
#
NET sdram_addr<*> OFFSET = OUT : 2 : BEFORE : clkin ;
NET sdram_data<*> OFFSET = OUT : 2 : BEFORE : clkin ;
NET sdram_ras OFFSET = OUT : 2 : BEFORE : clkin ;
NET sdram_cas OFFSET = OUT : 2 : BEFORE : clkin ;
NET sdram_we OFFSET = OUT : 2 : BEFORE : clkin ;
NET sdram_ba<*> OFFSET = OUT : 2 : BEFORE : clkin ;
#
# Hynix chip acccess time (tAC2) 6ns + board delay ca .5ns.
#
#NET sdram_data<*> OFFSET = IN : 6.5 : VALID : 6.5 : AFTER : clkin ;

#
# Ignore timings for async in/out pins.
#
NET "n_rst" TIG;
NET "tti_rx" TIG;
NET "tto_tx" TIG;

#
# Pin definitions
#

# CPU pins
NET "clkin" LOC = P184 | IOSTANDARD = LVTTL;
NET "n_rst" LOC = P101 | IOSTANDARD = LVTTL;

NET "buzzer" LOC=P123 | IOSTANDARD = LVTTL;

# RS232 console device
NET "tti_rx" LOC = P75 | IOSTANDARD = LVTTL;
NET "tto_tx" LOC = P76 | IOSTANDARD = LVTTL;

# USB host adapter
#NET "usb_ncs"		LOC = P119 | IOSTANDARD = LVTTL;
