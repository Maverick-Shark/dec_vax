!MICROCODE
#
# [label:] op left right	[args...]
#
# First entries for exceptions, get numbers from 0
	plus 0 0			# entry 0, unused
	plus 0 0	goto mcheck	# entry 1
	plus 0 0	goto resop	# entry 2
	plus 0 0	goto intrq	# entry 3
	plus 0 0	goto mmflt	# entry 4: memory management fault
	plus 0 0	goto ksnv	# entry 5: kernel stack not valid
	plus 0 0	goto resinflt	# entry 6: PSL<FPD> set, instruction can't resume
	plus 0 0	goto resinflt2	# entry 7: privileged instruction (PC at the opcode)
	plus 0 0	goto resadflt	# entry 8: reserved addressing mode (PC at the opcode)
	plus 0 0	goto arithtrap	# entry 9: arithmetic trap (after the instruction)
	plus 0 0	goto tracef	# entry 10: trace fault (before the instruction)
#
# Interrupt.  Interrupt level tells which vector to use, is in savpsw.
#
intrq:
	and 0 0		argp1		# end in scb_common
	shr savpsw 10	argd0		# get IPL which is upper word in PSL
	shl savpsw B	ncond goto intrq_hw # skip is hardware interrupt
	and 15 15	crn		# set ipr SISR
	shl 1 argd0	arg1		# fix bit for masking
	plus civ 0	arg2		# XXX civ in right
	bic arg1 arg2	crw wipr	# clear bit in SISR
	shl argd0 2	arg1		# make longword offset
	plus arg1 80	argd1 goto scb_common # make SCB vector

intrq_hw:
	and argd0 1F	argd0		# 12 make vector.  Set mod as 0.
	minus argd0 18	zcond goto intrq_hw18 # skip if timer
	minus argd0 14	zcond goto intrq_14	# skip if timer
	plus 0 0	resopflt eoi

intrq_hw18: and C0 C0	argd1 goto scb_common	# interval timer

#
# console also interrupts on level14, but with different vectors.
#
intrq_14:
	and savpsw 8000	zcond goto intrq_14_1 # 17 check for tx intr
	bis psl 8000	psl		# set clear interrupt request
	bis psl 0	psl		# reset clear bit
	and FC FC	argd1 goto scb_common # console TX interrupt
intrq_14_1:
	and savpsw 4000	zcond goto intrq_14_2 # 21 check for rx intr
	bis psl 4000	psl		# set clear interrupt request
	bis psl 0	psl		# reset clear bit
	and F8 F8	argd1 goto scb_common # console RX interrupt
intrq_14_2:
	plus 0 0	resopflt eoi

#
# Machine check (SCB 04, the vector must have bit 0 set).
# Frame: the VAX 8600 one, 0x58 bytes of 0 and a byte count.
#
mcheck:
	and 20 20	argd0		# an exception
	and 4 4		argd1		# vector 04
	and 1 1		argp1 goto scb_common	# return here
mcheck_1:
	and E E		crn		# fetch stack pointer
	plus crv 0	arg2		# sp in arg2
	and 16 16	arg1		# 0x16 longs on stack
mcheck_2:
	minus arg2 4 	arg2		# next stack position
	plus arg2 0	cpuaddr		# prepare for write
	and 0 0		crw wmem xpush	# write 0
	minus arg1 1	arg1 nzcond goto mcheck_2 # count to 22

	minus arg2 4	cpuaddr		# last word onstack
	and 58 58	crw wmem xpush	# write 0x58
	and E E		crn		# stack pointer
	minus arg2 4	crw wreg	# write back
	plus 0 0	eoi		# Done!

#
# Reserved operand (SCB 18). The hardware has already backed the PC up to
# the opcode and restored the registers and the PSL.
resop:
	and 0 0		argp1		# end in scb_common
	and 20 20	argd0		# an exception
	and 18 18	argd1 goto scb_common
#
# Reserved instruction (SCB 10), handled entirely in microcode.
# No parameters are pushed. The PC points after the opcode: back it up.
resinflt:
	and 0 0		argp1		# end in scb_common
	and 20 20	argd0		# an exception
	and F F		crn		# set PC
	minus crv 1	crw wreg	# sub one from PC
	and 10 10	argd1 goto scb_common	# vector 10
resinflt2:
	and 0 0		argp1
	and 20 20	argd0
	and 10 10	argd1 goto scb_common
# Reserved addressing mode (SCB 1C): a fault, the hardware has put the PC,
# the registers and the PSL back to the start of the instruction.
resadflt:
	and 0 0		argp1
	and 20 20	argd0
	and 1C 1C	argd1 goto scb_common
#
# Arithmetic trap (SCB 34): the instruction has stored its results and the
# PC is that of the next one. The type code, 1 integer overflow, 2 integer
# divide by zero or 7 subscript range, comes from internal register
# IPR_ARITH (74), which is cleared; it is pushed after the PSL and the PC.
arithtrap:
	and 74 74	crn
	plus civ 0	argp0		# the type code
	and 0 0		crw wipr	# taken
	and 20 20	argd0		# an exception
	and 34 34	argd1
	and 4 4		argp1 goto scb_common	# push the code: arith_1
arith_1:
	and E E		crn
	minus crv 4	cpuaddr
	plus argp0 0	crw wmem xpush	# -(SP) <- type code
	minus crv 4	crw wreg
	plus 0 0	eoi
#
# Trace fault (SCB 28): PSL<TP> was set at the start of an instruction. The
# hardware has cleared TP; the PC is that of the instruction, not started.
tracef:
	and 0 0		argp1
	and 20 20	argd0
	and 28 28	argd1 goto scb_common
#
# Memory management fault (SRM 4.9): access-control violation (SCB 20) or
# translation not valid (SCB 24). The hardware has already put the PC, the
# registers and the PSL back as they were at the start of the instruction
# (unless the instruction saved its progress with PSL<FPD>). The MMU keeps
# the virtual address and the fault parameter in internal registers 70/71.
# Frame: parameter, virtual address, PC, PSL.
#
mmflt:
	and 71 71	crn
	plus civ 0	ncond goto mmflt_tnv	# MMPAR<31>: translation not valid
	and 20 20	argd1 goto mmflt_2	# access-control violation
mmflt_tnv:
	and 24 24	argd1
mmflt_2:
	and 20 20	argd0		# an exception
	and 3 3		argp1 goto scb_common	# push the parameters, mmflt_1
mmflt_1:
	and 70 70	crn
	plus civ 0	arg1		# virtual address
	and 71 71	crn
	and civ 7	arg2		# fault parameter
	and E E		crn
	minus crv 4	cpuaddr
	plus arg1 0	crw wmem xpush	# -(SP) <- virtual address
	minus crv 8	cpuaddr
	plus arg2 0	crw wmem xpush	# -(SP) <- parameter
	minus crv 8	crw wreg
	plus 0 0	eoi
#
# Kernel stack not valid (SCB 08): a push on the kernel stack failed while
# an exception or interrupt was being initiated. The PSL is already the new
# one (kernel mode), arg1 still holds the PSL that was being saved and the PC
# has not changed yet. Start again on the interrupt stack (IPL 1F) with
# those two; any parameters of the original event are lost (SRM 5.6, Initiate
# Exception or Interrupt, note 5).
#
ksnv:
	and 8 8		argd1
	and 60 60	argd0		# severe: interrupt stack, IPL 1F
	and 0 0		argp1 goto scb_common2
#
# Initiate an exception or interrupt (SRM 5.6, "Initiate Exception or
# Interrupt"):
#	argd1	SCB offset
#	argd0	0-1F: interrupt, new IPL
#		20: exception (fault, trap, abort)
#		60: severe exception (KSNV): interrupt stack, IPL 1F
#	argp1	pushed after PSL and PC: 0 nothing, 1 machine check frame,
#		3 memory management parameters, 4 arithmetic trap code
#		(in argp0)
# The new PSL is loaded before the frame is pushed, so the pushes are made
# in kernel mode; they are flagged so that a fault on them becomes a
# kernel-stack-not-valid abort (or halts the CPU on the interrupt stack).
# Uses arg1 (saved PSL), arg2 (new PSL<31:16>), arg3 (vector), arg4.
#
scb_common:
	plus psl 0	arg1		# saved PSL
scb_common2:
	and 11 11	crn		# SCBB
	plus civ argd1	cpuaddr rmem phys	# fetch the vector
	plus rmemdat 0	arg3
	and arg3 2	nzcond goto scb_v2	# vector<1> set: halt
# new PSL<31:16> in arg2.  IS = old IS, or vector<0>, or severe.
	shr arg1 10	arg2
	and arg2 400	arg2
	and arg3 1	arg4
	shl arg4 A	arg4
	bis arg4 arg2	arg2
	and argd0 40	zcond goto scb_2
	bis 400 arg2	arg2
scb_2:
	and argd0 60	zcond goto scb_int
# exception: CUR = kernel, PRV = old CUR, IPL = 1F onto the interrupt stack
# by vector<0> (or severe), else unchanged
	shr arg1 12	arg4		# PSL<25:24> -> <7:6> of the upper word
	and arg4 C0	arg4
	bis arg4 arg2	arg2
	and argd0 40	nzcond goto scb_ipl1f
	and arg3 1	nzcond goto scb_ipl1f
	shr arg1 10	arg4
	and arg4 1F	arg4		# old IPL
	bis arg4 arg2	arg2 goto scb_sp
scb_ipl1f:
	bis 1F arg2	arg2 goto scb_sp
# interrupt: CUR = PRV = kernel, IPL = the new one
scb_int:
	and argd0 1F	arg4
	bis arg4 arg2	arg2
# unless on the interrupt stack: save SP, load the kernel or interrupt SP
scb_sp:
	shl psl 5	ncond goto scb_psl	# PSL<IS>
	and E E		crn
	plus crv 0	crw
	shr psl 18	arg4
	and arg4 3	crn wipr	# IPR[PSL<CUR>] <- SP
	and 0 0		crn		# KSP
	and arg2 400	zcond goto scb_ldsp
	and 4 4		crn		# ISP
scb_ldsp:
	plus civ 0	arg4
	and E E		crn
	plus arg4 0	crw wreg	# SP <- new stack pointer
scb_psl:
	shl arg2 10	psl		# the new PSL
	and E E		crn
	minus crv 4	cpuaddr
	plus arg1 0	crw wmem xpush	# -(SP) <- saved PSL
	minus crv 8	cpuaddr
	and F F		crn
	plus crv 0	crw wmem xpush	# -(SP) <- PC
	and E E		crn
	minus crv 8	crw wreg
	and F F		crn
	bic 3 arg3	crw wreg	# PC <- vector<31:2>
	minus argp1 1	zcond goto mcheck_1
	minus argp1 3	zcond goto mmflt_1
	minus argp1 4	zcond goto arith_1
	plus 0 0	eoi
# SCB vector with bits 1:0 = 2 (service in writable control store, which
# the 8600 has not got) or 3: the processor halts with code 8 or 7
scb_v2:	and arg3 1	nzcond goto scb_v3
	and 73 73	crn
	and 8 8		crw wipr
	plus 0 0	eoi
scb_v3:	and 73 73	crn
	and 7 7		crw wipr
	plus 0 0	eoi

#
mov:	plus arg1 0		argd0 savnz eoi
tst:	plus arg1 0		argd0 savnz eoi
add:	plus arg1 arg2		argd0 savnz savc savv eoi
clr:	plus 0 0		argd0 savnz eoi
xor:	xor arg1 arg2		argd0 savnz eoi
sub:	minus arg1 arg2		argd0 savc savv savnz eoi
# BICPSW, BISPSW: mask<15:8> must be zero, else reserved operand fault
bicpsw:	and arg1 FF00	nzcond goto psw_ro
	bic arg1 psl		psl eoi
bispsw:	and arg1 FF00	nzcond goto psw_ro
	bis arg1 psl		psl eoi
psw_ro:	plus 0 0	resopflt eoi
movpsl:	plus psl 0		argd0 savnz eoi
bic:	bic arg1 arg2		argd0 savnz eoi
bis:	bis arg1 arg2		argd0 savnz eoi
and:	and arg1 arg2		argd0 savnz eoi
zwl:	and arg1 FFFF		argd0 savnz eoi
zbl:	and arg1 FF		argd0 savnz eoi
#
# ADWC add.rl, sum.ml (arg1, arg2): sum <- sum + add + C. C is the carry
# out of either add (both cannot carry); V is set when add and sum have the
# same sign and the result has the other one (an overflow of the first add
# can be undone by the second).
adwc:	and psl 1	arg3		# old C
	plus arg1 arg2	argd0 savc	# add + sum
	and savpsw 1	arg4		# its carry
	plus arg3 argd0	argd0 savc savnz	# + C
	bis savpsw arg4	arg4
	and arg4 1	arg4		# C
	xor arg1 arg2	arg3
	plus arg3 0	ncond goto adwc_cc	# signs differ: no overflow
	xor argd0 arg1	nncond goto adwc_cc	# result of the same sign
	bis 2 arg4	arg4		# V
adwc_cc:
	bic 3 psl	psl
	bis psl arg4	psl eoi
# SBWC sub.rl, dif.ml (arg1, arg2): dif <- dif - sub - C. C is the borrow
# of either subtract; V is set when sub and dif have different signs and
# the result has not the sign of dif.
sbwc:	and psl 1	arg3		# old C
	minus arg2 arg1	argd0 savc	# dif - sub
	and savpsw 1	arg4		# its borrow
	minus argd0 arg3 argd0 savc savnz	# - C
	bis savpsw arg4	arg4
	and arg4 1	arg4		# C
	xor arg1 arg2	arg3
	plus arg3 0	nncond goto adwc_cc	# same signs: no overflow
	xor argd0 arg2	nncond goto adwc_cc	# result of the sign of dif
	bis 2 arg4	arg4 goto adwc_cc	# V

#
# mtpr arg1=val,arg2=ipr
#
# Register numbers above 7F do not exist (reserved operand). The memory
# management registers are checked (P0BR, P1BR in S0 and longword aligned,
# SBR, PCBB, SCBB aligned, a length above 2^21 reserved) and stored masked;
# mmu.v keeps its own copy of them by watching the IPR write.
mtpr:
	and savpsw 1000	nzcond goto priv_flt	# kernel mode only
	plus arg1 0	savnz			# NZ flags
	bic 2 psl	psl			# clear V
	minus 7F arg2	savc			# register number above 7F?
	and savpsw 1	nzcond goto mtpr_resop	# no such register
	and arg2 arg2	nzcond goto mtpr_1	# KSP?
	shr psl 1A	arg3			# IS set?
	and arg3 1	nzcond goto mtpr_ok	# if so, fine
# update KSP and SP
	plus 0 0	goto mtpr_3

mtpr_1:
	minus 3 arg2	nncond goto mtpr_ok	# SSP, ESP, USP
# check if ISP
	minus arg2 4	nzcond goto mtpr_2
	shr psl 1A	arg3
	and arg3 1	zcond goto mtpr_ok	# not on ISP, get out
mtpr_3:
	and C000 C000	arg3			# create wback encoding
	shl arg3 10	arg3
	plus arg3 E	argp0 wback
	and arg1 arg1	argd0 goto mtpr_ok
mtpr_2:
	minus arg2 8	zcond goto mtpr_p0br	# P0BR
	minus arg2 9	zcond goto mtpr_lr	# P0LR
	minus arg2 A	zcond goto mtpr_p1br	# P1BR
	minus arg2 B	zcond goto mtpr_lr	# P1LR
	minus arg2 C	zcond goto mtpr_pa	# SBR
	minus arg2 D	zcond goto mtpr_lr	# SLR
	minus arg2 10	zcond goto mtpr_pa	# PCBB
	minus arg2 11	zcond goto mtpr_pa	# SCBB
	minus arg2 13	zcond goto mtpr_ast	# ASTLVL
	minus arg2 15	zcond goto mtpr_sisr	# SISR

	minus arg2 18	zcond goto mtpr_ok	# ICCS
	minus arg2 19	zcond goto mtpr_ok	# NICR
	minus arg2 1B	zcond goto mtpr_ok	# TODR
	minus arg2 20	zcond goto mtpr_ok	# RXCS
	minus arg2 22	zcond goto mtpr_ok	# TXCS
	minus arg2 23	zcond goto mtpr_ok	# TXDB
	minus arg2 28	zcond goto mtpr_end	# ACCS: no accelerator, ignored
	minus arg2 3D	zcond goto mtpr_pme	# PME
	minus arg2 40	zcond goto mtpr_end	# 8600 PAMACC: ignored
	minus arg2 41	zcond goto mtpr_ok	# 8600 PAMLOC
	minus arg2 42	zcond goto mtpr_ok	# 8600 CSWP
	minus arg2 45	zcond goto mtpr_ok	# 8600 MDCTL
	minus arg2 47	zcond goto mtpr_end	# 8600 MERG: ignored
	minus arg2 48	zcond goto mtpr_end	# 8600 CRBT: ignored
	minus arg2 4A	zcond goto mtpr_ok	# 8600 EHSR

	minus arg2 38	zcond goto mtpr_mapen	# MAPEN
	minus arg2 39	zcond goto mtpr_ok	# TBIA
	minus arg2 3A	zcond goto mtpr_ok	# TBIS
	minus arg2 3F	zcond goto mtpr_tbchk	# TBCHK

	minus arg2 12	nzcond goto mtpr_12	# skip if not IPRIPL
	and 1F 1F	arg4
	and arg4 arg1	arg1
	shl arg4 10	arg4
	bic arg4 psl	psl
	shl arg1 10	arg3
	bis arg3 psl	psl goto mtpr_ok

mtpr_12:
	minus arg2 14	nzcond goto mtpr_resop	# SIRR
	and 15 15	crn			# fetch SISR
	and arg1 F	arg1			# only soft bits
	shl 1 arg1	arg1			# make mask
	bic 1 arg1	arg1			# level 0 does not exist
	bis civ arg1	crw wipr		# write back SISR
	plus 0 0	eoi

mtpr_resop:
	plus 0 0	resopflt eoi

# P0BR: must be an S0 address (bit 31 set, bit 30 clear), longword aligned
mtpr_p0br:
	plus arg1 0	arg3
mtpr_brtest:
	plus arg3 0	nncond goto mtpr_resop
	shl arg3 1	ncond goto mtpr_resop
	and arg3 3	nzcond goto mtpr_resop
	plus 0 0	goto mtpr_ok
# P1BR: the same test, on P1BR + 2**23 (the PTE address of P1 page 0 of a
# full-size P1 region is 2**23 below the base it would have)
mtpr_p1br:
	and 80 80	arg4
	shl arg4 10	arg4
	plus arg1 arg4	arg3 goto mtpr_brtest
# P0LR, P1LR, SLR: 22 bits are kept, a length above 2**21 is reserved
mtpr_lr:
	and 3F 3F	arg4
	shl arg4 10	arg4
	bis arg4 FFFF	arg4
	and arg1 arg4	arg1			# value<21:0>
	and 20 20	arg4
	shl arg4 10	arg4			# 2**21
	minus arg4 arg1	ncond goto mtpr_resop
	plus 0 0	goto mtpr_ok
# SBR, PCBB, SCBB: physical longword address
mtpr_pa:
	and arg1 3	nzcond goto mtpr_resop
	plus 0 0	goto mtpr_ok
# ASTLVL: 0-4
mtpr_ast:
	and arg1 7	arg1
	minus 4 arg1	ncond goto mtpr_resop
	plus 0 0	goto mtpr_ok
# MAPEN, PME: only bit 0
mtpr_mapen:
mtpr_pme:
	and arg1 1	arg1 goto mtpr_ok
# SISR: bits 15:1
mtpr_sisr:
	and arg1 FFFE	arg1 goto mtpr_ok
# TBCHK: V set if the TB holds a translation for the page
mtpr_tbchk:
	plus arg1 0	cpuaddr rmem probe phys
	and rmemdat 1	zcond goto mtpr_end
	bis 2 psl	psl
mtpr_end:
	plus 0 0	eoi

# OK to write to IPR
mtpr_ok:
	plus arg2 0	crn		# set IPR number
	plus arg1 0     crw wipr	# set IPR val and write
	plus 0 0	eoi

# mfpr arg1=ipr,arg2=dest
mfpr:
	and savpsw 1000	nzcond goto priv_flt	# kernel mode only
	minus 7F arg1	savc			# register number above 7F?
	and savpsw 1	nzcond goto mfpr_12	# no such register
	plus arg1 0	crn nzcond goto mfpr_0	# KSP?
	shl psl 5	ncond goto mfpr_ok	# On ISP just end
	and E E		crn
	plus crv 0	argd0 eoi savnz		# fetch current SP

mfpr_0:
	minus arg1 3E	nzcond goto mfpr_1	# SID
	and 0407 0407	arg2
	shl arg2 10	arg2
	plus arg2 4D2	argd0 eoi savnz
mfpr_1:
	minus arg1 1	zcond goto mfpr_ok	# SSP
	minus arg1 2	zcond goto mfpr_ok	# ESP
	minus arg1 3	zcond goto mfpr_ok	# USP
	minus arg1 4	zcond goto mfpr_isp	# ISP
	minus arg1 8	zcond goto mfpr_ok	# P0BR
	minus arg1 9	zcond goto mfpr_ok	# P0LR
	minus arg1 A	zcond goto mfpr_ok	# P1BR
	minus arg1 B	zcond goto mfpr_ok	# P1LR
	minus arg1 C	zcond goto mfpr_ok	# SBR
	minus arg1 D	zcond goto mfpr_ok	# SLR
	minus arg1 10	zcond goto mfpr_ok	# PCBB
	minus arg1 11	zcond goto mfpr_ok	# SCBB
	minus arg1 13	zcond goto mfpr_ok	# ASTLVL
	minus arg1 15	zcond goto mfpr_ok	# SISR
	minus arg1 18	zcond goto mfpr_ok	# ICCS
	minus arg1 19	zcond goto mfpr_ok	# NICR
	minus arg1 1A	zcond goto mfpr_ok	# ICR
	minus arg1 1B	zcond goto mfpr_ok	# TODR
	minus arg1 20	zcond goto mfpr_ok	# RXCS
	minus arg1 21	zcond goto mfpr_ok	# RXDB
	minus arg1 22	zcond goto mfpr_ok	# TXCS
	minus arg1 28	zcond goto mfpr_ok	# ACCS (zero)
	minus arg1 38	zcond goto mfpr_ok	# MAPEN
	minus arg1 3D	zcond goto mfpr_ok	# PME
	minus arg1 40	zcond goto mfpr_ok	# 8600 PAMACC
	minus arg1 41	zcond goto mfpr_ok	# 8600 PAMLOC
	minus arg1 42	zcond goto mfpr_ok	# 8600 CSWP
	minus arg1 45	zcond goto mfpr_ok	# 8600 MDCTL
	minus arg1 47	zcond goto mfpr_ok	# 8600 MERG (zero)
	minus arg1 4A	zcond goto mfpr_ok	# 8600 EHSR

	minus arg1 12	nzcond goto mfpr_12	# IPL

	shr psl 10	argd0
	and argd0 1F	argd0 savnz eoi

# ISP: the SP register while on the interrupt stack
mfpr_isp:
	shl psl 5	nncond goto mfpr_ok
	and E E		crn
	plus crv 0	argd0 eoi savnz

mfpr_12:
	plus 0 0	resopflt eoi

mfpr_ok:
	plus civ 0	argd0 eoi savnz

#
# Move quad word. First long is already read, extract addr for the
# second, read val, update flags, write to output regs.
# input addr in argp0 (must later be updated), output in argp1
#
# XXX - need mov, shifted reg bits, split savn/savz
#
movq:
	plus arg1 0	argd0
	plus arg2 0	argd1
# Fix correct status bits
	shr argd0 1	arg1		# shift in 0 as sign bit
	and argd0 1	arg2		# get just lost low bit
	bis arg1 arg2	arg1		# or it to check result
	bis argd1 arg1	savnz eoi	# set NZ bits by adding high and low

#
# Clear quad word.  extract addr and set both output correct.
#
clrq:	plus 0 0	argd0 savnz		# clear both
	plus 0 0 	argd1 eoi

#
# Check if a given bit in psl is set
bset:	plus arg1 0	argd0			# move new pc to dest
	and arg2 psl	nzcond wback eoi	# if result Z writeback
# Check if given bit(s) in psl are clear
bclr:	plus arg1 0	argd0			# move new pc to dest
	and arg2 psl	zcond wback eoi		# if result Z writeback
#
# ROTL: arg1 == shift count, arg2 = val
rot:	
	and arg1 1F	arg1
	shl arg2 arg1	argd0
	minus 20 arg1	arg1
	shr arg2 arg1 	argd1
	bis argd1 argd0	argd0 savnz eoi
#
# ACBx limit, add, index, displ: index <- index + add, then branch if add >= 0
# and index <= limit, or add < 0 and index >= limit (signed compares). N, Z
# and V come from the add at the operand's size (setnz setv), C is left
# alone. The compares use the new index sign-extended to 32 bits and look at
# the signs first, so that the subtraction cannot overflow.
acbb:	plus arg2 arg3		argd0 savv savnz use8	# index + add, as bytes
	shl argd0 18		arg3
	asr arg3 18		arg3 goto acb_c		# new index, sign-extended
acbw:	plus arg2 arg3		argd0 savv savnz use16	# as words
	shl argd0 10		arg3
	asr arg3 10		arg3 goto acb_c
acb:	plus arg2 arg3		argd0 savv savnz	# ACBL
	plus argd0 0		arg3
acb_c:	plus arg4 0		argd1			# branch destination
	plus arg2 0		ncond goto acb_neg	# add < 0
# add >= 0: branch if index <= limit
	xor arg1 arg3		arg2
	plus arg2 0		ncond goto acb_pd	# signs differ
	minus arg1 arg3		nncond wback2 eoi	# limit - index >= 0
acb_pd:	plus arg1 0		nncond wback2 eoi	# limit >= 0 > index
# add < 0: branch if index >= limit
acb_neg:
	xor arg1 arg3		arg2
	plus arg2 0		ncond goto acb_nd	# signs differ
	minus arg3 arg1		nncond wback2 eoi	# index - limit >= 0
acb_nd:	plus arg3 0		nncond wback2 eoi	# index >= 0 > limit
#
# AOBLSS, AOBLEQ limit.rl, index.ml, displ.bb (arg1, arg2, arg3): index + 1,
# N Z V from the add (setv), C unchanged; branch if index < limit (AOBLSS) or
# index <= limit (AOBLEQ), signed: with different signs the negative one is
# the smaller, else the subtraction cannot overflow.
aobleq:	plus 1 arg2		argd0 savv savnz	# index + 1
	plus arg3 0		argd1			# branch destination
	xor argd0 arg1		ncond goto aob_d	# signs differ
	minus arg1 argd0 	nncond wback2 eoi	# limit - index >= 0
#
aoblss:	plus 1 arg2		argd0 savv savnz	# index + 1
	plus arg3 0		argd1			# branch destination
	xor argd0 arg1		ncond goto aob_d	# signs differ
	minus argd0 arg1 	ncond wback2 eoi	# index - limit < 0
aob_d:	plus argd0 0		ncond wback2 eoi	# index < 0 <= limit
#
# SOBGEQ, SOBGTR index.ml, displ.bb: index - 1; branch if >= 0 or > 0
sobgeq:	plus arg2 0	argd1				# save branch addr
	minus arg1 1	argd0 savv savnz nncond wback2 eoi	# dec index
#
sobgtr:	plus arg2 0	argd1				# save branch addr
	minus arg1 1	argd0 savv savnz ncond goto sob_end	# negative
	plus argd0 0	nzcond wback2 eoi		# > 0: not zero
sob_end: plus 0 0	eoi
#
# arg1=pos, arg2=base, arg3=displ
# BLBS, BLBC src.rl, displ: the low bit of a longword (pos 0)
bbc:	shr arg2 arg1	argd0
	plus arg3 0	argd1
	and argd0 1	zcond wback2 eoi
bbs:	shr arg2 arg1	argd0
	plus arg3 0	argd1
	and argd0 1	nzcond wback2 eoi
#
# BBS, BBC pos.rl, base.vb, displ.bb (arg1, argp0, arg2): the bit pos of the
# field at base. The base comes as a "wb" operand, so argp0 is its address,
# or a register (savpsw<4>), whose bit pos must be 0-31 (else a reserved
# operand fault). In memory the bit is in the byte at base +
# pos/8 (pos signed), bit pos<2:0>: only that byte is read.
#
bbsv:	and 1 1		argd0 goto bbv		# branch if set
bbcv:	and 0 0		argd0			# branch if clear
bbv:	and savpsw 10	zcond goto bbv_mem	# argp0 is not a register
	bic 1F arg1	arg3
	plus arg3 0	nzcond goto bbv_ro	# register: pos must be 0-31
	plus argp0 0	crn
	shr crv arg1	arg3
	plus 0 0	goto bbv_tst
bbv_mem:
	asr arg1 3	arg3
	plus argp0 arg3	cpuaddr rmem byte	# the byte with the bit
	and arg1 7	arg1
	shr rmemdat arg1	arg3
bbv_tst:
	plus arg2 0	argd1			# the branch target
	xor arg3 argd0	arg3
	and arg3 1	zcond wback2 eoi	# the bit is the one wanted: branch
bbv_ro:	plus 0 0	resopflt eoi
#
# BBSS, BBCS, BBSC, BBCC, BBSSI, BBCCI pos.rl, base.vb, displ.bb: branch on
# the old bit, which is set or cleared (the interlocked ones are the same
# here: one processor). argd0<0> branch if set, argd0<1> set the bit.
# In memory the byte is read with write intent, then written back.
#
bbss:	and 3 3		argd0 goto bbm
bbcs:	and 2 2		argd0 goto bbm
bbsc:	and 1 1		argd0 goto bbm
bbcc:	and 0 0		argd0
bbm:	and savpsw 10	zcond goto bbm_mem	# argp0 is not a register
	bic 1F arg1	arg3
	plus arg3 0	nzcond goto bbv_ro	# register: pos must be 0-31
	shl 1 arg1	arg3			# the bit's mask
	plus argp0 0	crn
	plus crv 0	arg4			# the old value
	and argd0 2	zcond goto bbm_rc
	bis arg3 arg4	crw wreg		# set
	plus 0 0	goto bbm_br
bbm_rc:	bic arg3 arg4	crw wreg		# clear
	plus 0 0	goto bbm_br
bbm_mem:
	asr arg1 3	arg3
	plus argp0 arg3	argd1			# the byte with the bit
	plus argd1 0	cpuaddr rmem byte wint
	and arg1 7	arg1
	shl 1 arg1	arg3			# the bit's mask
	plus rmemdat 0	arg4			# the old byte
	plus argd1 0	cpuaddr byte
	and argd0 2	zcond goto bbm_mc
	bis arg3 arg4	crw wmem		# set
	plus 0 0	goto bbm_br
bbm_mc:	bic arg3 arg4	crw wmem		# clear
bbm_br:	plus arg2 0	argd1			# the branch target
	and arg3 arg4	arg3			# the old bit
	and argd0 1	nzcond goto bbm_bs
	and arg3 arg3	zcond wback2 eoi	# branch if it was clear
bbm_bs:	and arg3 arg3	nzcond wback2 eoi	# branch if it was set
#
# INSV src.rl, pos.rl, size.rb, base.vb (arg4, arg1, arg2, argp0): size 0
# does nothing, a size above 32 is a reserved
# operand; in registers a position above 31 (unsigned) is a reserved operand
# and a field that would go on from R14 or PC a reserved addressing mode; in
# memory the second longword is read (and written) only if the field
# reaches it. argd0, argd1 the two longwords, argp0, argp1 where they go.
#
insv:	and arg2 FF	arg2			# the size, unsigned
	plus arg2 0	zcond goto insv_z	# 0: nothing at all
	minus 20 arg2	ncond goto insv_ro	# above 32
	and savpsw 10	zcond goto insv_mem	# argp0 is not a register
	bic 1F arg1	arg3
	plus arg3 0	nzcond goto insv_ro	# a position above 31
	plus arg1 arg2	arg3
	minus 20 arg3	nncond goto insv_r1	# within the register
	and argp0 F	arg3
	minus arg3 E	ncond goto insv_r1	# the next register exists
	and 75 75	crn
	and 0 0		crw wipr		# R14 or PC: reserved addressing
insv_ro: plus 0 0	resopflt eoi
insv_z:	plus 0 0	eoi
insv_r1:
	plus argp0 0	crn		# 59 set cur reg num
	plus crv 0	argd0		# 60 move val to dest
	plus argp0 0	argp0		# Set to longword
	plus argp0 1	argp1		# if two regs
	plus argp0 1	crn		# if two regs
	plus crv 0	argd1 goto insv_common 		# 60 move val to dest
insv_mem:
# Normalize first
	asr arg1 3	arg3		# get byte offset
	plus argp0 arg3	argd0		# argp0 == byte offset
	and argd0 3	arg3		# arg3 == byte offset in longword
	and arg1 7	arg1		# arg1 == bit offset
	shl arg3 3	arg3		# make bit offset
	plus arg3 arg1	arg1		# pos == bit offset in longword
	bic 3 argd0	argp0		# clear byte offset bits in ptr
	plus argp0 0	cpuaddr rmem	# fetch low long
	plus rmemdat 0	argd0		# dat now in argd0
	plus argp0 4	argp1		# the next longword
	and 0 0		argd1
	plus arg1 arg2	arg3
	minus 20 arg3	nncond goto insv_common	# the field ends in the first
	plus argp1 0	cpuaddr rmem	# fetch high long
	plus rmemdat 0	argd1		# dat now in argd1


insv_common:

# Any writeback?
	plus arg2 arg2	nzcond wback	# write back low word if sz != 0
	plus arg2 arg1	arg3		# size + pos
	minus 20 arg3	ncond wback2	# if > 32 write back high word
#
# Lower longword
#
	minus arg2 20	nzcond goto insv_not20
#	and arg3 arg3	nzcond goto insv_not20
	bic arg3 arg3	arg3
	minus arg3 1	arg3 goto insv_sz
#	and arg3 arg3	goto insv_sz
insv_not20:
	shl 1 arg2	arg3		# 61 shift left size bits
	minus arg3 1	arg3		# 62 create mask (in arg3)
insv_sz:
	and arg3 arg4	arg4		# 63 clear unwanted bits in src
	shl arg3 arg1	arg3		# 64 shift left pos bits in mask
	bic arg3 argd0	argd0		# 65 clear unwanted bits in dest
	shl arg4 arg1	arg3		# 66 put shifted src in arg3
	bis arg3 argd0	argd0		# 67 written in dest
#
# Upper long
#
	shl 1 arg2	arg3		# 61 shift left size bits
	minus arg3 1	arg3		# 62 create mask (in arg3)
	minus 20 arg1	arg1		# pos = 32-pos (leftover in lowword)
	shr arg4 arg1	arg4		# shrink src
	shr arg3 arg1	arg3		# shrink mask
	bic arg3 argd1	argd1		# clear unwanted bits from d1
	bis arg4 argd1	argd1 eoi	# set wanted bits in d1

#
# extract bitfield based on (pos,size,base) in (arg1,arg2,argp0)
# return field in argd0, return addr in argp1. Trashes arg1+arg3.
#
# A size above 32 is a reserved operand, size 0 gives 0;
# in registers a position above 31 (unsigned) is a reserved operand and a
# field that would go on from R14 or PC a reserved addressing mode; in
# memory the second longword is read only if the field reaches it.
bfield:
	and 0 0 	argd0			# 177
	and arg2 FF	arg2			# the size, unsigned
	minus arg2 21	arg3			# 178
	and arg3 arg3	nncond goto bf_ro	# above 32
	and arg2 arg2	zcond goto bf_done	# 180
# Check whether read from mem or reg?
	and savpsw 10	zcond goto bf_mem	# argp0 is not a register
	bic 1F arg1	arg3
	plus arg3 0	nzcond goto bf_ro	# a position above 31
	plus arg1 arg2	arg3
	minus 20 arg3	nncond goto bf_r1	# within the register
	and argp0 F	arg3
	minus arg3 E	ncond goto bf_r1	# the next register exists
	and 75 75	crn
	and 0 0		crw wipr		# R14 or PC: reserved addressing
bf_ro:	plus 0 0	resopflt eoi
bf_r1:	plus argp0 0	crn		# 59 set cur reg num
	plus crv 0	argd0		# 60 move val to dest
	plus argp0 1	crn		# if two regs
	plus crv 0	arg3 goto bf_common	# 60 move val to dest
bf_mem:
# Normalize first
	asr arg1 3	arg3		# 189 get byte offset
	plus argp0 arg3 argd0		# 190 argp0 == byte offset
	and argd0 3	arg3		# 191 arg3 == byte offset in longword
	and arg1 7	arg1		# 192 arg1 == bit offset
	shl arg3 3	arg3		# 193 make bit offset
	plus arg3 arg1	arg1		# 194 pos == bit offset in longword
	bic 3 argd0	argp0		# 195 clear byte offset bits in ptr
	plus argp0 0	cpuaddr rmem	# 196 fetch low long
	plus rmemdat 0	argd0		# 197 dat now in argd0
	plus arg1 arg2	arg3
	minus 20 arg3	nncond goto bf_m1	# the field ends in the first
	plus argp0 4	cpuaddr rmem	# 198 next long
	plus rmemdat 0	arg3 goto bf_common
bf_m1:	and 0 0		arg3
bf_common:
# create long in argd0
	shr argd0 arg1	argd0		# 200 right-adjust low bits
	minus 20 arg1	arg1		# 201
	shl arg3 arg1	arg3		# 202
	bis arg3 argd0	argd0		# 203

bf_done:
	plus argp1 0	arg3		# 204

	and arg3 arg3	zcond goto extzv_1 # 205 value 0
	minus arg3 1	arg3 zcond goto extv_1		# 206
	minus arg3 1	arg3 zcond goto cmpv_1		# 208
	minus arg3 1	arg3		# 208
	and arg3 arg3	zcond goto cmpzv_1	# 209 value 3
	minus arg3 1	arg3 zcond goto ffc_1	# val 4
	plus 0 0	resopflt eoi	# 210

# EXTZV	rl,rb,wb,wl (arg1,arg2,argp0,argp1)
extzv:	plus argp1 0	argd1		# 207 save ptr
	plus 0 0	argp1		# 208 clear ret
	plus 0 0	goto bfield	# 209
extzv_1:	
	minus arg2 20	arg3		# 210
	and arg3 arg3	nncond goto extzv_is20	# 218 full word, no need to mask
	shl 1 arg2	arg3		# 211
	minus arg3 1	arg3		# 220
	and arg3 argd0	argd0		# 221
extzv_is20:
	and argd0 argd0	savnz		# 222
	plus argd1 0	argp0 eoi	# 223 result in wb0
	

# EXTV	rl,rb,wb,wl (arg1,arg2,argp0,argp1)
extv:	plus argp1 0	argd1
	and 1 1 	argp1
	plus 0 0	goto bfield
extv_1:	
	minus arg2 20	arg3		# 224
	and arg3 arg3	nncond goto extv_is20	# 225 full word, no need to mask
	minus 20 arg2	arg2		# 226 shift left bits
	shl argd0 arg2	argd0		# 227 
	asr argd0 arg2	argd0 		# 228 sign extend
extv_is20:
	and argd0 argd0	savnz		# 229 
	plus argd1 0	argp0 eoi	# 230 result in wb0
	
# CMPV rl,rb,wb,rl (arg1,arg2,argp0,arg3)
cmpv:	plus arg3 0	argd1			# 231 save cmpval
	and 2 2		argp1			# 232
	plus 0 0	goto bfield		# 233
cmpv_1:
	minus arg2 20	arg3			# 234
	and arg3 arg3	nncond goto cmpv_is20	# 235 full word, no need to mask
	minus 20 arg2	arg2			# 236 shift left bits
	shl argd0 arg2	argd0			# 237
	asr argd0 arg2	argd0			# 238 sign extend
cmpv_is20:
	minus argd0 argd1 argd0 savnz savc savv eoi	# 239

# CMPZV rl,rb,wb,rl (arg1,arg2,argp0,arg3)
cmpzv:	plus arg3 0	argd1			# 242 save cmpval
	and 3 3		argp1			# 243
	plus 0 0	goto bfield		# 244
cmpzv_1:
	minus arg2 20	arg3			# 245
	and arg3 arg3	nncond goto cmpzv_is20	# 246 full word, no need to mask
	shl 1 arg2	arg3			# 247
	minus arg3 1	arg3			# 248 shift left bits
	and arg3 argd0 	argd0			# 249 sign extend
cmpzv_is20:
	minus argd0 argd1 argd0 savnz savc savv eoi	# 250
#
# CASEB selector,base,limit
# tmp = selector - base
# if (tmp <= limit) PC += SEXT(displ[tmp]) else PC += 2 + 2 * ZEXT(limit)
#
# CASEB, CASEW, CASEL (operands sign extended): tmp = selector - base at the
# operand size; the condition codes are those of CMPx tmp, limit; tmp is in
# range if it is not above the limit as an unsigned number: then PC = table
# + the displacement at table + 2 * tmp, else PC = table + 2 * (limit + 1).
#
caseb:	minus arg1 arg2		argd1			# selector - base ...
	shl argd1 18		argd1
	asr argd1 18		argd1			# ... as a byte
	minus argd1 arg3	savnz savc		# CMPB tmp, limit
	and argd1 FF		argd1			# unsigned for the range
	and arg3 FF		arg3 goto case_rng
casew:	minus arg1 arg2		argd1
	shl argd1 10		argd1
	asr argd1 10		argd1			# as a word
	minus argd1 arg3	savnz savc		# CMPW tmp, limit
	and argd1 FFFF		argd1
	and arg3 FFFF		arg3 goto case_rng
casel:	minus arg1 arg2		argd1
	minus argd1 arg3	savc			# CMPL tmp, limit: C
	xor argd1 arg3		argp1
	plus argp1 0		ncond goto casel_d
	minus argd1 arg3	savnz goto case_rng	# same signs: N, Z
casel_d:
	bis argd1 1		argp1 savnz		# signs differ: N = tmp<31>, Z = 0
# tmp <= limit, unsigned: if the top bits differ, tmp must be the one with
# bit 31 clear; else limit - tmp must not be negative
case_rng:
	xor argd1 arg3		argp1
	plus argp1 0		ncond goto case_tb
	minus arg3 argd1	nncond goto case_off
	plus 0 0		goto case_ex
case_tb:
	plus argd1 0		nncond goto case_off
	plus 0 0		goto case_ex
case_off:
	shl argd1 1		argd1			# word offset
	plus argd1 arg4		cpuaddr rmem word	# the displacement
	shl rmemdat 10		arg3			# sign extend...
	asr arg3 10		arg3
	plus arg3 arg4		argd0 eoi		# jmp new address
case_ex:
	shl arg3 1		arg3			# word offset
	plus arg3 2 		arg3			# one word after
	plus arg3 arg4		argd0 eoi		# set pc
#
mul:	mul arg1 arg2		argd0 savnz savv eoi
#
# Handle division check here
# HW division is unsigned, so we convert to unsigned here.
#
div:	
	bic 2 psl	psl			# clear V
	plus arg1 0	nzcond goto div_nz	# skip if no division by 0
# divide by zero: the quotient is the dividend, V, and an integer divide by
# zero trap (SRM: arithmetic trap type 2)
	bis 2 psl	psl
	and 74 74	crn
	and 2 2		crw wipr
	plus arg2 0	argd0 savnz eoi
div_nz:
	# check if -MAXSHORT/-1
	plus arg1 1	nzcond goto div_done	# jump if not -1
	plus arg2 0	zcond goto div_done	# jump if 0
	plus arg2 arg2	nzcond goto div_done	# jump if not -MAXINT
	bis 2 psl	psl
div_done:
	and arg1 arg1	arg3 nncond goto div_1f	# skip if divr positive
	minus 0 arg1	arg3			# otherwise convert
div_1f:	and arg2 arg2	arg4 nncond goto div_2f	# 299 same again for divd
	minus 0 arg2	arg4
div_2f:
	div arg3 arg4	argd0			# 301
	xor arg1 arg2	nncond goto div_3f	# source sign same = no conv
	minus 0 argd0	argd0			# change sign
div_3f:	and argd0 argd0 savnz eoi		# set flags
#
#
# ASHL cnt.rb, src.rl, dst.wl (arg1, arg2): cnt >= 0 shifts left, V when
# bits are lost (the result shifted back is not src; 32 or more gives 0, V
# unless src is 0); cnt < 0 shifts right with the sign (31 or more as 31).
ashl:	bic 2 psl	psl			# clear V
	plus arg1 0	nncond goto ashl_left	# negative shifts right
	minus 0 arg1	arg1			# make positive
	minus arg1 1F	ncond goto ashl_1f	# less than 31?
	and 1F 1F	arg1			# set to 31
ashl_1f:
	asr arg2 arg1	argd0 savnz eoi		# right shift
ashl_left:
	minus arg1 20	nncond goto ashl_big	# 32 or more
	shl arg2 arg1	argd0 savnz
	asr argd0 arg1	arg3			# shifted back
	xor arg3 arg2	nzcond goto ashl_v	# bits lost
	plus 0 0	eoi
ashl_v:	bis psl 2	psl eoi
ashl_big:
	plus 0 0	argd0 savnz		# 0
	plus arg2 0	nzcond goto ashl_v
	plus 0 0	eoi
#
# ASHQ  arg1,argp0,argp1
# Read in value in arg3/arg4 first, shift it, then 
ashq:
	plus arg2 0	argd0
	plus arg3 0	argd1

# do shifts
	bic 2 psl	psl			# 339 clear V
	plus argd1 0	arg4			# 340 remember high word
	plus arg1 0	nncond goto ashq_left	# 341
	minus 0 arg1	arg1			# 342 make right shift positive
	minus arg1 3F	ncond goto ashq_3f	# 343
	and 3F 3F	arg1			# 344 set to 63
ashq_3f:
	and arg1 arg1	zcond goto ashq_ret
	shr argd0 1	argd0
	and argd1 1	zcond goto ashq_5f	# jump if no need to or
	and 8000 8000	arg3
	shl arg3 10	arg3
	bis argd0 arg3	argd0
ashq_5f:
	asr argd1 1	argd1
	minus arg1 1	arg1 goto ashq_3f

# set flags before return
ashq_ret:
	shr argd0 1	arg1
	and argd0 1	arg2
	bis arg1 arg2	arg1
	bis argd1 arg1	savnz eoi
		

ashq_left:
	and arg1 arg1	zcond goto ashq_lend	# shifted
	xor arg4 argd1	nncond goto ashq_skip
	bis psl 2	psl
ashq_skip:
	shl argd1 1	argd1			# shift high word
	plus argd0 0	nncond goto ashq_4f	# low word high bit set?
	bis argd1 1	argd1			# if so, set high word LSB
ashq_4f:
	shl argd0 1	argd0			# shift left low word
	minus arg1 1	arg1 goto ashq_left
# V if the sign changed at any step, the last one included
ashq_lend:
	xor arg4 argd1	nncond goto ashq_ret
	bis psl 2	psl goto ashq_ret
#
cvtlw:	bic 2 psl	psl
	plus arg1 0	argd0
	shl arg1 10	arg1
	asr arg1 10	arg1 savnz
	minus argd0 arg1 zcond goto cvtlw_1f
	bis psl 2	psl
cvtlw_1f:
	plus 0 0	eoi
# CVTLB, CVTWB: V if the value does not fit in a byte
cvtlb:	bic 2 psl	psl
	plus arg1 0	argd0
	shl arg1 18	arg1
	asr arg1 18	arg1 savnz
	minus argd0 arg1 zcond goto cvtlw_1f
	bis psl 2	psl goto cvtlw_1f
#
# EDIV divr,divd,quo,rem (arg1,arg2/3,argp0,argp1)
# Algorithm here comes from a NOVA programming book.
# rem == divdu == arg3 == argd1
# quo == divdl == arg2 == argd0
#
ediv:
	bic 3 psl	psl		# 326 clear C+V
	plus arg1 0	nzcond goto ediv_0
# divide by zero: trap type 2; the overflow path below gives quotient = low
# dividend, remainder 0 and V, as for an overflow
	and 74 74	crn
	and 2 2		crw wipr
ediv_0:
	plus 0 0	arg4		# 327 clear a4
	and arg2 arg2	argd0		# 328 set d0 (future quotient)
#
# check if we need to flip signs
# arg4 bit 0 is quot, bit 1 is rem sign.
#
	and arg3 arg3	argd1 nncond goto ediv_f1 # 329 set d1 (rem)
	and 3 3		arg4		# save divd sign bit
	minus 0 arg2	argd0
	minus 0 arg3	argd1
	minus argd0 1	ncond goto ediv_f1 # check if carry
	minus argd1 1	argd1
ediv_f1:
# check divr negative
	and arg1 arg1	nncond goto ediv_f2 # 335
	minus 0 arg1	arg1
	xor arg4 1	arg4		# low bit whether to flip quot sign
ediv_f2:
#
# Check for overflow (special handling)
#
	minus argd1 arg1 nncond goto ediv_ovf # 338 divdh > rem then ovf
	shl argd1 1	arg2	# 339 ...must also check the sign bit in divdl..
	and argd0 argd0 nncond goto ediv_f3	# 340 
	plus arg2 1	arg2			# 341
ediv_f3:
	minus arg2 arg1 ncond goto ediv_cmn	# 342

# Overflow handling
ediv_ovf:
	and arg4 2	zcond goto ediv_f4	# 343 swap sign on quot?
	minus 0 argd0	argd0			# 344 yes
ediv_f4:
	plus 0 0	argd1			# 345 clear rem
	bis 2 psl	psl goto ediv_end	# 346 set V and getout

#
# The division itself.
# divr in arg1, divd in argd0/argd1
# arg2 is used for temporary carry
#
ediv_cmn:
	and 20 20	arg3	# 347 loop count
	shr argd0 1F	arg2	# get sign bit (as carry)
	bis psl arg2	psl	# store carry in psl
	shl argd0 1	argd0	# shift quot left

ediv_loop:
	# MOVL argd1,argd1
	plus 0 0	arg2	# clear tcy
	and argd1 argd1 nncond goto ediv_f5 # sign bit set in dvdh?
	and 1 1		arg2	# set tcy
ediv_f5:
	shl argd1 1	argd1
	and psl 1 	zcond goto ediv_f6
	bis 1 argd1	argd1
ediv_f6:
	bic 1 psl	psl
	bis arg2 psl	psl
	# END MOVL

	# SUBH arg1,argd1,SZC
	plus 0 0	arg2
	minus argd1 arg1 ncond goto ediv_f7
	and 1 1		arg2
ediv_f7:
	xor psl arg2	arg2
	and arg2 1	zcond goto ediv_f11
	# END SUBH arg1,argd1,SZC

	# SUB arg1,argd1
	plus 0 0	arg2
	minus argd1 arg1 argd1 ncond goto ediv_f8
	and 1 1		arg2
ediv_f8:
	xor psl arg2	psl
	# END SUB arg1,argd1

ediv_f11:
	# MOVL argd0,argd0
	plus 0 0	arg2
	and argd0 argd0	nncond goto ediv_f15
	and 1 1		arg2
ediv_f15:
	shl argd0 1	argd0
	and psl 1	zcond goto ediv_f16
	bis argd0 1	argd0
ediv_f16:
	bic 1 psl	psl
	bis psl arg2	psl
	# END MOVL

	minus arg3 1	arg3 nzcond goto ediv_loop

	and arg4 1	zcond goto ediv_end
	minus 0 argd0	argd0
ediv_end:
	and arg4 2	zcond goto ediv_f18
	minus 0 argd1	argd1
ediv_f18:
	and argd0 argd0	savnz eoi
#
# EMUL f1,f2,add,wq (arg1, arg2, arg3, argp0/p1)
emul:
	mul arg1 arg2	argd0		# 382 do mult
	plus ures 0	argd1		# 383 fetch upper
	plus argd0 arg3	argd0		# 384 addend
	# sign extension...
	asr arg3 31	arg4		# 385
	plus argd1 arg4	argd1		# 386
	# ...if sum is less than either
	minus argd0 arg3 savc		# 387
	and savpsw 1	zcond goto emul_3f # 388
	plus 1 argd1	argd1		# 389
emul_3f:
	bic F psl	psl		# 390 clear all bits
	and argd1 argd1	nncond goto emul_1f	# negative?
	bis 8 psl	psl		# yes, set N flag
emul_1f:
	bis argd0 argd1	nzcond goto emul_2f	# zero?
	bis 4 psl	psl		# yes, set Z flag
emul_2f:
	plus 0 0 	eoi
#
mcom:
	minus 0 arg2	arg2
	xor arg2 arg1	argd0 savnz eoi
#
# REI pc=arg1, psl=arg2 (SRM 5.7)
rei:
# the popped PSL must be consistent and no more privileged than the current
# one, else reserved operand fault (the hardware undoes the pops):
	shr arg2 10	arg3			# new PSL<31:16>
	and arg2 FF00	nzcond goto rei_bad	# MBZ <15:8>
	and arg3 B020	nzcond goto rei_bad	# CM (not implemented), MBZ <29:28>, <21>
	and arg3 1F	argd1			# new IPL
	shr arg3 8	arg4
	and arg4 3	arg4			# new CUR_MOD
	and arg3 400	zcond goto rei_c2
	and argd1 argd1	zcond goto rei_bad	# IS with IPL 0
rei_c2:
	and argd1 argd1	zcond goto rei_c3
	and arg4 arg4	nzcond goto rei_bad	# IPL > 0 outside kernel mode
rei_c3:
	shr arg3 6	argd0
	and argd0 3	argd0			# new PRV_MOD
	minus argd0 arg4	ncond goto rei_bad	# PRV_MOD < CUR_MOD
	shr psl 18	argd0
	and argd0 3	argd0			# current CUR_MOD
	minus arg4 argd0	ncond goto rei_bad	# to a more privileged mode
	and arg3 400	zcond goto rei_c7
	shl psl 5	nncond goto rei_bad	# onto the interrupt stack
rei_c7:
	shr psl 10	argd0
	and argd0 1F	argd0
	minus argd0 argd1	ncond goto rei_bad	# to a higher IPL

	# save old SP
	and E E		crn
	plus crv 0	crw
	shr psl 18	arg3
	and arg3 7	crn wipr		# IPR[IS'CUR_MOD] <- SP

	# Write PC+PSL. PSL<TP> stays set if it is (TP <- TP OR saved TP):
	# REI itself may be traced.
	shr psl 10	arg3
	and arg3 4000	arg3
	shl arg3 10	arg3
	bis arg3 arg2	psl
	plus arg1 0	argd0

	# stack change, and AST delivery check
	shl psl 5	ncond goto rei_2 # can only change stack if !IS
	and arg4 3	crn
	plus civ 0	crw
	and E E		crn wreg		# SP <- IPR[CUR_MOD]
	and 13 13	crn
	plus civ 0	argd1			# ASTLVL
	minus arg4 argd1	ncond goto rei_2	# CUR_MOD < ASTLVL: no AST
	and 15 15	crn
	bis civ 4	crw wipr		# request the IPL 2 interrupt
rei_2:
	plus 0 0	eoi
rei_bad:
	plus 0 0	resopflt eoi
#
# MOVC3 len.rw, srcaddr.ab, dstaddr.ab               (arg1, arg2, arg3)
# MOVC5 srclen.rw, srcaddr.ab, fill.rb, dstlen.rw, dstaddr.ab
#                                          (arg1, arg2, argd0, arg3, arg4)
# One engine for both: MOVC3 is MOVC5 with dstlen = srclen and no fill.
#
# Registers while the move runs:
#	arg1 srclen left (S), arg2 source (A1), arg3 dstlen left (D),
#	arg4 destination (A2), argp0 fill, argp1 direction (1 = backward),
#	argd0 MIN(srclen, dstlen) and argd1 dstlen (backward only).
# A memory management fault or an interrupt in the middle saves them in
# R0-R5 and sets PSL<FPD> (SRM 5.3: the general registers then hold an
# implementation-specific state); the PC stays at the opcode. When the
# instruction is fetched again with PSL<FPD> set, the CPU skips the operand
# decode and starts at the step after the entry, movcN_fpd:
#	R0 = dstlen<31:16>'srclen<15:0>    R1 = source
#	R2 = direction<8>'fill<7:0>        R3 = destination
#	R4 = dstlen<31:16>'min<15:0>       R5 = PC of the next instruction
# Every loop does its memory references before it updates the counters, so
# a resumed loop redoes exactly the iteration that faulted.
#
movc3:
	plus 0 0	goto movc3_0
movc3_fpd:
	plus 0 0	goto movc_resume
movc3_0:
	plus arg3 0	arg4			# destination
	plus arg1 0	arg3			# dstlen = srclen
	and 0 0		argp0 goto movc_start	# no fill

movc5:
	plus 0 0	goto movc5_0
movc5_fpd:
	plus 0 0	goto movc_resume
movc5_0:
	and argd0 FF	argp0			# fill
movc_start:
	minus arg1 arg3	savc savnz		# srclen : dstlen (signed words)
	bic F psl	psl
	and savpsw D	argd1			# N Z C, V = 0
	bis argd1 psl	psl
	and arg1 FFFF	arg1			# ZEXT
	and arg3 FFFF	arg3
	minus arg4 arg2	savc			# destination below the source?
	and savpsw 1	nzcond goto movc_fwd0
# backward: start at the ends.  m = MIN(srclen, dstlen)
	and 1 1		argp1
	plus arg1 0	argd0
	minus arg3 arg1	nncond goto movc_b0
	plus arg3 0	argd0
movc_b0:
	plus arg3 0	argd1
	plus arg2 argd0	arg2
	plus arg4 arg3	arg4
	and @movc_save @movc_save	fpdv		# from here faults save the state
	plus 0 0	goto movc_bwd2
movc_fwd0:
	and 0 0		argp1
	and 0 0		argd0
	and 0 0		argd1
	and @movc_save @movc_save	fpdv
# forward: copy while both lengths are left, then fill
movc_fwd1:
	and arg1 arg1	zcond goto movc_fwd2
	and arg3 arg3	zcond goto movc_fwd2
	and savpsw 2000	nzcond goto movc_intr	# interrupt pending
	plus arg2 0	cpuaddr rmem byte
	plus rmemdat 0	crw
	plus arg4 0	cpuaddr wmem byte
	minus arg1 1	arg1
	plus arg2 1	arg2
	minus arg3 1	arg3
	plus arg4 1	arg4 goto movc_fwd1
movc_fwd2:
	and arg3 arg3	zcond goto movc_done
	and savpsw 2000	nzcond goto movc_intr
	plus argp0 0	crw
	plus arg4 0	cpuaddr wmem byte
	minus arg3 1	arg3
	plus arg4 1	arg4 goto movc_fwd2
# backward: fill the part of the destination beyond the source from the
# top, then copy downwards
movc_bwd2:
	minus arg1 arg3	nncond goto movc_bwd3	# srclen >= dstlen: copy
	and savpsw 2000	nzcond goto movc_intr
	plus argp0 0	crw
	minus arg4 1	cpuaddr wmem byte
	minus arg3 1	arg3
	minus arg4 1	arg4 goto movc_bwd2
movc_bwd3:
	and arg3 arg3	zcond goto movc_bwd4
	and savpsw 2000	nzcond goto movc_intr
	minus arg2 1	cpuaddr rmem byte
	plus rmemdat 0	crw
	minus arg4 1	cpuaddr wmem byte
	minus arg1 1	arg1
	minus arg2 1	arg2
	minus arg3 1	arg3
	minus arg4 1	arg4 goto movc_bwd3
movc_bwd4:
	plus arg2 argd0	arg2			# R1: source + min
	plus arg4 argd1	arg4			# R3: destination + dstlen
# R0 = srclen left, R1, R3 as above, R2 = R4 = R5 = 0
movc_done:
	and 0 0		crn
	plus arg1 0	crw wreg
	and 1 1		crn
	plus arg2 0	crw wreg
	and 2 2		crn
	and 0 0		crw wreg
	and 3 3		crn
	plus arg4 0	crw wreg
	and 4 4		crn
	and 0 0		crw wreg
	and 5 5		crn
	and 0 0		crw wreg
	plus 0 0	eoi
#
# Resume with PSL<FPD> set: state from R0-R5
movc_resume:
	and 0 0		crn
	and crv FFFF	arg1
	shr crv 10	arg3
	and 1 1		crn
	plus crv 0	arg2
	and 2 2		crn
	and crv FF	argp0
	shr crv 8	argp1
	and argp1 1	argp1
	and 3 3		crn
	plus crv 0	arg4
	and 4 4		crn
	and crv FFFF	argd0
	shr crv 10	argd1
	and 5 5		crn
	plus crv 0	crw
	and F F		crn wreg		# PC: after the instruction
	and @movc_save @movc_save	fpdv
	and argp1 1	nzcond goto movc_bwd2
	plus 0 0	goto movc_fwd1
#
# Fault (fpd_vec) or interrupt: state into R0-R5, PSL<FPD>, PC back to the
# opcode, then the fault or interrupt dispatch.
# memory management fault:
movc_save:
	and 0 0		crn
	shl arg3 10	arg3
	bis arg3 arg1	crw wreg		# R0 = dstlen'srclen
	and 0 0		arg1 goto movc_sv1	# then the fault dispatch
# interrupt pending:
movc_intr:
	and 0 0		crn
	shl arg3 10	arg3
	bis arg3 arg1	crw wreg
	and 1 1		arg1			# then the interrupt dispatch
movc_sv1:
	and 1 1		crn
	plus arg2 0	crw wreg		# R1
	and 2 2		crn
	shl argp1 8	arg3
	bis argp0 arg3	crw wreg		# R2 = direction'fill
	and 3 3		crn
	plus arg4 0	crw wreg		# R3
	and 4 4		crn
	shl argd1 10	arg3
	bis arg3 argd0	crw wreg		# R4 = dstlen'min
	and F F		crn
	plus crv 0	crw			# the next PC...
	and 5 5		crn wreg		# ...into R5
	and F F		crn
	plus opc 0	crw wreg		# PC back to the opcode
	and 4000 4000	arg3
	shl arg3 10	arg3
	bic arg3 psl	psl			# PSL<TP> cleared (SRM 5.4.4:
	and 800 800	arg3			# an interrupt in the middle of
	shl arg3 10	arg3			# an instruction clears it, as
	bis arg3 psl	psl			# a fault does); PSL<FPD>
	and arg1 arg1	nzcond goto intrq
	plus 0 0	goto mmflt
#
# 
cmpc5:
	and argd0 FF		argp0	# save fill byte
	and 0 0			argd0	# two empty strings are equal
	and 0 0			argd1

	# while {tmp1 NEQU 0 } and {tmp3 NEQU 0}
cmpc5_loop1:
	and arg1 arg1		zcond goto cmpc5_loop2
	and arg3 arg3		zcond goto cmpc5_loop2

	and arg2 arg2		cpuaddr rmem byte
	and rmemdat FF		argd0			# mask byte
	and arg4 arg4		cpuaddr rmem byte
	and rmemdat FF		argd1
	minus argd0 argd1	nzcond goto cmpc5_exit	# not equal
	minus arg1 1	arg1
	plus arg2 1	arg2
	minus arg3 1	arg3
	plus arg4 1	arg4	goto cmpc5_loop1

	# while {tmp1 NEQU 0 } and {tmp3 EQU 0}
cmpc5_loop2:
	and arg1 arg1	zcond goto cmpc5_loop3
	and arg3 arg3	nzcond goto cmpc5_loop3

	and arg2 arg2		cpuaddr rmem byte
	and rmemdat FF		argd0
	and argp0 FF		argd1
	minus argd0 argd1	nzcond goto cmpc5_exit
	minus arg1 1		arg1
	plus arg2 1		arg2 goto cmpc5_loop2

	# while {tmp3 NEQU 0 } and {tmp1 EQU 0}
cmpc5_loop3:
	and arg1 arg1	nzcond goto cmpc5_exit
	and arg3 arg3	zcond goto cmpc5_exit

	and arg4 arg4		cpuaddr rmem byte	# string 2 against the fill
	and rmemdat FF		argd1
	and argp0 FF		argd0
	minus argd0 argd1	nzcond goto cmpc5_exit
	minus arg3 1		arg3
	plus arg4 1		arg4 goto cmpc5_loop3

cmpc5_exit:
	plus 0 0		goto cmpc_regsave
#
# CALLS arg1,arg2,arg3 (numarg, dst, sp(fake))
#
calls:
	and 2000 2000		argp0	# CALLS
	and arg2 arg2		cpuaddr rmem word	# the entry mask first
	and rmemdat 3000	nzcond goto call_bad	# <13:12> must be zero
	plus arg1 0		crw
	minus arg3 4		cpuaddr wmem long # store numarg on stack
	minus arg3 4		arg3		# push on stack
	plus arg3 0		arg1 goto callg_1 # stack pos as AP

#
# CALLG arg1,arg2,arg3 (arglist, dst, sp(fake))
#
callg:
	and 0 0			argp0	# CALLG
callg_1:
	and arg3 3		argp1	# 527 stack align bits
	bic 3 arg3		arg3	# arg3 now aligned stack
	and arg2 arg2		cpuaddr rmem word # reg mask
	and rmemdat 3000	nzcond goto call_bad	# <13:12> must be zero
	and rmemdat FFFF	argd1	# 530 save entry word
	shl rmemdat 14		arg4	# entry mask left shifted
	and B B			argd0	# 11 regs
# save regs
callg_rloop:
	and arg4 arg4		nncond goto callg_rloop1 # 533 skip if no save

	plus argd0 0		crn	# set cur_reg_num
	plus crv 0		crw	# put cur_reg_val in wdata
	minus arg3 4		cpuaddr wmem long # write to stack
	minus arg3 4		arg3 		# write to stack

callg_rloop1:
	shl arg4 1		arg4 zcond goto callg_sreg # getout if empty
	minus argd0 1		argd0 goto callg_rloop	# sub 539 reg num

# save PC/FP/AP
callg_sreg:
	and F F			crn	# 540 PC
	plus crv 0		crw	# put cur_reg_val in wdata
	minus arg3 4		cpuaddr wmem long	 # write to stack
	and D D			crn	# FP
	plus crv 0		crw	# 544 put cur_reg_val in wdata
	minus arg3 8		cpuaddr wmem long	 # write to stack
	and C C			crn	# 546 AP
	plus crv 0		crw	# put cur_reg_val in wdata
	minus arg3 C		cpuaddr wmem long	 # 548 write to stack

# create next words to save
	shl argp1 E		argd0	# 550 stack align in bit 15-14
	and argd1 FFF		arg4	# only reg mask bit 0-11
	bis argd0 arg4		argd0	# merge
	bis argp0 argd0		argd0	# set CALLS/CALLG bit
	shl argd0 10		argd0	# put in bit 31-16
	and psl FFE0		arg4
	bis arg4 argd0		crw	# mask finished
	minus arg3 10		cpuaddr wmem long # 556
	and 0 0			crw	# zero longword
	minus arg3 14		cpuaddr wmem long
#  give regs new values
	and D D			crn	# 559
	minus arg3 14		crw wreg # set FP to SP
	and E E			crn
	minus arg3 14		crw wreg # set SP to SP
	and C C			crn
	and arg1 arg1		crw wreg # set AP to arglist
	bic EF psl		psl	# clear psw except T
	and argd1 8000		zcond goto callg_2 # 566
	bis psl 80		psl	# set DV
callg_2:
	and argd1 4000		zcond goto callg_3
	bis psl 20		psl	# set IV
callg_3:
	and F F			crn
	plus arg2 2		crw wreg # set PC
	plus 0 0		eoi	# DONE
call_bad:
	plus 0 0		resopflt eoi	# reserved operand fault
#
# arg1 is fp on entry
ret:
	plus arg1 4	argd1		# 579 SP now in argd1
	plus argd1 0	cpuaddr rmem
	plus rmemdat 0	arg1		# 581 tmp1
	and arg1 FF00	nzcond goto call_bad	# saved PSW<15:8> must be zero

	plus argd1 4	cpuaddr rmem	# 582 fetch AP val from stack
	and C C		crn		# set AP as dest reg
	plus rmemdat 0	crw wreg	# write to reg

	plus argd1 8	cpuaddr rmem	# 585 fetch FP val from stack
	and D D		crn		# set FP as dest reg
	plus rmemdat 0	crw wreg	# write to reg

	plus argd1 C	cpuaddr rmem	# 588 fetch PC val from stack
	and F F		crn		# set PC as dest reg
	plus rmemdat 0	crw wreg	# write to reg
	plus argd1 10	argd1		# 591 adjust SP

# restore regs
	shr arg1 10	arg2		# 592 get reg bitmask
	and arg2 FFF	arg2		# mask out mask
	and 0 0		arg3		# 594 reg counter
ret_regs:
	and arg2 arg2	zcond goto ret_regs1	# getout if no more regs
	and arg2 1	zcond goto ret_regs2	# more regs but not this

	plus argd1 0	cpuaddr rmem	# 597 fetch val from stack
	plus arg3 0	crn		# set next reg num
	plus rmemdat 0	crw wreg	# write to reg
	plus argd1 4	argd1		# 600 pop from stack
ret_regs2:
	plus arg3 1	arg3
	shr arg2 1	arg2 goto ret_regs

ret_regs1:
# adjust stack alignment
	shr arg1 1E	arg2		# 603 stack adj
	plus argd1 arg2	argd1		# add!
	shl arg1 2	nncond goto ret_2 # CALLS?
	plus argd1 0	cpuaddr rmem	# 606 get nargs from stack
	and rmemdat FF	arg4		# zero extend
	shl arg4 2	arg4		# get bytes
	plus argd1 arg4	argd1		# adj stack
	plus argd1 4	argd1		# pop word
ret_2:
	and E E		crn		# 611
	plus argd1 0	crw wreg
	bic FF psl	psl		# PSW <- the saved one: DV FU IV T, CCs
	and arg1 FF	arg1
	bis arg1 psl	psl eoi	# 615
#
# PUSHR arg1=mask, arg2=sp
pushr:
	and E E		arg3		# reg count
	shl arg1 11	arg1
pushr_1f:
	and arg1 arg1	zcond goto pushr_end
	and arg1 arg1	nncond goto pushr_2
	plus arg3 0	crn
	minus arg2 4	arg2
	plus crv 0	crw
	plus arg2 0	cpuaddr wmem
pushr_2:
	minus arg3 1	arg3
	shl arg1 1	arg1 goto pushr_1f
pushr_end:
	and E E		crn
	plus arg2 0	crw wreg
popr_end:
	plus 0 0	eoi
#
# POPR arg1=mask, arg2=sp
popr:
	and 0 0		arg3		# reg 0 first
popr_loop:
	and arg1 7FFF	arg1 zcond goto pushr_end # no more regs to pop
	and arg1 1	zcond goto popr_1f	# no pop

	plus arg2 0	cpuaddr rmem
	plus arg3 0	crn
	plus rmemdat 0	crw wreg
	plus arg2 4	arg2

popr_1f:
	shr arg1 1	arg1
	plus arg3 1	arg3 goto popr_loop
#
# FFC/FFS	rl,rb,wb,wl (arg1,arg2,argp0,argp1)
ffs:	bis 1 psl	psl goto ff_in
ffc:	bic 1 psl	psl		# 639 use C bit for searching
ff_in:
	plus argp1 0	argd1			# 640 save findpos
	plus arg1 0	arg4			# 641 save startpos
	and arg2 arg2	zcond goto ff_zero	# exit if size zero
	and 4 4		argp1 goto bfield	# 643 ret 4
ffc_1:	
# bitfield in argd0, size in arg2
	plus argd1 0	argp1	# 644 restore findpos
	plus arg4 0	arg1	# restore startpos
	and 0 0		argd1	# reset pos counter
ff_2:
	minus argd1 arg2	zcond goto ff_notfound savnz # 645 NZ=01
	xor psl argd0	arg4
	and arg4 1	zcond goto ff_found	# 647
	shr argd0 1	argd0
	plus argd1 1 	argd1 goto ff_2		# 649
ff_found:
	plus arg1 argd1	argd1
	and 1 1		savnz eoi	# NZ=00
ff_notfound:
	plus arg1 argd1	argd1 eoi	# 651
#
# field size 0: nothing found (N = 0, Z = 1), findpos = startpos
ff_zero:
	plus arg1 0	argd1
	and 0 0		savnz eoi
#
# LOCC, SKPC char.rb, len.rw, addr.ab (arg3, arg1, arg2): the first byte
# equal to char (LOCC) or not equal to it (SKPC). R0 = the bytes left, that
# one included (0 if none), R1 = its address (the end if none); N = 0,
# Z = (R0 = 0), V = C = 0. The length is unsigned.
locc:
	and arg3 FF	arg3	# ensure zero-extended
	and arg1 FFFF	arg1	# the length, unsigned
locc_2:
	and arg1 arg1	zcond goto locc_1	# zero len
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	arg4			# zero-extend read byte
	minus arg4 arg3	zcond goto locc_1	# equality?
	minus arg1 1	arg1
	plus arg2 1	arg2 goto locc_2
skpc:
	and arg3 FF	arg3
	and arg1 FFFF	arg1
skpc_2:
	and arg1 arg1	zcond goto locc_1
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	arg4
	minus arg4 arg3	nzcond goto locc_1	# not equal
	minus arg1 1	arg1
	plus arg2 1	arg2 goto skpc_2
#
# SCANC, SPANC len.rw, addr.ab, tbladdr.ab, mask.rb (arg1-arg4): the first
# byte whose table entry ANDed with mask is not zero (SCANC) or is zero
# (SPANC). R0 = the bytes left (0 if none), R1 = the byte's address, R2 = 0,
# R3 = tbladdr; N = 0, Z = (R0 = 0), V = C = 0.
scanc:	and arg1 FFFF	arg1
	and arg4 FF	arg4
scanc_1:
	and arg1 arg1	zcond goto scan_e
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	argd0
	plus arg3 argd0	cpuaddr rmem byte	# the table entry
	and rmemdat arg4	nzcond goto scan_e	# AND mask not zero
	minus arg1 1	arg1
	plus arg2 1	arg2 goto scanc_1
spanc:	and arg1 FFFF	arg1
	and arg4 FF	arg4
spanc_1:
	and arg1 arg1	zcond goto scan_e
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	argd0
	plus arg3 argd0	cpuaddr rmem byte
	and rmemdat arg4	zcond goto scan_e	# AND mask zero
	minus arg1 1	arg1
	plus arg2 1	arg2 goto spanc_1
scan_e:	and 2 2		crn
	and 0 0		crw wreg		# R2 = 0
	and 3 3		crn
	plus arg3 0	crw wreg		# R3 = tbladdr
	plus 0 0	goto locc_1		# R0, R1
#
# MOVTC srclen.rw, srcaddr.ab, fill.rb, tbladdr.ab, dstlen.rw, dstaddr.ab
# (arg1-arg4, argd0, argd1): the first MIN(srclen, dstlen) bytes of the
# destination get the table entries of the source bytes, the rest the
# fill. Backward when the source is below the destination, so that
# overlapping strings come out right. N Z C from CMPW srclen, dstlen, V = 0.
# R0 = srclen - MIN, R1 = srcaddr + MIN, R2 = 0, R3 = tbladdr, R4 = 0,
# R5 = dstaddr + dstlen, written first (a fault puts them back). Every page
# of the source bytes used, of the table and of the destination is probed
# before anything is moved, so that a fault cannot come in the middle: a
# translation in place (or between overlapping strings) must not be done
# twice when the instruction starts again.
movtc:	minus arg1 argd0	savc savnz	# srclen : dstlen (signed words)
	bic F psl	psl
	and savpsw D	argp0			# N Z C
	bis argp0 psl	psl
	and arg1 FFFF	arg1			# the lengths, unsigned
	and argd0 FFFF	argd0
	and arg3 FF	arg3
	plus arg1 0	argp0			# m = MIN(srclen, dstlen)
	minus argd0 arg1	nncond goto movtc_0
	plus argd0 0	argp0
movtc_0:
	and 64 64	crn
	plus arg1 0	crw wipr		# U0 = srclen
	and 65 65	crn
	plus argd0 0	crw wipr		# U1 = dstlen
	and 66 66	crn
	plus argd1 0	crw wipr		# U2 = dstaddr
	plus argp0 0	zcond goto movtc_pw0	# nothing translated
	plus arg4 0	cpuaddr rmem byte	# the table
	plus arg4 FF	cpuaddr rmem byte
	plus arg2 0	arg1			# the m source bytes
	plus argp0 0	argd0
movtc_pr:
	plus arg1 0	cpuaddr rmem byte	# a byte of this page
	bis arg1 1FF	argp1
	minus argp1 arg1	argp1
	plus argp1 1	argp1			# bytes to the end of the page
	minus argd0 argp1	ncond goto movtc_pw0	# ends in it
	minus argd0 argp1	argd0
	plus arg1 argp1	arg1
	plus argd0 0	nzcond goto movtc_pr
movtc_pw0:
	and 66 66	crn
	plus civ 0	arg1			# the destination
	and 65 65	crn
	plus civ 0	argd0
movtc_pw:
	plus argd0 0	zcond goto movtc_pe
	plus arg1 0	cpuaddr rmem byte wint	# writable
	bis arg1 1FF	argp1
	minus argp1 arg1	argp1
	plus argp1 1	argp1
	minus argd0 argp1	ncond goto movtc_pe
	minus argd0 argp1	argd0
	plus arg1 argp1	arg1 goto movtc_pw
movtc_pe:
	and 64 64	crn
	plus civ 0	arg1			# srclen, dstlen, dstaddr back
	and 65 65	crn
	plus civ 0	argd0
	and 66 66	crn
	plus civ 0	argd1
movtc_1:
	and 0 0		crn
	minus arg1 argp0	crw wreg
	and 1 1		crn
	plus arg2 argp0	crw wreg
	and 2 2		crn
	and 0 0		crw wreg
	and 3 3		crn
	plus arg4 0	crw wreg
	and 4 4		crn
	and 0 0		crw wreg
	and 5 5		crn
	plus argd1 argd0	crw wreg
	minus arg2 argd1	savc		# the source below the destination?
	and savpsw 1	nzcond goto movtc_b
movtc_f:
	and argp0 argp0	zcond goto movtc_fl
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	argp1
	plus arg4 argp1	cpuaddr rmem byte	# the table entry
	plus rmemdat 0	crw
	plus argd1 0	cpuaddr wmem byte
	plus arg2 1	arg2
	plus argd1 1	argd1
	minus argd0 1	argd0
	minus argp0 1	argp0 goto movtc_f
movtc_b:
	plus argd1 argp0	arg1		# where the fill starts
	minus argd0 argp0	argd0		# its length
movtc_b1:
	and argp0 argp0	zcond goto movtc_b2
	minus argp0 1	argp0
	plus arg2 argp0	cpuaddr rmem byte
	and rmemdat FF	argp1
	plus arg4 argp1	cpuaddr rmem byte
	plus rmemdat 0	crw
	plus argd1 argp0	cpuaddr wmem byte goto movtc_b1
movtc_b2:
	plus arg1 0	argd1
movtc_fl:
	and argd0 argd0	zcond goto movtc_e
	plus arg3 0	crw
	plus argd1 0	cpuaddr wmem byte
	plus argd1 1	argd1
	minus argd0 1	argd0 goto movtc_fl
movtc_e:
	plus 0 0	eoi
#
# MOVTUC srclen.rw, srcaddr.ab, esc.rb, tbladdr.ab, dstlen.rw, dstaddr.ab:
# translate source bytes into the destination until either string ends or
# a byte translates to the escape character (V, that byte not moved). N Z C
# from CMPW srclen, dstlen. R0 = source bytes left, R1 = their address,
# R2 = 0, R3 = tbladdr, R4 = destination bytes left, R5 = their address.
#
# MOVTUC, MATCHC and CRC keep their progress in R0-R3 (R0-R5 for MOVTUC)
# and set PSL<FPD> when a memory management fault or an interrupt stops
# them part way, as MOVC3 does: the instruction's length
# (to find the next PC when it resumes) in bits 31:24 of R0 (R2 for CRC).
# Each loop does all its memory references before it changes its state, so
# a resumed loop does again exactly the step that faulted. For MOVTUC this
# is not just speed: a translation in place (source and destination at the
# same address, which the SRM defines) done again from the start would
# translate the bytes before the fault twice.
#	MOVTUC	R0 = length'esc'srclen  R1 = srcaddr  R2 = 0  R3 = tbladdr
#		R4 = dstlen  R5 = dstaddr  (N Z C are in the PSL by then)
#	MATCHC	R0 = length'objlen  R1 = objaddr  R2 = srclen left
#		R3 = the source position being compared (done again)
#	CRC	R0 = the CRC  R1 = tbladdr  R2 = length'strlen left
#		R3 = the next byte of the stream
movtuc:	plus 0 0	goto movtuc_0
movtuc_fpd:
	plus 0 0	goto movtuc_r
movtuc_0:
	minus arg1 argd0	savc savnz
	bic F psl	psl
	and savpsw D	argp0
	bis argp0 psl	psl
	and arg1 FFFF	arg1
	and argd0 FFFF	argd0
	and arg3 FF	arg3
	and @movtuc_save @movtuc_save	fpdv	# from here faults save the state
movtuc_1:
	and arg1 arg1	zcond goto movtuc_e
	and argd0 argd0	zcond goto movtuc_e
	and savpsw 2000	nzcond goto movtuc_intr	# an interrupt is pending
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	argp1
	plus arg4 argp1	cpuaddr rmem byte
	and rmemdat FF	argp1		# translated
	minus argp1 arg3	zcond goto movtuc_v	# the escape character
	plus argp1 0	crw
	plus argd1 0	cpuaddr wmem byte
	minus arg1 1	arg1
	plus arg2 1	arg2
	minus argd0 1	argd0
	plus argd1 1	argd1 goto movtuc_1
movtuc_v:
	bis 2 psl	psl
movtuc_e:
	and 0 0		crn
	plus arg1 0	crw wreg
	and 1 1		crn
	plus arg2 0	crw wreg
	and 2 2		crn
	and 0 0		crw wreg
	and 3 3		crn
	plus arg4 0	crw wreg
	and 4 4		crn
	plus argd0 0	crw wreg
	and 5 5		crn
	plus argd1 0	crw wreg
	plus 0 0	eoi
# resumed with PSL<FPD> set: the state from R0-R5, PC after the instruction
movtuc_r:
	and 0 0		crn
	and crv FFFF	arg1
	shr crv 10	arg3
	and arg3 FF	arg3
	shr crv 18	argp1		# the instruction's length
	plus opc argp1	crw
	and F F		crn wreg		# PC
	and 1 1		crn
	plus crv 0	arg2
	and 3 3		crn
	plus crv 0	arg4
	and 4 4		crn
	and crv FFFF	argd0
	and 5 5		crn
	plus crv 0	argd1
	and @movtuc_save @movtuc_save	fpdv
	plus 0 0	goto movtuc_1
# a memory management fault (the fpdv routine) or an interrupt
movtuc_save:
	and 0 0		argp0 goto movtuc_s1
movtuc_intr:
	and 1 1		argp0
movtuc_s1:
	and F F		crn
	plus opc 0	argp1
	minus crv argp1	argp1		# the instruction's length
	shl argp1 8	argp1
	bis argp1 arg3	argp1
	shl argp1 10	argp1
	bis argp1 arg1	crw
	and 0 0		crn wreg		# R0 = length'esc'srclen
	and 1 1		crn
	plus arg2 0	crw wreg
	and 2 2		crn
	and 0 0		crw wreg
	and 3 3		crn
	plus arg4 0	crw wreg
	and 4 4		crn
	plus argd0 0	crw wreg
	and 5 5		crn
	plus argd1 0	crw wreg
	plus argp0 0	arg1 goto fpd_end
#
# The end of the FPD save of MOVTUC, MATCHC and CRC: PC back to the opcode,
# PSL<TP> cleared (SRM 5.4.4: as after a fault, the resumed instruction is
# traced when it completes) and PSL<FPD> set, then the interrupt (arg1 not
# zero) or the fault dispatch.
fpd_end:
	and F F		crn
	plus opc 0	crw wreg
	and 4000 4000	arg3
	shl arg3 10	arg3
	bic arg3 psl	psl
	and 800 800	arg3
	shl arg3 10	arg3
	bis arg3 psl	psl
	and arg1 arg1	nzcond goto intrq
	plus 0 0	goto mmflt
#
# MATCHC objlen.rw, objaddr.ab, srclen.rw, srcaddr.ab (arg1-arg4): the first
# occurrence of the object string in the source string. Found: R0 = 0,
# R1 = objaddr + objlen, R2 = source bytes left after it, R3 = the address
# after it; not found: R0 = objlen, R1 = objaddr, R2 = 0, R3 = srcaddr +
# srclen. N Z from R0, V = C = 0. An empty object is found at once. The
# condition codes are set here, not by the end of instruction, so that an
# interrupt taken part way does not set them in the new PSL.
matchc:	plus 0 0	goto matchc_0
matchc_fpd:
	plus 0 0	goto matchc_r
matchc_0:
	and arg1 FFFF	arg1
	and arg3 FFFF	arg3
	and @matchc_save @matchc_save	fpdv
matchc_1:
	minus arg3 arg1	ncond goto matchc_no	# less left than the object
	and 0 0		argd0
matchc_2:
	minus argd0 arg1	zcond goto matchc_yes
	and savpsw 2000	nzcond goto matchc_intr
	plus arg2 argd0	cpuaddr rmem byte
	and rmemdat FF	argd1
	plus arg4 argd0	cpuaddr rmem byte
	and rmemdat FF	argp0
	minus argd1 argp0	nzcond goto matchc_3	# differ
	plus argd0 1	argd0 goto matchc_2
matchc_3:
	minus arg3 1	arg3
	plus arg4 1	arg4 goto matchc_1
matchc_yes:
	plus arg2 arg1	arg2
	minus arg3 arg1	arg3
	plus arg4 arg1	arg4
	and 0 0		arg1 goto matchc_e
matchc_no:
	plus arg4 arg3	arg4
	and 0 0		arg3
matchc_e:
	and 1 1		crn
	plus arg2 0	crw wreg
	and 2 2		crn
	plus arg3 0	crw wreg
	and 3 3		crn
	plus arg4 0	crw wreg
	and 0 0		crn
	plus arg1 0	crw wreg savnz
str_nz:
	bic F psl	psl			# N Z from the last result,
	and savpsw C	argp0			# V = C = 0
	bis argp0 psl	psl
	plus 0 0	eoi
matchc_r:
	and 0 0		crn
	and crv FFFF	arg1
	shr crv 18	argp1
	plus opc argp1	crw
	and F F		crn wreg		# PC
	and 1 1		crn
	plus crv 0	arg2
	and 2 2		crn
	and crv FFFF	arg3
	and 3 3		crn
	plus crv 0	arg4
	and @matchc_save @matchc_save	fpdv
	plus 0 0	goto matchc_1
matchc_save:
	and 0 0		argp0 goto matchc_s1
matchc_intr:
	and 1 1		argp0
matchc_s1:
	and F F		crn
	plus opc 0	argp1
	minus crv argp1	argp1
	shl argp1 18	argp1
	bis argp1 arg1	crw
	and 0 0		crn wreg		# R0 = length'objlen
	and 1 1		crn
	plus arg2 0	crw wreg
	and 2 2		crn
	plus arg3 0	crw wreg
	and 3 3		crn
	plus arg4 0	crw wreg
	plus argp0 0	arg1 goto fpd_end
#
# CRC tbl.ab, inicrc.rl, strlen.rw, stream.ab (arg1-arg4): the CRC of the
# stream with the 16-longword table, four bits at a time. R0 = the CRC,
# R1 = R2 = 0, R3 = the address after the stream; N Z from R0, V = C = 0.
# The CRC of a byte is worked out in argd1 and stored only when its table
# lookups are done.
crc:	plus 0 0	goto crc_0
crc_fpd:
	plus 0 0	goto crc_r
crc_0:
	and arg3 FFFF	arg3
	and @crc_save @crc_save	fpdv
crc_1:	and arg3 arg3	zcond goto crc_e
	and savpsw 2000	nzcond goto crc_intr
	plus arg4 0	cpuaddr rmem byte
	and rmemdat FF	argd0
	xor arg2 argd0	argd1			# CRC xor the byte
	and argd1 F	argd0
	shl argd0 2	argd0
	plus arg1 argd0	cpuaddr rmem		# the table entry
	shr argd1 4	argd1
	xor rmemdat argd1	argd1
	and argd1 F	argd0
	shl argd0 2	argd0
	plus arg1 argd0	cpuaddr rmem
	shr argd1 4	argd1
	xor rmemdat argd1	arg2
	minus arg3 1	arg3
	plus arg4 1	arg4 goto crc_1
crc_e:	and 1 1		crn
	and 0 0		crw wreg
	and 2 2		crn
	and 0 0		crw wreg
	and 3 3		crn
	plus arg4 0	crw wreg
	and 0 0		crn
	plus arg2 0	crw wreg savnz goto str_nz
crc_r:
	and 0 0		crn
	plus crv 0	arg2			# the CRC
	and 1 1		crn
	plus crv 0	arg1			# the table
	and 2 2		crn
	and crv FFFF	arg3
	shr crv 18	argp1
	plus opc argp1	crw
	and F F		crn wreg		# PC
	and 3 3		crn
	plus crv 0	arg4
	and @crc_save @crc_save	fpdv
	plus 0 0	goto crc_1
crc_save:
	and 0 0		argp0 goto crc_s1
crc_intr:
	and 1 1		argp0
crc_s1:
	and 0 0		crn
	plus arg2 0	crw wreg		# R0 = the CRC
	and 1 1		crn
	plus arg1 0	crw wreg		# R1 = the table
	and F F		crn
	plus opc 0	argp1
	minus crv argp1	argp1
	shl argp1 18	argp1
	bis argp1 arg3	crw
	and 2 2		crn wreg		# R2 = length'strlen
	and 3 3		crn
	plus arg4 0	crw wreg
	plus argp0 0	arg1 goto fpd_end

locc_1:
	and 0 0		crn
	plus arg1 0	crw wreg savnz	# save final len
	and 1 1		crn
	plus arg2 0	crw wreg	# save final addr
	plus 0 0	eoi
#
# INSQUE arg1,arg2 (entry,pred)
insque:
	# *entry = *pred
	plus arg2 0	cpuaddr rmem long	# fetch *pred
	plus rmemdat 0	arg4			# save for later
	plus rmemdat 0	crw
	plus arg1 0	cpuaddr wmem long	# write to *entry

	# *(entry+4) = pred
	plus arg2 0	crw
	plus arg1 4	cpuaddr wmem long

	# *(*pred + 4) = entry
	plus arg2 0	cpuaddr rmem long
	plus arg1 0	crw
	plus rmemdat 4	cpuaddr wmem long

	# *pred = entry
	plus arg1 0	crw
	plus arg2 0	cpuaddr wmem long

	# Set flags, arg4 < arg2
	minus arg4 arg2		argd0 savc savnz eoi
#
# REMQUE arg1,arg1p (entry,addr)
remque:
	# **(entry+4) = *entry
	plus arg1 0	cpuaddr rmem long
	plus rmemdat 0	arg4
	plus arg1 4	cpuaddr rmem long
	plus arg4 0	crw
	plus rmemdat 0	cpuaddr wmem long

	# *(*entry+4) = *(entry+4)
	plus arg1 4	cpuaddr rmem long	# *(entry+4)
	plus rmemdat 0	arg4
	plus arg1 0	cpuaddr rmem long	# *entry
	plus arg4 0	crw
	plus rmemdat 4	cpuaddr wmem long

	# addr = entry
	plus arg1 0	argd1

	# calc psl bits
	bic 2 psl	psl
	plus arg1 4	cpuaddr rmem long
	minus rmemdat arg1 nzcond goto remque_1
	bis 2 psl	psl
remque_1:
	plus arg1 0	cpuaddr rmem long
	plus rmemdat 0	arg3
	plus arg1 4	cpuaddr rmem long
	plus rmemdat 0	arg4
	minus arg3 arg4	argd0 savc savv savnz eoi
#
# INSQHI, INSQTI entry.ab, header.aq (arg1 = d, arg2 = h); REMQHI,
# REMQTI header.aq, addr.wl (arg1 = h, addr at argp0): the interlocked
# queue instructions on a self-relative queue (links are offsets). Reserved
# operand fault when the header, the entry or a link that is used is not
# quadword aligned, the entry is the header, or addr is the header. When
# the interlock bit (h)<0> is set nothing is done: C (insert), V and C
# (remove). With one processor nothing else can look at the queue while the
# instruction runs, so the interlock is not set in memory; every page that
# is written is checked for write access before the first write, so a fault
# leaves the queue as it was.
#
# INSQHI: insert d after the header. Z if the queue was empty.
insqhi:	minus arg1 arg2	zcond goto q_bad	# entry = header
	bis arg1 arg2	arg3
	and arg3 7	nzcond goto q_bad	# not quadword aligned
	plus arg1 0	cpuaddr rmem byte wint	# write check d
	plus arg2 0	cpuaddr rmem wint	# ar <- (h)
	plus rmemdat 0	arg3
	and arg3 6	nzcond goto q_bad
	and arg3 1	nzcond goto q_busy
insqh_e:
	plus arg3 arg2	arg4			# a = ar + h
	plus arg4 0	cpuaddr rmem wint	# write check a
	minus arg1 arg4	crw
	plus arg4 4	cpuaddr wmem		# (a+4) <- d-a
	minus arg4 arg1	crw
	plus arg1 0	cpuaddr wmem		# (d) <- a-d
	minus arg2 arg1	crw
	plus arg1 4	cpuaddr wmem		# (d+4) <- h-d
	minus arg1 arg2	crw
	plus arg2 0	cpuaddr wmem		# (h) <- d-h
	bic F psl	psl
	plus arg3 0	nzcond goto q_end
	bis 4 psl	psl			# Z: the queue was empty
q_end:	plus 0 0	eoi
q_busy:	bic F psl	psl
	bis 1 psl	psl eoi			# C: interlocked, nothing done
q_vbusy:
	bic F psl	psl
	bis 3 psl	psl eoi			# V C: interlocked, nothing done
q_bad:	plus 0 0	resopflt eoi
#
# INSQTI: insert d before the header (at the tail); into an empty queue as
# INSQHI. NZVC = 0 otherwise.
insqti:	minus arg1 arg2	zcond goto q_bad
	bis arg1 arg2	arg3
	and arg3 7	nzcond goto q_bad
	plus arg1 0	cpuaddr rmem byte wint	# write check d
	plus arg2 0	cpuaddr rmem wint	# ar <- (h)
	plus rmemdat 0	arg3
	plus arg3 0	zcond goto insqh_e	# empty
	and arg3 6	nzcond goto q_bad
	and arg3 1	nzcond goto q_busy
	plus arg2 4	cpuaddr rmem		# (h+4)
	plus rmemdat arg2	arg4		# c = (h+4) + h
	and arg4 7	nzcond goto q_bad
	plus arg4 0	cpuaddr rmem wint	# write check c
	minus arg1 arg4	crw
	plus arg4 0	cpuaddr wmem		# (c) <- d-c
	minus arg2 arg1	crw
	plus arg1 0	cpuaddr wmem		# (d) <- h-d
	minus arg4 arg1	crw
	plus arg1 4	cpuaddr wmem		# (d+4) <- c-d
	minus arg1 arg2	crw
	plus arg2 4	cpuaddr wmem		# (h+4) <- d-h
	bic F psl	psl eoi
#
# REMQHI: remove the entry after the header, its address to addr (h if
# the queue is empty: Z and V). Z if the queue is empty now.
remqhi:	and arg1 7	nzcond goto q_bad
	and savpsw 10	nzcond goto remqh_1	# addr is a register
	minus argp0 arg1	zcond goto q_bad	# addr = header
	plus argp0 0	cpuaddr rmem wint	# write check addr
remqh_1:
	plus arg1 0	cpuaddr rmem wint	# ar <- (h)
	plus rmemdat 0	arg2
	and arg2 6	nzcond goto q_bad
	and arg2 1	nzcond goto q_vbusy
	plus arg2 0	zcond goto remq_e	# empty
remqh_a:
	plus arg2 arg1	arg3			# a = ar + h
	plus arg3 0	cpuaddr rmem		# (a)
	plus rmemdat arg3	arg4		# b = (a) + a
	and arg4 7	nzcond goto q_bad
	plus arg4 0	cpuaddr rmem wint	# write check b
	minus arg1 arg4	crw
	plus arg4 4	cpuaddr wmem		# (b+4) <- h-b
	minus arg4 arg1	crw
	plus arg1 0	cpuaddr wmem		# (h) <- b-h
	bic F psl	psl
	minus arg4 arg1	nzcond goto remqh_2
	bis 4 psl	psl			# Z: empty now
remqh_2:
	plus arg3 0	argd0 wback eoi		# addr <- a
remq_e:	bic F psl	psl
	bis 6 psl	psl			# Z V: the queue was empty
	plus arg1 0	argd0 wback eoi		# addr <- h
#
# REMQTI: remove the entry before the header (the tail); a queue of one
# entry as REMQHI.
remqti:	and arg1 7	nzcond goto q_bad
	and savpsw 10	nzcond goto remqt_1
	minus argp0 arg1	zcond goto q_bad
	plus argp0 0	cpuaddr rmem wint
remqt_1:
	plus arg1 0	cpuaddr rmem wint	# ar <- (h)
	plus rmemdat 0	arg2
	and arg2 6	nzcond goto q_bad
	and arg2 1	nzcond goto q_vbusy
	plus arg2 0	zcond goto remq_e	# empty
	plus arg1 4	cpuaddr rmem		# (h+4)
	plus rmemdat 0	arg3
	minus arg2 arg3	zcond goto remqh_a	# one entry
	and arg3 7	nzcond goto q_bad
	plus arg3 arg1	arg3			# c = (h+4) + h
	plus arg3 4	cpuaddr rmem		# (c+4)
	plus rmemdat arg3	arg4		# b = (c+4) + c
	and arg4 7	nzcond goto q_bad
	plus arg4 0	cpuaddr rmem wint	# write check b
	minus arg1 arg4	crw
	plus arg4 0	cpuaddr wmem		# (b) <- h-b
	minus arg4 arg1	crw
	plus arg1 4	cpuaddr wmem		# (h+4) <- b-h
	bic F psl	psl
	plus arg3 0	argd0 wback eoi		# addr <- c
#
# INDEX subscript.rl, low.rl, high.rl, size.rl, indexin.rl, indexout.wl
# (arg1-arg4, argd0): indexout <- (indexin + subscript) * size, N Z from it,
# V = C = 0; then a subscript range trap (type 7) if subscript < low or
# subscript > high (signed compares that cannot overflow).
index:	plus argd0 arg1	argd0
	mul argd0 arg4	argd0 savnz		# indexout
	xor arg1 arg2	argd1
	plus argd1 0	ncond goto index_ld	# signs differ
	minus arg1 arg2	ncond goto index_r	# subscript < low
	plus 0 0	goto index_h
index_ld:
	plus arg1 0	ncond goto index_r	# subscript < 0 <= low
index_h:
	xor arg1 arg3	argd1
	plus argd1 0	ncond goto index_hd
	minus arg3 arg1	ncond goto index_r	# high < subscript
	plus 0 0	eoi
index_hd:
	plus arg3 0	ncond goto index_r	# high < 0 <= subscript
	plus 0 0	eoi
index_r:
	and 74 74	crn
	and 7 7		crw wipr		# subscript range trap
	plus 0 0	eoi
#
# ADAWI add.rw, sum.mw (arg1; sum as a write operand, argp0, so that the
# alignment is checked before it is read): sum <- sum + add as ADDW2. In
# memory sum must be word aligned (reserved operand fault); it is read with
# write intent and written back (interlocked: one processor here).
adawi:	and savpsw 10	zcond goto adawi_m	# argp0 is not a register
	plus argp0 0	crn
	shl crv 10	arg2			# the register's low word ...
	plus 0 0	goto adawi_a
adawi_m:
	and argp0 1	nzcond goto q_bad	# odd address
	plus argp0 0	cpuaddr rmem word wint
	shl rmemdat 10	arg2
adawi_a:
	asr arg2 10	arg2			# ... sign extended
	plus arg1 arg2	argd0 savnz savc savv eoi
#
# PROBER/PROBEW mode.rb, len.rw, base.ab (arg1, arg2, arg3), SRM 4.10.
# The mode is the less privileged of mode<1:0> and PSL<PRV_MOD>; the first
# and the last byte are checked. The MMU answers a probe request in bit 0 of
# the data (1 = accessible); the mode travels in the write data. A probe
# faults only if the system PTE that maps a process page table is invalid.
#
prober:
	and 0 0		arg4 goto probe		# read
probew:
	and 1 1		arg4			# write
probe:
	shr psl 16	argd0			# PSL<23:22>
	and argd0 3	argd0			# PRV_MOD
	and arg1 3	arg1
	minus argd0 arg1 ncond goto probe_1
	plus argd0 0	arg1			# PRV_MOD is less privileged
probe_1:
	and arg2 FFFF	arg2			# ZEXT(len)
	bic 3 arg3	argd1			# first byte
	plus arg1 0	crw			# probe mode
	and arg4 arg4	nzcond goto probe_w1
	plus argd1 0	cpuaddr rmem probe
	plus 0 0	goto probe_2
probe_w1:
	plus argd1 0	cpuaddr rmem probe wint
probe_2:
	and rmemdat 1	zcond goto probe_no
	plus arg3 arg2	argd1
	minus argd1 1	argd1			# last byte, base + len - 1
	bic 3 argd1	argd1
	plus arg1 0	crw
	and arg4 arg4	nzcond goto probe_w2
	plus argd1 0	cpuaddr rmem probe
	plus 0 0	goto probe_3
probe_w2:
	plus argd1 0	cpuaddr rmem probe wint
probe_3:
	and rmemdat 1	zcond goto probe_no
	bic E psl	psl eoi			# accessible: N = Z = V = 0
probe_no:
	bic E psl	psl
	bis 4 psl	psl eoi			# not accessible: Z = 1
#
# Privileged instruction outside kernel mode: reserved instruction fault
# (SRM 8.4: MTPR, MFPR; 6.4: LDPCTX, SVPCTX). Internal register 72 turns
# the reserved operand fault that follows into a reserved instruction
# fault; either way the hardware first backs the PC up to the opcode and
# restores the registers.
priv_flt:
	and 72 72	crn
	and 0 0		crw wipr
	plus 0 0	resopflt eoi
#
# LDPCTX (SRM 6.4): load the process context from the PCB (physical
# address in PCBB). Writing P0BR..P1LR flushes the process half of the TB.
# Then from the interrupt stack to the process's kernel stack, where the PC
# and PSL of the PCB are pushed for the REI that must follow.
ldpctx:
	and savpsw 1000	nzcond goto priv_flt
	and 10 10	crn
	plus civ 0	arg1			# PCBB
	and 0 0		arg2
ldp_sp:
	plus arg1 0	cpuaddr rmem phys	# KSP, ESP, SSP, USP
	plus arg2 0	crn
	plus rmemdat 0	crw wipr
	plus arg1 4	arg1
	plus arg2 1	arg2
	minus arg2 4	nzcond goto ldp_sp
	and 0 0		arg2
ldp_r:
	plus arg1 0	cpuaddr rmem phys	# R0-R13
	plus arg2 0	crn
	plus rmemdat 0	crw wreg
	plus arg1 4	arg1
	plus arg2 1	arg2
	minus arg2 E	nzcond goto ldp_r
	plus arg1 0	cpuaddr rmem phys	# PC
	plus rmemdat 0	arg3
	plus arg1 4	cpuaddr rmem phys	# PSL
	plus rmemdat 0	arg4
	plus arg1 8	cpuaddr rmem phys	# P0BR
	and 8 8		crn
	plus rmemdat 0	crw wipr
	and 3F 3F	argd0
	shl argd0 10	argd0
	bis argd0 FFFF	argd0			# length mask 3FFFFF
	plus arg1 C	cpuaddr rmem phys	# P0LR, ASTLVL
	and 9 9		crn
	and rmemdat argd0	crw wipr
	shr rmemdat 18	argd1
	and 13 13	crn
	and argd1 7	crw wipr
	plus arg1 10	cpuaddr rmem phys	# P1BR
	and A A		crn
	plus rmemdat 0	crw wipr
	plus arg1 14	cpuaddr rmem phys	# P1LR (PME not kept)
	and B B		crn
	and rmemdat argd0	crw wipr
	and E E		crn
	plus crv 0	crw
	and 4 4		crn wipr		# ISP <- SP
	and 400 400	argd1
	shl argd1 10	argd1
	bic argd1 psl	psl			# PSL<IS> <- 0
	and 0 0		crn
	plus civ 0	argd1			# KSP
	minus argd1 4	cpuaddr
	plus arg4 0	crw wmem		# -(SP) <- PSL
	minus argd1 8	cpuaddr
	plus arg3 0	crw wmem		# -(SP) <- PC
	and E E		crn
	minus argd1 8	crw wreg		# SP
	plus 0 0	eoi
#
# SVPCTX (SRM 6.4): save the process context in the PCB, popping the PC and
# PSL from the stack; from the kernel stack, go to the interrupt stack at
# IPL 1 or more.
svpctx:
	and savpsw 1000	nzcond goto priv_flt
	and 10 10	crn
	plus civ 0	arg1			# PCBB
	and 0 0		arg2
svp_sp:
	plus arg2 0	crn			# KSP, ESP, SSP, USP
	plus civ 0	crw
	plus arg1 0	cpuaddr wmem phys
	plus arg1 4	arg1
	plus arg2 1	arg2
	minus arg2 4	nzcond goto svp_sp
	and 0 0		arg2
svp_r:
	plus arg2 0	crn			# R0-R13
	plus crv 0	crw
	plus arg1 0	cpuaddr wmem phys
	plus arg1 4	arg1
	plus arg2 1	arg2
	minus arg2 E	nzcond goto svp_r
	and E E		crn
	plus crv 0	cpuaddr rmem
	plus rmemdat 0	crw
	plus arg1 0	cpuaddr wmem phys	# PC <- (SP)+
	plus crv 4	cpuaddr rmem
	plus rmemdat 0	crw
	plus arg1 4	cpuaddr wmem phys	# PSL <- (SP)+
	plus crv 8	crw wreg
	shl psl 5	ncond goto svp_end	# already on the interrupt stack
	shr psl 10	argd0
	and argd0 1F	nzcond goto svp_ipl
	and 1 1		argd0
	shl argd0 10	argd0
	bis argd0 psl	psl			# IPL 0 -> 1
svp_ipl:
	and E E		crn
	plus crv 0	crw
	minus arg1 48	cpuaddr wmem phys	# (PCB) <- SP
	and 0 0		crn wipr		# KSP <- SP
	and 400 400	argd1
	shl argd1 10	argd1
	bis argd1 psl	psl			# PSL<IS> <- 1
	and 4 4		crn
	plus civ 0	crw
	and E E		crn wreg		# SP <- ISP
svp_end:
	plus 0 0	eoi
#
# CHMK code.rw (sp in arg2): change mode to kernel through SCB 40.
# CHME, CHMS, CHMU and the probe of the new stack are not done yet.
#
# CHMK, CHME, CHMS, CHMU code (SRM chapter 5, CHM): go to the more privileged
# of the opcode's mode and the current mode, on that mode's stack, through
# the SCB vector of the opcode's mode (40, 44, 48, 4C). The new stack is
# probed for writing in the new mode first, with the new PSL already in
# place: an access-control violation or translation-not-valid there is an
# ordinary fault on the CHMx, which puts SP, PC and PSL back. On the
# interrupt stack the processor halts (8600 halt code A; PC past the
# CHMx), and so it does if the vector has bits 1:0 set (code B,
# everything put back). Frame: code (sign extended), PC, PSL; the new PSL
# keeps the IPL and clears everything else.
# argd1 opcode's mode, arg3 current mode, arg4 new mode, argd0 vector,
# arg2 new SP, argp1 the PSL to save, arg1 the code.
#
chmk:	and 0 0		argd1 goto chm
chme:	and 1 1		argd1 goto chm
chms:	and 2 2		argd1 goto chm
chmu:	and 3 3		argd1
chm:	shl psl 5	ncond goto chm_is	# PSL<IS>
	shr psl 18	arg3
	and arg3 3	arg3			# PSL<CUR_MOD>
	minus argd1 arg3	nncond goto chm_1
	plus argd1 0	arg4 goto chm_2		# the opcode's mode is more privileged
chm_1:	plus arg3 0	arg4			# otherwise the mode stays
chm_2:	shl argd1 2	arg2
	plus arg2 40	arg2			# SCB offset 40 + 4 * mode
	and 11 11	crn			# SCBB
	plus civ arg2	cpuaddr rmem phys
	plus rmemdat 0	argd0			# the vector
	and argd0 3	nzcond goto chm_vec
	and E E		crn
	plus crv 0	crw			# SP ...
	plus arg3 0	crn wipr		# ... saved in IPR[current mode]
	plus arg4 0	crn
	plus civ 0	arg2			# the new mode's stack pointer
	plus psl 0	argp1			# the PSL to save, CCs included
	shr psl 10	argd1
	and argd1 1F	argd1			# IPL, kept
	shl arg3 6	argp0
	bis argp0 argd1	argd1			# PRV_MOD <- current mode
	shl arg4 8	argp0
	bis argp0 argd1	argd1			# CUR_MOD <- new mode
	shl argd1 10	psl			# the new PSL: accesses in the new mode
	and E E		crn
	plus arg2 0	crw wreg		# SP <- the new stack pointer
	minus arg2 1	cpuaddr rmem byte wint	# probe SP-1 ...
	minus arg2 C	cpuaddr rmem byte wint	# ... and SP-12 for writing
	minus arg2 4	cpuaddr
	plus argp1 0	crw wmem		# -(SP) <- PSL
	minus arg2 8	cpuaddr
	and F F		crn
	plus crv 0	crw wmem		# -(SP) <- PC of the next instruction
	minus arg2 C	cpuaddr
	shl arg1 10	arg1
	asr arg1 10	crw wmem		# -(SP) <- the code, sign extended
	and E E		crn
	minus arg2 C	crw wreg		# SP <- SP - 12
	and F F		crn
	bic 3 argd0	crw wreg		# PC <- vector<31:2>
	plus 0 0	eoi
chm_is:	and 73 73	crn
	and A A		crw wipr		# halt A: CHMx on the interrupt stack
	plus 0 0	eoi
chm_vec:
	and 73 73	crn
	and 10B 10B	crw wipr		# halt B: the CHMx vector has bits 1:0 set
	plus 0 0	eoi
#
# BPT (breakpoint, SCB 2C) and XFC (extended function call, SCB 14): faults,
# PC at the opcode.
#
bpt:	and 2C 2C	argd1 goto bpt_1
xfc:	and 14 14	argd1
bpt_1:	and 0 0		argp1		# end in scb_common
	and 20 20	argd0		# an exception
	and F F		crn
	minus crv 1	crw wreg	# PC back to the opcode
	shr psl 10	arg1
	bic 4000 arg1	arg1		# the saved PSL: TP clear (a fault)
	shl arg1 10	arg1
	and psl FFFF	arg2
	bis arg1 arg2	arg1 goto scb_common2
#
# CMPC3 len,src1,src2
cmpc3:
	plus arg3 0	arg4
	and 0 0		argd0
	and 0 0		argd1

cmpc3_loop:
	plus arg1 0	zcond goto cmpc3_done
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	argd0
	plus arg4 0	cpuaddr rmem byte
	and rmemdat FF	argd1
	minus argd0 argd1 nzcond goto cmpc3_done
	minus arg1 1	arg1
	plus arg2 1	arg2
	plus arg4 1	arg4 goto cmpc3_loop

cmpc3_done:
	plus arg1 0	arg3 goto cmpc_regsave

cmpc_regsave:
	and 0 0		crn
	plus arg1 0	crw wreg
	and 1 1		crn
	plus arg2 0	crw wreg
	and 2 2		crn
	plus arg3 0	crw wreg
	and 3 3		crn
	plus arg4 0	crw wreg
# The condition codes of CMPB on the last two bytes compared (argd0 and
# argd1, both zero if no byte was): C from the unsigned comparison, N and Z
# from the signed one (the bytes with their sign bit flipped compare
# unsigned as the bytes do signed).
cmpc_cc:
	minus argd0 argd1	savc
	xor argd0 80	arg1
	xor argd1 80	arg2
	minus arg1 arg2	savnz eoi
#
# Decimal string instructions (SRM chapter 3: the results, the condition
# codes and the registers). The decimal unit
# (decunit.v, internal registers 60-6F) holds the strings and does the
# arithmetic; the microcode moves them between memory and the unit. A
# length above 31 is a reserved operand. A source may fault while it is
# read (the instruction starts again); a destination is checked for writing
# before its first byte is stored. The operands are kept in the unit's
# U0-U3 (64-67) while the subroutines run; the general registers are
# written at the end.
#
# dsrd (return address in arg4): the packed decimal string of arg1 digits
# at arg2 into decimal unit register A (arg3 = 61) or B (arg3 = 62): the
# high nibble of the first byte of a string of even
# length is not a digit, the low nibble of the last byte is the sign (B and
# D minus). argd0 <- 1 if minus and not zero. Uses argd1, argp0, argp1.
dsrd:	shr arg1 1	argd1			# index of the sign byte
	and 0 0		argp1			# byte index
dsrd_l:	plus arg2 argp1	cpuaddr rmem byte
	and rmemdat FF	argp0
	plus argp1 0	nzcond goto dsrd_2	# not the first byte
	and arg1 1	nzcond goto dsrd_1
	and argp0 F	argp0			# even length: no high digit
dsrd_1:	bis argp0 200	argp0			# the first byte: from zero
dsrd_2:	minus argp1 argd1	nzcond goto dsrd_3
	and argp0 F	argd0			# the sign nibble ...
	bis argp0 100	argp0			# ... is not a digit
dsrd_3:	plus arg3 0	crn
	plus argp0 0	crw wipr
	plus argp1 1	argp1
	minus argd1 argp1	nncond goto dsrd_l
	minus argd0 B	zcond goto dsrd_m
	minus argd0 D	zcond goto dsrd_m
	and 0 0		argd0 goto dsrd_r	# plus
dsrd_m:	and 60 60	crn
	plus civ 0	argp0			# A = 0 <0>, B = 0 <5>
	minus arg3 61	zcond goto dsrd_a
	shr argp0 5	argp0
dsrd_a:	and argp0 1	argp0
	xor argp0 1	argd0			# minus unless zero
dsrd_r:	plus arg4 0	jmp
#
# dswr (return address in arg4): decimal unit register A as the packed
# decimal string of arg1 digits at arg2:
# digits above the length make V, as do argd1 = 1 and a carry the unit saw;
# the sign is argd0, plus for a zero result without V; PSL N (minus, not
# zero) Z V, C left as it is; V with PSL<DV> requests the decimal overflow
# trap (type 6). Uses arg3, argp0, argp1.
dswr:	plus arg2 0	cpuaddr rmem byte wint	# writable: the first byte ...
	shr arg1 1	argp1
	plus arg2 argp1	cpuaddr rmem byte wint	# ... and the last
	and 60 60	crn
	shl arg1 8	argp0
	bis argp0 9	crw wipr		# SETLEN
	plus civ 0	argp0			# status
	shr argp0 3	arg3
	and arg3 1	arg3
	bis arg3 argd1	arg3			# V
	and argp0 1	argp0			# Z
	plus argp0 0	zcond goto dswr_1
	plus arg3 0	nzcond goto dswr_1
	and 0 0		argd0			# zero without V: plus
dswr_1:	bic E psl	psl
	shl arg3 1	argp1
	bis argp1 psl	psl			# V
	shl argp0 2	argp1
	bis argp1 psl	psl			# Z
	plus argp0 0	nzcond goto dswr_2
	shl argd0 3	argp1
	bis argp1 psl	psl			# N
dswr_2:	bis argd0 C	argp1			# the sign nibble: C, or D
	shl argp1 10	argp1
	bis argp1 A	crw wipr		# SETNIB 0
	shr arg1 1	argp1			# bytes - 1
	minus F argp1	argp0
	shl argp0 9	argp0
	bis argp0 8	crw wipr		# ROL: the first byte to the top
	plus arg2 0	argp0
dswr_l:	and 61 61	crn
	plus civ 0	crw			# the top byte
	plus argp0 0	cpuaddr wmem byte
	and 60 60	crn
	and 208 208	crw wipr		# ROL 2
	plus argp0 1	argp0
	minus argp1 1	argp1 nncond goto dswr_l
	plus arg3 0	zcond goto dswr_r
	and psl 80	zcond goto dswr_r	# PSL<DV> clear
	and 74 74	crn
	and 6 6		crw wipr		# decimal overflow trap
dswr_r:	plus arg4 0	jmp
#
# The end of most of them: R0 = R2 = 0, R1 = U1, R3 = U3 (dec_r4); R4 = 0,
# R5 = U2 as well (dec_r6).
dec_r6:	and 4 4		crn
	and 0 0		crw wreg
	and 66 66	crn
	plus civ 0	argp0
	and 5 5		crn
	plus argp0 0	crw wreg
dec_r4:	and 0 0		crn
	and 0 0		crw wreg
	and 2 2		crn
	and 0 0		crw wreg
	and 65 65	crn
	plus civ 0	argp0
	and 1 1		crn
	plus argp0 0	crw wreg
	and 67 67	crn
	plus civ 0	argp0
	and 3 3		crn
	plus argp0 0	crw wreg
	plus 0 0	eoi
#
# MOVP len.rw, srcaddr.ab, dstaddr.ab (arg1-arg3): the string read and
# written again. N Z V, C unchanged. R0 = R2 = 0, R1 = srcaddr, R3 =
# dstaddr.
movp:	and arg1 FFFF	arg1
	minus 1F arg1	ncond goto q_bad
	and 65 65	crn
	plus arg2 0	crw wipr		# U1 = srcaddr
	and 67 67	crn
	plus arg3 0	crw wipr		# U3 = dstaddr
	and 60 60	crn
	and 0 0		crw wipr		# CLR
	and 61 61	arg3
	and @movp_1 @movp_1	arg4
	plus 0 0	goto dsrd
movp_1:	and 67 67	crn
	plus civ 0	arg2
	and 0 0		argd1
	and @dec_r4 @dec_r4	arg4
	plus 0 0	goto dswr
#
# CMPP3 len.rw, src1addr.ab, src2addr.ab; CMPP4 src1len.rw, src1addr.ab,
# src2len.rw, src2addr.ab: N Z from src1 : src2, V = C = 0. R0 = R2 = 0,
# R1 = src1addr, R3 = src2addr.
cmpp3:	plus arg3 0	arg4
	plus arg1 0	arg3
cmpp4:	and arg1 FFFF	arg1
	and arg3 FFFF	arg3
	minus 1F arg1	ncond goto q_bad
	minus 1F arg3	ncond goto q_bad
	and 65 65	crn
	plus arg2 0	crw wipr		# U1 = src1addr
	and 67 67	crn
	plus arg4 0	crw wipr		# U3 = src2addr
	and 66 66	crn
	plus arg3 0	crw wipr		# U2 = src2len
	and 60 60	crn
	and 0 0		crw wipr		# CLR
	and 62 62	arg3			# src1 into B
	and @cmpp_1 @cmpp_1	arg4
	plus 0 0	goto dsrd
cmpp_1:	and 64 64	crn
	plus argd0 0	crw wipr		# U0 = its sign
	and 66 66	crn
	plus civ 0	arg1
	and 67 67	crn
	plus civ 0	arg2
	and 61 61	arg3			# src2 into A
	and @cmpp_2 @cmpp_2	arg4
	plus 0 0	goto dsrd
cmpp_2:	and 64 64	crn
	plus civ 0	argd1			# sign 1 (argd0: sign 2)
	bic F psl	psl
	minus argd1 argd0	zcond goto cmpp_3
	plus argd1 0	zcond goto dec_r4	# + : -
	bis 8 psl	psl goto dec_r4		# - : +
cmpp_3:	and 60 60	crn
	plus civ 0	argp0
	and argp0 4	nzcond goto cmpp_eq	# A = B
	and argp0 2	nzcond goto cmpp_lt	# A > B: |src2| > |src1|
	plus argd1 0	zcond goto dec_r4	# greater if plus
	bis 8 psl	psl goto dec_r4
cmpp_lt: plus argd1 0	nzcond goto dec_r4	# less if plus
	bis 8 psl	psl goto dec_r4
cmpp_eq: bis 4 psl	psl goto dec_r4
#
# ADDP4 addlen.rw, addaddr.ab, sumlen.rw, sumaddr.ab; ADDP6 add1len.rw,
# add1addr.ab, add2len.rw, add2addr.ab, sumlen.rw, sumaddr.ab; SUBP4,
# SUBP6 the same with the first operand subtracted; MULP, DIVP (the first
# operand the multiplier or the divisor) with six operands. N Z V, C = 0.
# R0 = R2 = 0, R1, R3 the first two addresses; with six operands R4 = 0,
# R5 the third. A zero divisor: a decimal divide by zero trap (type 4),
# nothing else done. U0: <8> subtract, <9> six operands, <11> MULP, <12>
# DIVP, <10> sign 1, <4:0> length 2, <20:16> length 3; U1, U3 the first two
# addresses, U2 the third.
addp4:	and 0 0		argp0 goto addp_a
subp4:	and 100 100	argp0
addp_a:	plus arg3 0	argd0			# the sum is the second string
	plus arg4 0	argd1 goto addp_c
addp6:	and 200 200	argp0 goto addp_c
subp6:	and 300 300	argp0 goto addp_c
mulp:	and A00 A00	argp0 goto addp_c
divp:	and 1200 1200	argp0
addp_c:	and arg1 FFFF	arg1
	and arg3 FFFF	arg3
	and argd0 FFFF	argd0
	minus 1F arg1	ncond goto q_bad
	minus 1F arg3	ncond goto q_bad
	minus 1F argd0	ncond goto q_bad
	and 65 65	crn
	plus arg2 0	crw wipr		# U1
	and 67 67	crn
	plus arg4 0	crw wipr		# U3
	and 66 66	crn
	plus argd1 0	crw wipr		# U2
	shl argd0 10	argp1
	bis argp1 argp0	argp0
	bis argp0 arg3	argp0
	and 64 64	crn
	plus argp0 0	crw wipr		# U0
	and 60 60	crn
	and 0 0		crw wipr		# CLR
	and 62 62	arg3			# string 1 into B
	and @addp_1 @addp_1	arg4
	plus 0 0	goto dsrd
addp_1:	and 64 64	crn
	shl argd0 A	argd0
	bis civ argd0	crw wipr		# U0 <10> = sign 1
	and civ 1000	zcond goto addp_1b
	and 60 60	crn
	and civ 20	zcond goto addp_1a	# the divisor is not zero
	and 74 74	crn
	and 4 4		crw wipr		# decimal divide by zero trap
	plus 0 0	eoi
addp_1a: and 64 64	crn
addp_1b: and civ 1F	arg1			# length 2
	and 67 67	crn
	plus civ 0	arg2
	and 61 61	arg3			# string 2 into A
	and @addp_2 @addp_2	arg4
	plus 0 0	goto dsrd
addp_2:	and 64 64	crn
	plus civ 0	argp0			# U0 (argd0: sign 2)
	shr argp0 A	argd1
	and argd1 1	argd1			# sign 1
	and 60 60	crn
	and argp0 1800	nzcond goto mulp_2
	and argp0 100	zcond goto addp_3
	xor argd1 1	argd1			# subtract: string 1 negated
addp_3:	minus argd1 argd0	zcond goto addp_ad	# the same signs: add
	plus civ 0	arg1
	and arg1 2	zcond goto addp_s1	# A > B: |2| > |1|
	and 4 4		crw wipr		# A <- A - B, the sign of 2
	plus 0 0	goto addp_w
addp_s1: and 5 5	crw wipr		# A <- B - A, the sign of 1
	plus argd1 0	argd0 goto addp_w
addp_ad: and 3 3	crw wipr		# A <- A + B (a carry out: V)
	plus 0 0	goto addp_w
mulp_2:	xor argd1 argd0	argd0			# the sign of the result
	and argp0 1000	nzcond goto divp_2
	and C C		crw wipr		# MUL (does not fit: V)
	plus 0 0	goto addp_w
divp_2:	and 1 1		crw wipr		# SWAP: A the divisor, B the dividend
	and D D		crw wipr		# DIV
addp_w:	and 0 0		argd1
	shr argp0 10	arg1			# length 3
	and 66 66	crn
	plus civ 0	arg2			# address 3
	and @addp_e @addp_e	arg4
	plus 0 0	goto dswr
addp_e:	bic 1 psl	psl			# C = 0
	and 64 64	crn
	and civ 200	zcond goto dec_r4	# four operands
	plus 0 0	goto dec_r6
#
# ASHP cnt.rb, srclen.rw, srcaddr.ab, round.rb, dstlen.rw, dstaddr.ab
# (arg1-arg4, argd0, argd1): the source shifted cnt digits, to the left if
# cnt > 0; to the right it is rounded, 1 added when the round digit<3:0>
# and the highest digit shifted out add up to more than 9. N Z V, C = 0.
# R0 = R2 = 0, R1 = srcaddr, R3 = dstaddr.
ashp:	and arg2 FFFF	arg2
	and argd0 FFFF	argd0
	minus 1F arg2	ncond goto q_bad
	minus 1F argd0	ncond goto q_bad
	and 65 65	crn
	plus arg3 0	crw wipr		# U1 = srcaddr
	and 67 67	crn
	plus argd1 0	crw wipr		# U3 = dstaddr
	and 66 66	crn
	plus argd0 0	crw wipr		# U2 = dstlen
	and 64 64	crn
	and arg4 F	argp0
	shl argp0 8	argp0
	and arg1 FF	argp1
	bis argp0 argp1	crw wipr		# U0 = round<11:8>'cnt<7:0>
	and 60 60	crn
	and 0 0		crw wipr		# CLR
	plus arg2 0	arg1
	plus arg3 0	arg2
	and 61 61	arg3
	and @ashp_1 @ashp_1	arg4
	plus 0 0	goto dsrd
ashp_1:	and 64 64	crn
	plus civ 0	argp0
	and 60 60	crn
	and argp0 80	nzcond goto ashp_r	# right
	shl argp0 8	argp1
	and argp1 FF00	argp1
	bis argp1 6	crw wipr		# SHL cnt
	plus 0 0	goto ashp_w
ashp_r:	and argp0 FF	argp1
	minus 100 argp1	argp1			# 256 - cnt
	shl argp1 8	argp1
	bis argp1 7	crw wipr		# SHR
	and B B		crw wipr		# SETIDX 0
	and 62 62	crn
	plus civ 0	argp1			# the highest digit shifted out
	shr argp0 8	arg1
	and arg1 F	arg1			# the round digit
	plus argp1 arg1	argp1
	and 60 60	crn
	minus 9 argp1	nncond goto ashp_r1
	and 11 11	crw wipr		# INC
ashp_r1: and A A	crw wipr		# SETNIB 0, 0
ashp_w:	and 66 66	crn
	plus civ 0	arg1			# dstlen
	and 67 67	crn
	plus civ 0	arg2
	and 0 0		argd1
	and @dec_c0 @dec_c0	arg4
	plus 0 0	goto dswr
# C = 0, then the end of most of them
dec_c0:	bic 1 psl	psl
	plus 0 0	goto dec_r4
#
# CVTLP src.rl, dstlen.rw, dstaddr.ab (arg1-arg3): N Z V, C = 0. R0 = R1 =
# R2 = 0, R3 = dstaddr.
cvtlp:	and arg2 FFFF	arg2
	minus 1F arg2	ncond goto q_bad
	and 0 0		argd0
	plus arg1 0	nncond goto cvtlp_1
	minus 0 arg1	arg1			# the magnitude
	and 1 1		argd0			# minus
cvtlp_1: and 60 60	crn
	and 0 0		crw wipr		# CLR
	and 63 63	crn
	plus arg1 0	crw wipr		# X
	and 60 60	crn
	and E E		crw wipr		# CVTLP
	plus arg2 0	arg1
	plus arg3 0	arg2
	and 0 0		argd1
	and @cvtlp_2 @cvtlp_2	arg4
	plus 0 0	goto dswr
cvtlp_2: bic 1 psl	psl
	and 0 0		crn
	and 0 0		crw wreg
	and 1 1		crn
	and 0 0		crw wreg
	and 2 2		crn
	and 0 0		crw wreg
	and 3 3		crn
	plus arg2 0	crw wreg
	plus 0 0	eoi
#
# CVTPL srclen.rw, srcaddr.ab, dst.wl (arg1, arg2, argp0): the string in
# binary; V if it does not fit in a longword (an integer overflow trap with
# PSL<IV>: instruction flag intov). N Z from the result, C = 0. R0 = R2 =
# R3 = 0, R1 = srcaddr; the destination is written after them.
cvtpl:	and arg1 FFFF	arg1
	minus 1F arg1	ncond goto q_bad
	and 64 64	crn
	plus argp0 0	crw wipr		# U0 = the destination
	and 65 65	crn
	plus arg2 0	crw wipr		# U1 = srcaddr
	and 60 60	crn
	and 0 0		crw wipr		# CLR
	and 61 61	arg3
	and @cvtpl_1 @cvtpl_1	arg4
	plus 0 0	goto dsrd
cvtpl_1: and 60 60	crn
	and F F		crw wipr		# CVTPL
	plus civ 0	argd1
	shr argd1 4	argd1
	and argd1 1	argd1			# overflow so far
	and 63 63	crn
	plus civ 0	arg1			# the magnitude, modulo 2**32
	plus argd0 0	zcond goto cvtpl_2
	minus 0 arg1	arg1			# minus
cvtpl_2: shr arg1 1F	arg3
	xor arg3 argd0	arg3			# not of the sign: overflow
	bis arg3 argd1	argd1
	bic 2 psl	psl
	shl argd1 1	argd1
	bis argd1 psl	psl			# V
	and 0 0		crn
	and 0 0		crw wreg
	and 2 2		crn
	and 0 0		crw wreg
	and 3 3		crn
	and 0 0		crw wreg
	and 65 65	crn
	plus civ 0	argp1
	and 1 1		crn
	plus argp1 0	crw wreg		# R1 = srcaddr
	and 64 64	crn
	plus civ 0	argp0			# the destination back
	plus arg1 0	argd0 savnz eoi		# the result, N Z
#
# CVTPS srclen.rw, srcaddr.ab, dstlen.rw, dstaddr.ab (arg1-arg4): to a
# leading separate numeric string, the sign (+ or -) and dstlen digits. N Z
# from the source, V if its digits do not fit (decimal overflow trap with
# PSL<DV>), C = 0. R0 = R2 = 0, R1 = srcaddr, R3 = dstaddr.
cvtps:	and arg1 FFFF	arg1
	and arg3 FFFF	arg3
	minus 1F arg1	ncond goto q_bad
	minus 1F arg3	ncond goto q_bad
	and 65 65	crn
	plus arg2 0	crw wipr		# U1
	and 67 67	crn
	plus arg4 0	crw wipr		# U3
	and 66 66	crn
	plus arg3 0	crw wipr		# U2 = dstlen
	and 60 60	crn
	and 0 0		crw wipr
	and 61 61	arg3
	and @cvtps_1 @cvtps_1	arg4
	plus 0 0	goto dsrd
cvtps_1: and 66 66	crn
	plus civ 0	arg1			# dstlen
	and 67 67	crn
	plus civ 0	arg2			# dstaddr
	plus arg2 0	cpuaddr rmem byte wint	# writable: the sign ...
	plus arg2 arg1	cpuaddr rmem byte wint	# ... and the last digit
	and 2B 2B	crw			# +
	plus argd0 0	zcond goto cvtps_2
	and 2D 2D	crw			# -
cvtps_2: plus arg2 0	cpuaddr wmem byte
	and 1 1		argp1			# digit i at dstaddr + dstlen + 1 - i
cvtps_l: minus arg1 argp1	ncond goto cvtps_cc
	and 60 60	crn
	shl argp1 8	argp0
	bis argp0 B	crw wipr		# SETIDX i
	and 62 62	crn
	plus civ 0	argp0
	bis argp0 30	crw			# the digit in ASCII
	plus arg2 arg1	argp0
	plus argp0 1	argp0
	minus argp0 argp1	cpuaddr wmem byte
	plus argp1 1	argp1 goto cvtps_l
# N Z from the source (sign argd0), V if its highest digit is above arg1
cvtps_cc: and 60 60	crn
	plus civ 0	argp0			# status
	bic F psl	psl
	and argp0 1	zcond goto cvtps_nz
	bis 4 psl	psl			# Z
	plus 0 0	goto cvtps_v
cvtps_nz: shl argd0 3	argp1
	bis argp1 psl	psl			# N
cvtps_v: shr argp0 8	argp1
	and argp1 1F	argp1			# the highest digit
	minus arg1 argp1	nncond goto dec_r4	# it fits
	bis 2 psl	psl			# V
	and psl 80	zcond goto dec_r4
	and 74 74	crn
	and 6 6		crw wipr		# decimal overflow trap
	plus 0 0	goto dec_r4
#
# CVTSP srclen.rw, srcaddr.ab, dstlen.rw, dstaddr.ab (arg1-arg4): from a
# leading separate numeric string; a sign other than +, - or blank, or a
# character other than a digit is a reserved operand. N Z V, C = 0. R0 =
# R2 = 0, R1 = srcaddr, R3 = dstaddr.
cvtsp:	and arg1 FFFF	arg1
	and arg3 FFFF	arg3
	minus 1F arg1	ncond goto q_bad
	minus 1F arg3	ncond goto q_bad
	and 60 60	crn
	and 0 0		crw wipr		# CLR
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	argp0
	and 0 0		argd0
	minus argp0 2D	zcond goto cvtsp_m
	minus argp0 2B	zcond goto cvtsp_1
	minus argp0 20	zcond goto cvtsp_1
	plus 0 0	goto q_bad
cvtsp_m: and 1 1	argd0
cvtsp_1: and 1 1	argp1			# character p is digit srclen + 1 - p
cvtsp_l: minus arg1 argp1	ncond goto cvtsp_2
	plus arg2 argp1	cpuaddr rmem byte
	and rmemdat FF	argp0
	minus argp0 30	ncond goto q_bad	# below 0
	minus 39 argp0	ncond goto q_bad	# above 9
	and argp0 F	argp0
	shl argp0 10	argp0			# the digit <19:16>
	plus arg1 1	argd1
	minus argd1 argp1	argd1
	shl argd1 8	argd1
	bis argp0 argd1	argp0
	bis argp0 A	crw wipr		# SETNIB
	plus argp1 1	argp1 goto cvtsp_l
cvtsp_2: and civ 1	zcond goto cvtsp_3
	and 0 0		argd0			# -0 is +0
cvtsp_3: and 65 65	crn
	plus arg2 0	crw wipr		# U1
	and 67 67	crn
	plus arg4 0	crw wipr		# U3
	plus arg3 0	arg1
	plus arg4 0	arg2
	and 0 0		argd1
	and @dec_c0 @dec_c0	arg4
	plus 0 0	goto dswr
#
# CVTPT srclen.rw, srcaddr.ab, tbladdr.ab, dstlen.rw, dstaddr.ab (arg1-
# arg4, argd0): to a trailing numeric string of dstlen characters, the last
# one the table entry of the source's last byte (its last digit and the
# sign). N Z from the source, V if its digits do not fit, C = 0. R0 = R2 =
# 0, R1 = srcaddr, R3 = dstaddr. U0 the table, U2 srclen<12:8>'dstlen.
cvtpt:	and arg1 FFFF	arg1
	and arg4 FFFF	arg4
	minus 1F arg1	ncond goto q_bad
	minus 1F arg4	ncond goto q_bad
	and 65 65	crn
	plus arg2 0	crw wipr		# U1
	and 67 67	crn
	plus argd0 0	crw wipr		# U3
	and 64 64	crn
	plus arg3 0	crw wipr		# U0 = the table
	and 66 66	crn
	shl arg1 8	argp0
	bis argp0 arg4	crw wipr		# U2
	and 60 60	crn
	and 0 0		crw wipr		# CLR
	and 61 61	arg3
	and @cvtpt_1 @cvtpt_1	arg4
	plus 0 0	goto dsrd
cvtpt_1: and 66 66	crn
	plus civ 0	argp0
	and argp0 1F	arg1			# dstlen
	and 67 67	crn
	plus civ 0	arg2			# dstaddr
	plus arg1 0	zcond goto cvtps_cc	# no characters
	shr argp0 9	argp1
	and argp1 F	argp1			# srclen / 2
	and 65 65	crn
	plus civ argp1	cpuaddr rmem byte	# the source's last byte
	and rmemdat FF	argp1
	and 64 64	crn
	plus civ argp1	cpuaddr rmem byte	# its table entry
	and rmemdat FF	argd1			# the last character
	plus arg2 0	cpuaddr rmem byte wint	# writable: the first ...
	plus arg2 arg1	argp0
	minus argp0 1	argp0
	plus argp0 0	cpuaddr rmem byte wint	# ... and the last character
	plus argd1 0	crw
	plus argp0 0	cpuaddr wmem byte
	and 2 2		argp1			# digit i at dstaddr + dstlen - i
cvtpt_l: minus arg1 argp1	ncond goto cvtps_cc
	and 60 60	crn
	shl argp1 8	argp0
	bis argp0 B	crw wipr		# SETIDX i
	and 62 62	crn
	plus civ 0	argp0
	bis argp0 30	crw
	plus arg2 arg1	argp0
	minus argp0 argp1	cpuaddr wmem byte
	plus argp1 1	argp1 goto cvtpt_l
#
# CVTTP srclen.rw, srcaddr.ab, tbladdr.ab, dstlen.rw, dstaddr.ab: from a
# trailing numeric string: the last character goes through the table, which
# gives its digit <7:4> and sign <3:0> (a sign below A or a digit above 9 is
# a reserved operand); the others must be digits. N Z V, C = 0. R0 = R2 =
# 0, R1 = srcaddr, R3 = dstaddr.
cvttp:	and arg1 FFFF	arg1
	and arg4 FFFF	arg4
	minus 1F arg1	ncond goto q_bad
	minus 1F arg4	ncond goto q_bad
	and 65 65	crn
	plus arg2 0	crw wipr		# U1
	and 67 67	crn
	plus argd0 0	crw wipr		# U3
	and 60 60	crn
	and 0 0		crw wipr		# CLR
	and 0 0		argd1			# the sign
	and 1 1		argp1			# character i from the end is digit i
cvttp_l: minus arg1 argp1	ncond goto cvttp_2
	plus arg2 arg1	argp0
	minus argp0 argp1	cpuaddr rmem byte
	and rmemdat FF	argp0
	minus argp1 1	nzcond goto cvttp_d	# not the last character
	plus arg3 argp0	cpuaddr rmem byte	# the table
	and rmemdat FF	argp0
	and argp0 F	argd1			# the sign nibble
	minus argd1 A	ncond goto q_bad
	shr argp0 4	argp0
	minus 9 argp0	ncond goto q_bad
	minus argd1 B	zcond goto cvttp_m
	minus argd1 D	zcond goto cvttp_m
	and 0 0		argd1 goto cvttp_s
cvttp_m: and 1 1	argd1 goto cvttp_s
cvttp_d: minus argp0 30	ncond goto q_bad
	minus 39 argp0	ncond goto q_bad
	and argp0 F	argp0
cvttp_s: shl argp0 10	argp0
	shl argp1 8	argd0
	bis argp0 argd0	argp0
	and 60 60	crn
	bis argp0 A	crw wipr		# SETNIB i
	plus argp1 1	argp1 goto cvttp_l
cvttp_2: and 60 60	crn
	and civ 1	zcond goto cvttp_3
	and 0 0		argd1			# -0 is +0
cvttp_3: plus argd1 0	argd0
	plus arg4 0	arg1
	and 67 67	crn
	plus civ 0	arg2
	and 0 0		argd1
	and @dec_c0 @dec_c0	arg4
	plus 0 0	goto dswr
#
# EDITPC srclen.rw, srcaddr.ab, pattern.ab, dstaddr.ab (arg1-arg4): the
# source edited into the destination by the pattern operators (SRM,
# EDITPC). N: the source is minus (and not zero), Z: no
# nonzero digit was seen, V: nonzero digits were dropped (EO$ADJUST_INPUT),
# C: significance; V with PSL<DV> requests the decimal overflow trap. An
# undefined operator, a zero repeat count or length, the source used up or
# not used up at EO$END are reserved operands. At the end R0 = srclen,
# R1 = srcaddr, R2 = R4 = 0, R3 = the address of the EO$END byte, R5 = the
# address after the last character stored.
# Registers: arg1 source digits left, argd1 leading zeros still to supply
# (EO$ADJUST_INPUT), arg2 the source byte, arg3 the pattern, arg4 the
# destination, argd0 sign<23:16>'fill<15:8>'N Z V C<3:0>; argp1 the repeat
# count; argp0 the digit and temporaries. U0, U1 srclen, srcaddr; U2 the
# return address of ed_dig.
editpc:	and arg1 FFFF	arg1
	minus 1F arg1	ncond goto q_bad
	and 64 64	crn
	plus arg1 0	crw wipr		# U0 = srclen
	and 65 65	crn
	plus arg2 0	crw wipr		# U1 = srcaddr
	shr arg1 1	argp0
	plus arg2 argp0	cpuaddr rmem byte	# the sign
	and rmemdat F	argp0
	minus argp0 B	zcond goto ed_m
	minus argp0 D	zcond goto ed_m
	and 20 20	argd0			# plus: sign blank, fill blank, Z
	shl argd0 10	argd0
	bis argd0 2004	argd0 goto ed_0
ed_m:	and 2D 2D	argd0			# minus: sign -, fill blank, N Z
	shl argd0 10	argd0
	bis argd0 200C	argd0
ed_0:	and 0 0		argd1
ed_l:	plus arg3 0	cpuaddr rmem byte
	and rmemdat FF	argp0			# the operator
	and argp0 80	nzcond goto ed_rpt
	plus argp0 0	zcond goto ed_end
	minus argp0 1	zcond goto ed_endf
	minus argp0 2	zcond goto ed_clrs
	minus argp0 3	zcond goto ed_sets
	minus argp0 4	zcond goto ed_stsg
	minus argp0 40	zcond goto ed_ldf
	minus argp0 41	zcond goto ed_lds
	minus argp0 42	zcond goto ed_ldp
	minus argp0 43	zcond goto ed_ldm
	minus argp0 44	zcond goto ed_ins
	minus argp0 45	zcond goto ed_blz
	minus argp0 46	zcond goto ed_rps
	minus argp0 47	zcond goto ed_adj
	plus 0 0	goto q_bad
ed_rpt:	and argp0 F	argp1			# the repeat count
	plus argp1 0	zcond goto q_bad
	and argp0 F0	argp0
	minus argp0 80	zcond goto ed_fill
	minus argp0 90	zcond goto ed_move
	minus argp0 A0	zcond goto ed_flt
	plus 0 0	goto q_bad
ed_nx:	plus arg3 1	arg3 goto ed_l		# the next operator
# EO$END_FLOAT: the sign, unless significance
ed_endf: and argd0 1	nzcond goto ed_nx
	shr argd0 10	crw
	plus arg4 0	cpuaddr wmem byte
	plus arg4 1	arg4
	bis argd0 1	argd0 goto ed_nx
ed_clrs: bic 1 argd0	argd0 goto ed_nx	# EO$CLEAR_SIGNIF
ed_sets: bis argd0 1	argd0 goto ed_nx	# EO$SET_SIGNIF
ed_stsg: shr argd0 10	crw			# EO$STORE_SIGN
	plus arg4 0	cpuaddr wmem byte
	plus arg4 1	arg4 goto ed_nx
# EO$LOAD_FILL, EO$LOAD_SIGN, EO$LOAD_PLUS, EO$LOAD_MINUS char
ed_ldf:	plus arg3 1	arg3
	plus arg3 0	cpuaddr rmem byte
	and rmemdat FF	argp0
	shl argp0 8	argp0
	bic FF00 argd0	argd0
	bis argd0 argp0	argd0 goto ed_nx
ed_lds:	plus arg3 1	arg3
ed_lds1: plus arg3 0	cpuaddr rmem byte
	and rmemdat FF	argp0
	shl argp0 10	argp0
	and argd0 FFFF	argd0
	bis argd0 argp0	argd0 goto ed_nx
ed_ldp:	plus arg3 1	arg3
	and argd0 8	zcond goto ed_lds1	# plus: loaded
	plus 0 0	goto ed_nx
ed_ldm:	plus arg3 1	arg3
	and argd0 8	nzcond goto ed_lds1	# minus: loaded
	plus 0 0	goto ed_nx
# EO$INSERT char: it with significance, else the fill
ed_ins:	plus arg3 1	arg3
	plus arg3 0	cpuaddr rmem byte
	plus rmemdat 0	crw
	and argd0 1	nzcond goto ed_ins1
	shr argd0 8	crw
ed_ins1: plus arg4 0	cpuaddr wmem byte
	plus arg4 1	arg4 goto ed_nx
# EO$BLANK_ZERO len: the last len characters become the fill if zero
ed_blz:	plus arg3 1	arg3
	plus arg3 0	cpuaddr rmem byte
	and rmemdat FF	argp1
	plus argp1 0	zcond goto q_bad
	and argd0 4	zcond goto ed_nx
	shr argd0 8	crw
ed_blz1: minus arg4 argp1	cpuaddr wmem byte
	minus argp1 1	argp1 nzcond goto ed_blz1
	plus 0 0	goto ed_nx
# EO$REPLACE_SIGN len: the character len back becomes the fill if zero
ed_rps:	plus arg3 1	arg3
	plus arg3 0	cpuaddr rmem byte
	and rmemdat FF	argp1
	plus argp1 0	zcond goto q_bad
	and argd0 4	zcond goto ed_nx
	shr argd0 8	crw
	minus arg4 argp1	cpuaddr wmem byte
	plus 0 0	goto ed_nx
# EO$ADJUST_INPUT len (1-31): more digits left than len: the extra ones
# are dropped (nonzero: V C, not Z); fewer: leading zeros are supplied
ed_adj:	plus arg3 1	arg3
	plus arg3 0	cpuaddr rmem byte
	and rmemdat FF	argp1
	plus argp1 0	zcond goto q_bad
	minus 1F argp1	ncond goto q_bad
	and 0 0		argd1
	minus arg1 argp1	ncond goto ed_adj2
	minus arg1 argp1	argp1		# digits to drop
ed_adj1: plus argp1 0	zcond goto ed_nx
	and 66 66	crn
	and @ed_adj3 @ed_adj3	crw wipr
	plus 0 0	goto ed_dig
ed_adj3: plus argp0 0	zcond goto ed_adj4
	bic 4 argd0	argd0
	bis argd0 3	argd0			# V C, not Z
ed_adj4: minus argp1 1	argp1 goto ed_adj1
ed_adj2: minus argp1 arg1	argd1 goto ed_nx	# zeros first
# EO$FILL n: n fill characters
ed_fill: shr argd0 8	crw
ed_fil1: plus arg4 0	cpuaddr wmem byte
	plus arg4 1	arg4
	minus argp1 1	argp1 nzcond goto ed_fil1
	plus 0 0	goto ed_nx
# EO$MOVE n: n digits; a nonzero one sets significance (and clears Z);
# without significance the fill goes instead
ed_move: and 66 66	crn
	and @ed_mv1 @ed_mv1	crw wipr
	plus 0 0	goto ed_dig
ed_mv1:	plus argp0 0	zcond goto ed_mv2
	bic 4 argd0	argd0
	bis argd0 1	argd0
ed_mv2:	and argd0 1	zcond goto ed_mv3
	bis argp0 30	crw
	plus 0 0	goto ed_mv4
ed_mv3:	shr argd0 8	crw
ed_mv4:	plus arg4 0	cpuaddr wmem byte
	plus arg4 1	arg4
	minus argp1 1	argp1 nzcond goto ed_move
	plus 0 0	goto ed_nx
# EO$FLOAT n: as EO$MOVE, but the first nonzero digit without significance
# gets the sign stored before it (and Z cleared)
ed_flt:	and 66 66	crn
	and @ed_fl1 @ed_fl1	crw wipr
	plus 0 0	goto ed_dig
ed_fl1:	plus argp0 0	zcond goto ed_fl2
	and argd0 1	nzcond goto ed_fl2
	bic 4 argd0	argd0
	bis argd0 1	argd0
	shr argd0 10	crw			# the sign
	plus arg4 0	cpuaddr wmem byte
	plus arg4 1	arg4
ed_fl2:	and argd0 1	zcond goto ed_fl3
	bis argp0 30	crw
	plus 0 0	goto ed_fl4
ed_fl3:	shr argd0 8	crw
ed_fl4:	plus arg4 0	cpuaddr wmem byte
	plus arg4 1	arg4
	minus argp1 1	argp1 nzcond goto ed_flt
	plus 0 0	goto ed_nx
# EO$END: the source must be used up
ed_end:	plus arg1 0	nzcond goto q_bad
	plus argd1 0	nzcond goto q_bad
	and argd0 4	zcond goto ed_e1
	bic 8 argd0	argd0			# zero: not minus
ed_e1:	bic F psl	psl
	and argd0 F	argp0
	bis argp0 psl	psl			# N Z V C
	and argd0 2	zcond goto ed_e2
	and psl 80	zcond goto ed_e2
	and 74 74	crn
	and 6 6		crw wipr		# decimal overflow trap
ed_e2:	and 64 64	crn
	plus civ 0	argp0
	and 0 0		crn
	plus argp0 0	crw wreg		# R0 = srclen
	and 65 65	crn
	plus civ 0	argp0
	and 1 1		crn
	plus argp0 0	crw wreg		# R1 = srcaddr
	and 2 2		crn
	and 0 0		crw wreg
	and 3 3		crn
	plus arg3 0	crw wreg		# R3 = the EO$END byte
	and 4 4		crn
	and 0 0		crw wreg
	and 5 5		crn
	plus arg4 0	crw wreg		# R5 = the destination's end
	plus 0 0	eoi
#
# ed_dig (return address in U2): the next source digit into argp0: a
# supplied zero while argd1 is not zero, else the next nibble of the string
# (the high one when an odd number of digits is left); none left: reserved
# operand.
ed_dig:	plus argd1 0	zcond goto ed_dig1
	minus argd1 1	argd1
	and 0 0		argp0 goto ed_digr
ed_dig1: plus arg1 0	zcond goto q_bad
	plus arg2 0	cpuaddr rmem byte
	and rmemdat FF	argp0
	minus arg1 1	arg1
	and arg1 1	nzcond goto ed_dig2	# was even: the low nibble
	shr argp0 4	argp0 goto ed_digr
ed_dig2: and argp0 F	argp0
	plus arg2 1	arg2
ed_digr: and 66 66	crn
	plus civ 0	jmp
#
!INSTRUCTIONS
#
NOP	rl#0,rl#0		lbl=add				# 01
REI	rl#(sp)+,rl#(sp)+,wl#pc	lbl=rei wback			# 02
#
BPT	rl#0		lbl=bpt					# 03
RET	rl#fp			lbl=ret				# 04
RSB	rl#(sp)+,wl#pc	lbl=mov wback				# 05
LDPCTX	rl#0		lbl=ldpctx				# 06
SVPCTX	rl#0		lbl=svpctx				# 07
CVTPS	0rw,1ab,2rw,3ab	lbl=cvtps				# 08
CVTSP	0rw,1ab,2rw,3ab	lbl=cvtsp				# 09
INDEX	0rl,1rl,2rl,3rl,4rl,wl	lbl=index setnz clv clc wback	# 0a
CRC	0ab,1rl,2rw,3ab	lbl=crc fpdok				# 0b
#
PROBER	rb,rw,ab	lbl=prober				# 0c
PROBEW	rb,rw,ab	lbl=probew				# 0d
INSQUE	ab,ab		lbl=insque setcmpnz clv setc		# 0e
REMQUE	ab,wl#pc,wl	lbl=remque setcmpnz setc wback2		# 0f
BSBB	0ab#b^d(pc),2rl#pc,wl#pc,wl#-(sp)	lbl=mov move2 wback wback2
BRB	aw#b^d(pc),wl#pc	lbl=mov wback			# 11
BNEQ	ab#b^d(pc),rl#4,wl#pc	lbl=bclr			# 12
BEQL	ab#b^d(pc),rl#4,wl#pc	lbl=bset			# 13
BGTR	ab#b^d(pc),rl#C,wl#pc	lbl=bclr 			# 14
BLEQ	ab#b^d(pc),rl#C,wl#pc	lbl=bset 			# 15
JSB	0ab,2rl#pc,wl#pc,wl#-(sp)	lbl=mov move2 wback wback2 # 16
JMP	ab,wl#pc	lbl=mov wback				# 17
BGEQ	ab#b^d(pc),rl#8,wl#pc	lbl=bclr 			# 18
BLSS	ab#b^d(pc),rl#8,wl#pc	lbl=bset 			# 19
BGTRU	ab#b^d(pc),rl#5,wl#pc	lbl=bclr 			# 1a
BLEQU	ab#b^d(pc),rl#5,wl#pc	lbl=bset 			# 1b
BVC	ab#b^d(pc),rl#2,wl#pc	lbl=bclr			# 1c
BVS	ab#b^d(pc),rl#2,wl#pc	lbl=bset 			# 1d
BGEQU	ab#b^d(pc),rl#1,wl#pc	lbl=bclr			# 1e
BLSSU	ab#b^d(pc),rl#1,wl#pc	lbl=bset			# 1f
ADDP4	0rw,1ab,2rw,3ab	lbl=addp4				# 20
ADDP6	0rw,1ab,2rw,3ab,4rw,5ab	lbl=addp6			# 21
SUBP4	0rw,1ab,2rw,3ab	lbl=subp4				# 22
SUBP6	0rw,1ab,2rw,3ab,4rw,5ab	lbl=subp6			# 23
CVTPT	0rw,1ab,2ab,3rw,4ab	lbl=cvtpt			# 24
MULP	0rw,1ab,2rw,3ab,4rw,5ab	lbl=mulp			# 25
CVTTP	0rw,1ab,2ab,3rw,4ab	lbl=cvttp			# 26
DIVP	0rw,1ab,2rw,3ab,4rw,5ab	lbl=divp			# 27
#
MOVC3	rw,ab,ab	lbl=movc3 fpdok				# 28
CMPC3	rw,ab,ab	lbl=cmpc3 setnz setc clv		# 29
SCANC	0rw,1ab,2ab,3rb	lbl=scanc setnz clv clc		# 2a
SPANC	0rw,1ab,2ab,3rb	lbl=spanc setnz clv clc		# 2b
MOVTC	0rw,1ab,2rb,3ab,4rw,5ab	lbl=movtc			# 2e
MOVTUC	0rw,1ab,2rb,3ab,4rw,5ab	lbl=movtuc fpdok		# 2f
MOVC5	0rw,1ab,4rb,2rw,3ab	lbl=movc5 fpdok		# 2c
CMPC5	0rw,1ab,4rb,2rw,3ab	lbl=cmpc5 setnz setc clv	# 2d
#
BSBW	0aw#w^d(pc),2rl#pc,wl#pc,wl#-(sp)	lbl=mov move2 wback wback2 
BRW	aw#w^d(pc),wl#pc	lbl=mov wback 			# 31
CVTWL	rw,wl		lbl=mov setnz clv clc clv wback		# 32
CVTWB	rw,wb		lbl=cvtlb setnz clc wback intov		# 33
MOVP	0rw,1ab,2ab	lbl=movp				# 34
CMPP3	0rw,1ab,2ab	lbl=cmpp3				# 35
CVTPL	0rw,1ab,wl	lbl=cvtpl setnz clc wback intov		# 36
CMPP4	0rw,1ab,2rw,3ab	lbl=cmpp4				# 37
EDITPC	0rw,1ab,2ab,3ab	lbl=editpc				# 38
MATCHC	0rw,1ab,2rw,3ab	lbl=matchc fpdok			# 39
#
LOCC	2rb,0rw,1ab	lbl=locc clv clc setnz			# 3a
SKPC	2rb,0rw,1ab	lbl=skpc clv clc setnz			# 3b
MOVZWL	rw,wl		lbl=zwl setnz clv wback			# 3c
ACBW	rw,rw,mw,aw#w^d(pc),wl#pc lbl=acbw setnz setv wback intov	# 3d
#
MOVAW	aw,wl		lbl=mov setnz clv wback			# 3e
PUSHAW	aw,wl#-(sp)	lbl=mov setnz clv wback			# 3f
#
ADAWI	rw,ww		lbl=adawi setnz setc setv use16 wback intov	# 58
#
INSQHI	ab,aq		lbl=insqhi				# 5c
INSQTI	ab,aq		lbl=insqti				# 5d
REMQHI	aq,wl		lbl=remqhi				# 5e
REMQTI	aq,wl		lbl=remqti				# 5f
#
ASHL	rb,rl,wl	lbl=ashl setnz clc wback intov		# 78
ASHQ	rb,rq,wq	lbl=ashq setnz clc wback wback2 intov		# 79
EMUL	rl,rl,rl,wq	lbl=emul wback wback2			# 7a
EDIV	rl,rq,wl,wl	lbl=ediv setnz clc wback wback2 intov		# 7b
CLRQ	wq		lbl=clrq setnz clv wback wback2		# 7c
MOVQ	rq,wq		lbl=movq setnz clv wback wback2		# 7d
MOVAQ	aq,wl		lbl=mov setnz clv wback			# 7e
PUSHAQ	aq,wl#-(sp)	lbl=mov setnz clv wback			# 7f
ADDB2	rb,mb		lbl=add setnz setc setv use8 wback intov 	# 80
ADDB3	rb,rb,wb	lbl=add setnz setc setv use8 wback intov 	# 81
SUBB2	1rb,0mb		lbl=sub setnz setc setv use8 wback intov	# 82
SUBB3	1rb,0rb,2wb	lbl=sub setnz setc setv use8 wback intov	# 83
MULB2	rb,mb		lbl=mul setnz setv clc use8 wback intov	# 84
MULB3	rb,rb,wb	lbl=mul setnz setv clc use8 wback intov	# 85
DIVB2	rb,mb		lbl=div setnz clc use8 wback intov		# 86
DIVB3	rb,rb,wb	lbl=div setnz clc use8 wback intov		# 87
BISB2	rb,mb		lbl=bis setnz clv use8 wback		# 88
BISB3	rb,rb,wb	lbl=bis setnz clv use8 wback		# 89
BICB2	rb,mb		lbl=bic setnz clv use8 wback		# 8a
BICB3	rb,rb,wb	lbl=bic setnz clv use8 wback		# 8b
XORB2	rb,mb		lbl=xor setnz clv use8 wback		# 8c
XORB3	rb,rb,wb	lbl=xor setnz clv use8 wback		# 8d
MNEGB	rl#0,rb,wb	lbl=sub setnz setc setv use8 wback intov	# 8e
CASEB	rb,rb,rb,rl#pc,wl#pc	lbl=caseb setnz clv setc wback	# 8f
MOVB	rb,wb		lbl=mov setnz clv wback			# 90
CMPB	rb,rb		lbl=sub setnz clv setc			# 91
MCOMB	rb,rl#1,wb	lbl=mcom setnz clv wback		# 92
BITB	rb,rb		lbl=and setnz clv			# 93
CLRB	wb		lbl=clr setnz clv wback			# 94
TSTB	rb		lbl=tst setnz clv clc			# 95
INCB	mb,rl#1		lbl=add setnz setc setv use8 wback intov	# 96
DECB	mb,rl#1		lbl=sub setnz setv setc use8 wback intov	# 97
#
CVTBL	rb,wl		lbl=mov setnz clv clc wback		# 99
CVTBW	rb,ww		lbl=mov setnz clv clc wback		# 99
MOVZBL	rb,wl		lbl=zbl setnz clv wback			# 9a
MOVZBW	rb,ww		lbl=zbl setnz clv wback			# 9b
ROTL	rb,rl,wl	lbl=rot setnz clv wback			# 9c
ACBB	rb,rb,mb,aw#w^d(pc),wl#pc lbl=acbb setnz setv wback intov	# 9d
#
MOVAB	ab,wl		lbl=mov setnz clv wback			# 93
PUSHAB	ab,wl#-(sp)	lbl=mov setnz clv wback			# 9f
ADDW2	rw,mw		lbl=add setnz setc setv use16 wback intov	# a0
ADDW3	rw,rw,ww	lbl=add setnz setc setv use16 wback intov	# a1
SUBW2	1rw,0mw		lbl=sub setnz setc setv use16 wback intov	# a2
SUBW3	1rw,0rw,2ww	lbl=sub setnz setc setv use16 wback intov	# a3
MULW2	rw,mw		lbl=mul setnz setv clc use16 wback intov	# a4
MULW3	rw,rw,ww	lbl=mul setnz setv clc use16 wback intov	# a5
DIVW2	rw,mw		lbl=div setnz clc use16 wback intov		# a6
DIVW3	rw,rw,ww	lbl=div setnz clc use16 wback intov		# a7
BISW2	rw,mw		lbl=bis setnz clv use16 wback		# a8
BISW3	rw,rw,ww	lbl=bis setnz clv use16 wback		# a9
BICW2	rw,mw		lbl=bic setnz clv use16 wback		# aa
BICW3	rw,rw,ww	lbl=bic setnz clv use16 wback		# ab
XORW2	rw,mw		lbl=xor setnz clv use16 wback		# ac
XORW3	rw,rw,ww	lbl=xor setnz clv use16 wback		# ad
MNEGW	rl#0,rw,ww	lbl=sub setnz setc setv use16 wback intov	# ae
CASEW	rw,rw,rw,rl#pc,wl#pc	lbl=casew setnz clv setc wback	# af
MOVW	rw,ww		lbl=mov setnz clv wback			# b0
CMPW	rw,rw		lbl=sub setnz clv setc			# b1
MCOMW	rw,rl#1,ww	lbl=mcom setnz clv use16 wback		# b2
BITW	rw,rw		lbl=and setnz clv			# b3
CLRW	ww		lbl=clr setnz clv wback use16		# b4
TSTW	rw		lbl=tst setnz clv clc			# b5
INCW	mw,rl#1		lbl=add setnz setc setv use16 wback intov	# b6
DECW	mw,rl#1		lbl=sub setnz setv setc use16 wback intov	# b7
BISPSW	rw		lbl=bispsw				# b8
BICPSW	rw		lbl=bicpsw				# b9
POPR	rw,rl#sp	lbl=popr				# ba
PUSHR	rw,rl#sp	lbl=pushr				# bb
CHMK	rw		lbl=chmk				# bc
CHME	rw		lbl=chme				# bd
CHMS	rw		lbl=chms				# be
CHMU	rw		lbl=chmu				# bf
# 
ADDL2	rl,ml		lbl=add setnz setc setv wback intov 		# c0
ADDL3	rl,rl,wl	lbl=add setnz setc setv wback intov 		# c1
SUBL2	1rl,0ml		lbl=sub setnz setc setv wback intov		# c2
